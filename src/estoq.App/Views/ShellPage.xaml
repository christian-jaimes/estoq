<Page
    x:Class="Estoq.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Estoq.App.Controls"
    xmlns:vm="using:Estoq.App.ViewModels"
    xmlns:services="using:Estoq.App.Services"
    xmlns:addproduct="using:Estoq.App.Views.AddProduct"
    xmlns:returns="using:Estoq.App.Views.Returns"
    xmlns:pos="using:Estoq.App.Views.PointOfSale"
    xmlns:addvm="using:Estoq.App.ViewModels.AddProduct"
    xmlns:adjust="using:Estoq.App.Views.StockAdjustments"
    xmlns:adjustvm="using:Estoq.App.ViewModels.StockAdjustments"
    Foreground="{ThemeResource EqTextBrush}">

  <!-- F12 logs out from anywhere in the shell, pop-ups included. -->
  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="F1" Invoked="OnPointOfSaleAccelerator" />
    <KeyboardAccelerator Key="F2" Invoked="OnAddItemsAccelerator" />
    <KeyboardAccelerator Key="F3" Invoked="OnStockAdjustmentsAccelerator" />
    <KeyboardAccelerator Key="F4" Invoked="OnReturnsAccelerator" />
    <KeyboardAccelerator Key="F12" Invoked="OnLogOutAccelerator" />
  </Page.KeyboardAccelerators>

  <Grid Background="{ThemeResource EqBgBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Floating sidebar (design system, Sidebar): rounded surface card, logo, nav, divider, user + settings.
         The container is 12 px wider than the panel so the floating collapse button stays inside it. -->
    <Grid x:Name="SidebarContainer" Grid.Column="0" Canvas.ZIndex="1" HorizontalAlignment="Left" Margin="24,32,0,24">
      <Border x:Name="SidebarPanel" HorizontalAlignment="Left"
              Background="{ThemeResource EqSurfaceBrush}" BorderBrush="{ThemeResource EqBorderBrush}"
              BorderThickness="1" CornerRadius="{StaticResource EqRadiusXl}" Padding="{x:Bind ViewModel.SidebarPadding, Mode=OneWay}">
        <Grid x:Name="SidebarContent" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="4" SizeChanged="OnSidebarContentSizeChanged">

          <!-- Brand: lockup when expanded, Q mark when collapsed. -->
          <Grid Grid.Row="0" Height="{StaticResource EqControlHeight}" Margin="0,0,0,16" Padding="8,0">
            <Image Height="28" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Source="ms-appx:///Assets/Logos/estoq-lockup-gold.png"
                   Visibility="{x:Bind ViewModel.IsSidebarExpanded, Mode=OneWay}"
                   AutomationProperties.Name="estoq" />
            <Image Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Source="ms-appx:///Assets/Logos/estoq-q-mark-gold.png"
                   Visibility="{x:Bind ViewModel.IsSidebarCollapsed, Mode=OneWay}"
                   AutomationProperties.Name="estoq" />
          </Grid>

          <!-- Navigation -->
          <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.NavItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItemViewModel">
                <RadioButton GroupName="Navigation" Style="{StaticResource EqNavItemStyle}"
                             IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                             HorizontalContentAlignment="{x:Bind ItemAlignment, Mode=OneWay}"
                             Padding="{x:Bind ItemPadding, Mode=OneWay}"
                             ToolTipService.ToolTip="{x:Bind Label}"
                             AutomationProperties.Name="{x:Bind Label}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <Grid Width="24" Height="24">
                      <FontIcon Glyph="{x:Bind Glyph}" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont4xl}"
                                Foreground="{ThemeResource EqTextSecondaryBrush}"
                                Visibility="{x:Bind IsNotSelected, Mode=OneWay}" />
                      <FontIcon Glyph="{x:Bind Glyph}" FontFamily="{StaticResource EqIconFontFilled}" FontSize="{StaticResource EqFont4xl}"
                                Foreground="{ThemeResource EqGoldInkBrush}"
                                Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                    </Grid>
                    <Grid VerticalAlignment="Center" Visibility="{x:Bind IsExpanded, Mode=OneWay}">
                      <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource EqUiFontMedium}" FontSize="{StaticResource EqFontMd}"
                                 Foreground="{ThemeResource EqTextBrush}"
                                 Visibility="{x:Bind IsNotSelected, Mode=OneWay}" />
                      <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontMd}"
                                 Foreground="{ThemeResource EqTextBrush}"
                                 Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                    </Grid>
                  </StackPanel>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Divider pushes the user block to the bottom. -->
          <Rectangle Grid.Row="2" Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource EqBorderBrush}" Margin="4,0,4,8" />

          <!-- Account settings: avatar, name and role with a gear on the right. In the rail the avatar shows the gear on hover. -->
          <Button x:Name="AccountButton" Grid.Row="3" Background="Transparent" BorderThickness="0" CornerRadius="{StaticResource EqRadiusMd}" Padding="8"
                  HorizontalAlignment="{x:Bind ViewModel.AccountAlignment, Mode=OneWay}"
                  HorizontalContentAlignment="Stretch"
                  Command="{x:Bind ViewModel.OpenSettingsCommand}"
                  PointerEntered="OnAccountPointerEntered" PointerExited="OnAccountPointerExited"
                  ToolTipService.ToolTip="{x:Bind services:Loc.Get('Shell_AccountSettings')}" AutomationProperties.Name="{x:Bind services:Loc.Get('Shell_AccountSettings')}">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="0" Width="32" Height="32">
                <Border CornerRadius="{StaticResource EqRadiusXl}" Background="{ThemeResource EqOnGoldBrush}" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1">
                  <TextBlock Text="{x:Bind ViewModel.UserInitials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                             FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontSm}" Foreground="{ThemeResource EqGoldBrush}" />
                </Border>
                <Border x:Name="AccountHoverGear" CornerRadius="{StaticResource EqRadiusXl}" Background="{ThemeResource EqHoverFillBrush}" Opacity="0"
                        Visibility="{x:Bind ViewModel.IsSidebarCollapsed, Mode=OneWay}">
                  <FontIcon Glyph="&#xE8B8;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont2xl}"
                            Foreground="{ThemeResource EqTextBrush}" />
                </Border>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsSidebarExpanded, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.UserDisplayName}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontMd}"
                           Foreground="{ThemeResource EqTextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind ViewModel.UserRole}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <FontIcon Grid.Column="2" Glyph="&#xE8B8;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont4xl}"
                        VerticalAlignment="Center" Foreground="{ThemeResource EqTextSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.IsSidebarExpanded, Mode=OneWay}" />
            </Grid>
          </Button>
        </Grid>
      </Border>

      <!-- Collapse control: 24 px circle straddling the right border, level with the logo. -->
      <Button Style="{StaticResource EqSidebarCollapseButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,18,0,0" Click="OnSidebarToggleClick"
              ToolTipService.ToolTip="{x:Bind ViewModel.SidebarToggleToolTip, Mode=OneWay}"
              AutomationProperties.Name="{x:Bind services:Loc.Get('Shell_ToggleSidebarName')}">
        <FontIcon Glyph="{x:Bind ViewModel.SidebarToggleGlyph, Mode=OneWay}" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" />
      </Button>
    </Grid>

    <!-- Content column: window drag strip, top bar, page. Floating top bar sits beside the floating sidebar. -->
    <Grid Grid.Column="1" Margin="12,0,24,0" RowDefinitions="32,56,*">
      <Grid x:Name="DragRegion" Grid.Row="0" Background="Transparent" />

      <!-- Top bar (design system, TopBar): 56 px, surface, bottom border. -->
      <Grid Grid.Row="1" Background="{ThemeResource EqSurfaceBrush}" BorderBrush="{ThemeResource EqBorderBrush}"
            BorderThickness="1" CornerRadius="{StaticResource EqRadiusLg}" Padding="16,0" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource EqInputContainerStyle}" VerticalAlignment="Center">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xEF7A;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont2xl}"
                      Foreground="{ThemeResource EqTextSecondaryBrush}" />
            <TextBox x:Name="SearchBox" Grid.Column="1" VerticalAlignment="Center"
                     PlaceholderText="{x:Bind services:Loc.Get('Shell_SearchPlaceholder')}"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" MinHeight="0" Padding="0,6"
                     FontFamily="{StaticResource EqUiFont}" FontSize="{StaticResource EqFontMd}"
                     ToolTipService.ToolTip="{x:Bind services:Loc.Get('Shell_SearchTip')}"
                     AutomationProperties.Name="{x:Bind services:Loc.Get('Shell_SearchName')}">
              <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
              </TextBox.Resources>
              <TextBox.KeyboardAccelerators>
                <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnFocusSearch" />
                <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearch" />
              </TextBox.KeyboardAccelerators>
            </TextBox>
          </Grid>
        </Border>

        <!-- Shortcuts: New sale then Add product, round icon buttons without text. -->
        <Rectangle Grid.Column="1" Width="1" Height="28" Fill="{ThemeResource EqBorderBrush}" VerticalAlignment="Center" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Style="{StaticResource EqRoundIconButtonStyle}" Command="{x:Bind ViewModel.OpenPointOfSaleCommand}"
                  ToolTipService.ToolTip="{x:Bind services:Loc.Get('Shell_TipSale')}" AutomationProperties.Name="{x:Bind services:Loc.Get('Popup_Sale_Title')}">
            <FontIcon Glyph="&#xF17E;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont2xl}" />
          </Button>
          <Button Style="{StaticResource EqRoundIconButtonStyle}" Command="{x:Bind ViewModel.OpenAddItemsCommand}"
                  ToolTipService.ToolTip="{x:Bind services:Loc.Get('Shell_TipItems')}" AutomationProperties.Name="{x:Bind services:Loc.Get('Popup_Items_Title')}">
            <FontIcon Glyph="&#xE146;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont2xl}" />
          </Button>
          <Button Style="{StaticResource EqRoundIconButtonStyle}" Command="{x:Bind ViewModel.OpenStockAdjustmentsCommand}"
                  ToolTipService.ToolTip="{x:Bind services:Loc.Get('Shell_TipAdjust')}" AutomationProperties.Name="{x:Bind services:Loc.Get('Popup_Adjust_Title')}">
            <FontIcon Glyph="&#xEF6E;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont2xl}" />
          </Button>
          <Button Style="{StaticResource EqRoundIconButtonStyle}" Command="{x:Bind ViewModel.OpenReturnsCommand}"
                  ToolTipService.ToolTip="{x:Bind services:Loc.Get('Shell_TipReturns')}" AutomationProperties.Name="{x:Bind services:Loc.Get('Popup_Returns_Title')}">
            <FontIcon Glyph="&#xE5DB;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont2xl}" />
          </Button>
        </StackPanel>

        <Rectangle Grid.Column="3" Width="1" Height="28" Fill="{ThemeResource EqBorderBrush}" VerticalAlignment="Center" />

        <Button Grid.Column="4" Style="{StaticResource EqPlainIconButtonStyle}" Click="OnThemeToggleClick" Command="{x:Bind ViewModel.ToggleThemeCommand}"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="{x:Bind ViewModel.ThemeToolTip, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind services:Loc.Get('Shell_SwitchTheme')}">
          <FontIcon Glyph="{x:Bind ViewModel.ThemeGlyph, Mode=OneWay}" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont4xl}" />
        </Button>

        <!-- Notifications bell: opens the notifications pop-up (design system, NotificationPanel). Gold dot while unread. -->
        <Button Grid.Column="5" Style="{StaticResource EqPlainIconButtonStyle}" VerticalAlignment="Center"
                ToolTipService.ToolTip="{x:Bind services:Loc.Get('Notif_Title')}"
                AutomationProperties.Name="{x:Bind Notifications.BellLabel, Mode=OneWay}">
          <Grid>
            <FontIcon Glyph="&#xE7F5;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont4xl}" />
            <Ellipse Width="8" Height="8" Fill="{ThemeResource EqGoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,1,3,0" Visibility="{x:Bind Notifications.UnreadDotVisibility, Mode=OneWay}" />
          </Grid>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterStyle="{StaticResource EqNotificationFlyoutStyle}">
              <Grid Width="380" RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" Padding="16,14" ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{x:Bind services:Loc.Get('Notif_Title')}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontLg}"
                               Foreground="{ThemeResource EqTextBrush}" />
                    <TextBlock Text="{x:Bind Notifications.Summary, Mode=OneWay}" Style="{StaticResource EqCaptionStyle}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <HyperlinkButton Style="{StaticResource EqLinkButtonStyle}" Content="{x:Bind services:Loc.Get('Notif_MarkAllRead')}"
                                     Command="{x:Bind Notifications.MarkAllReadCommand}"
                                     IsEnabled="{x:Bind Notifications.HasUnread, Mode=OneWay}" />
                    <HyperlinkButton Style="{StaticResource EqLinkButtonStyle}" Content="{x:Bind services:Loc.Get('Notif_ClearRead')}"
                                     Command="{x:Bind Notifications.ClearReadCommand}"
                                     IsEnabled="{x:Bind Notifications.HasRead, Mode=OneWay}" />
                  </StackPanel>
                </Grid>
                <Rectangle Grid.Row="1" Height="1" Fill="{ThemeResource EqBorderBrush}" />
                <Grid Grid.Row="2" MaxHeight="400">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind Notifications.Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NotificationItemViewModel">
                          <Grid Padding="16,12" ColumnSpacing="12" Background="Transparent" Tag="{x:Bind NotificationId}"
                                Tapped="OnNotificationTapped" Opacity="{x:Bind ContentOpacity}">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="{StaticResource EqControlHeight}" CornerRadius="18" Background="{ThemeResource EqSurfaceBrush}"
                                    BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                              <FontIcon Glyph="{x:Bind Glyph}" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont2xl}"
                                        Foreground="{ThemeResource EqWarningBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                              <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontSize="{StaticResource EqFontMd}"
                                         FontFamily="{StaticResource EqUiFontSemiBold}" Foreground="{ThemeResource EqTextBrush}" />
                              <TextBlock Text="{x:Bind Detail}" Style="{StaticResource EqSecondaryStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <Ellipse Width="8" Height="8" Fill="{ThemeResource EqGoldBrush}" VerticalAlignment="Center"
                                         Visibility="{x:Bind UnreadVisibility}" />
                                <TextBlock Text="{x:Bind TimeText}" Style="{StaticResource EqCaptionStyle}" />
                              </StackPanel>
                              <Button Style="{StaticResource EqPlainIconButtonStyle}" Width="28" Height="28" HorizontalAlignment="Right"
                                      Tag="{x:Bind NotificationId}" Click="OnClearNotificationClick"
                                      Visibility="{x:Bind ReadVisibility}"
                                      ToolTipService.ToolTip="{x:Bind services:Loc.Get('Notif_Clear')}" AutomationProperties.Name="{x:Bind services:Loc.Get('Notif_ClearName')}">
                                <FontIcon Glyph="&#xE5CD;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" />
                              </Button>
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Padding="16,40"
                              Visibility="{x:Bind Notifications.EmptyVisibility, Mode=OneWay}">
                    <FontIcon Glyph="&#xE7F5;" FontFamily="{StaticResource EqIconFont}" FontSize="32"
                              Foreground="{ThemeResource EqTextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind services:Loc.Get('Notif_EmptyTitle')}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontMd}"
                               Foreground="{ThemeResource EqTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind services:Loc.Get('Notif_EmptyBody')}" Style="{StaticResource EqSecondaryStyle}"
                               HorizontalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Grid>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>

      <Frame x:Name="ContentFrame" Grid.Row="2" Padding="0,24,0,0" />
    </Grid>
    <!-- Pop-up host for F1 to F4: dimmed scrim over the whole window with the shared pop-up shell centred.
         Clicking the scrim, Esc or Close dismisses it. -->
    <Grid x:Name="PopupOverlay" Grid.ColumnSpan="2" Canvas.ZIndex="10" Background="{ThemeResource EqScrimBrush}"
          Padding="40,56,40,40" Visibility="Collapsed" Opacity="0" Tapped="OnScrimTapped">
      <controls:PopupShell x:Name="PopupFrame" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           Visibility="{x:Bind PopupState.IsFramed, Mode=OneWay}"
                           Title="{x:Bind PopupState.Title, Mode=OneWay}" Subtitle="{x:Bind PopupState.Subtitle, Mode=OneWay}"
                           ShortcutHint="{x:Bind PopupState.ShortcutHint, Mode=OneWay}"
                           IsShortcutHintVisible="{x:Bind PopupState.IsShortcutHintVisible, Mode=OneWay}"
                           PrimaryText="{x:Bind PopupState.PrimaryText, Mode=OneWay}"
                           IsPrimaryEnabled="{x:Bind PopupState.IsPrimaryEnabled, Mode=OneWay}"
                           CloseRequested="OnPopupCloseRequested" PrimaryInvoked="OnPopupPrimaryInvoked" Tapped="OnPopupTapped">
        <controls:PopupShell.HeaderContent>
          <!-- F4: the currency to hand over, as in the point of sale header. -->
          <returns:ReturnCurrencyChips Visibility="{x:Bind PopupState.IsReturns, Mode=OneWay}" />
        </controls:PopupShell.HeaderContent>
        <StackPanel Spacing="20">
          <TextBlock Text="{x:Bind PopupState.Message, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}"
                     Visibility="{x:Bind PopupState.ShowMessage, Mode=OneWay}" />

          <!-- F2: the Add product form. -->
          <addproduct:AddProductView Visibility="{x:Bind PopupState.IsAddProduct, Mode=OneWay}" />

          <!-- F4: the Returns form. -->
          <returns:ReturnsView Visibility="{x:Bind PopupState.IsReturns, Mode=OneWay}" />

          <!-- F3: the Stock adjustments form. -->
          <adjust:StockAdjustmentView Visibility="{x:Bind PopupState.IsStockAdjustment, Mode=OneWay}" />

          <!-- Account settings: end the session. Same action as F12. -->
          <Border Style="{StaticResource EqCardStyle}" Visibility="{x:Bind PopupState.IsSettings, Mode=OneWay}">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind services:Loc.Get('Account_SessionTitle')}" Style="{StaticResource EqLabelStyle}"
                           Foreground="{ThemeResource EqTextBrush}" />
                <TextBlock Text="{x:Bind services:Loc.Get('Account_LogOutHint')}" Style="{StaticResource EqSecondaryStyle}" />
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource EqSecondaryButtonStyle}" VerticalAlignment="Center"
                      Command="{x:Bind PopupState.LogOutCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE9BA;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" />
                  <TextBlock Text="{x:Bind services:Loc.Get('Account_LogOut')}" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
        </StackPanel>
      </controls:PopupShell>

    <!-- Product added: confirmation over the whole pop-up (header and footer included), modelled on the point of sale's Sale completed. -->
    <Border Background="{ThemeResource EqScrimBrush}" Tapped="OnPopupTapped" CornerRadius="{StaticResource EqRadiusXl}"
            Visibility="{x:Bind PopupState.AddProduct.IsCompleted, Mode=OneWay}">
      <Border Width="640" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource EqCardStyle}" Padding="24"
              Background="{ThemeResource EqSurfaceBrush}">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="12">
          <FontIcon Glyph="&#xF0BE;" FontFamily="{StaticResource EqIconFont}" FontSize="48" Foreground="{ThemeResource EqSuccessBrush}"
                    HorizontalAlignment="Center" Grid.Row="0" />
          <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="{x:Bind services:Loc.Get('Add_DoneTitle')}" Style="{StaticResource EqCardTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Bind services:Loc.Get('Add_DoneSubtitle')}" Style="{StaticResource EqSecondaryStyle}" HorizontalAlignment="Center" />
          </StackPanel>
          <Grid Grid.Row="2" Style="{StaticResource EqTableHeaderStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="104" />
              <ColumnDefinition Width="56" />
              <ColumnDefinition Width="112" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Add_DoneColProduct')}" Style="{StaticResource EqTableHeaderTextStyle}" />
            <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Add_DoneColPrice')}" Style="{StaticResource EqTableHeaderTextStyle}" TextAlignment="Right" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="2" Text="{x:Bind services:Loc.Get('Add_DoneColQty')}" Style="{StaticResource EqTableHeaderTextStyle}" TextAlignment="Right" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="{x:Bind services:Loc.Get('Add_DoneColTotal')}" Style="{StaticResource EqTableHeaderTextStyle}" TextAlignment="Right" HorizontalAlignment="Right" />
          </Grid>
          <ScrollViewer Grid.Row="3" MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <ItemsControl ItemsSource="{x:Bind PopupState.AddProduct.CompletedItems, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="addvm:AddedItemViewModel">
                  <Grid MinHeight="56" Style="{StaticResource EqTableRowStyle}">
                    <Border Style="{StaticResource EqTableBandStyle}" Visibility="{x:Bind IsAlternateRow}" />
                    <Grid Padding="12,8,8,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="104" />
                      <ColumnDefinition Width="56" />
                      <ColumnDefinition Width="112" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{x:Bind Name}" Style="{StaticResource EqTableCellStyle}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Bind DetailText}" Style="{StaticResource EqSecondaryStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Bind PriceText}" Style="{StaticResource EqTableCellStyle}" TextAlignment="Right" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="{x:Bind QuantityText}" Style="{StaticResource EqTableCellStyle}" TextAlignment="Right" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="{x:Bind TotalText}" Style="{StaticResource EqTableCellStrongStyle}" TextAlignment="Right" />
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Grid.Row="4" Spacing="8">
            <Rectangle Height="1" Fill="{ThemeResource EqBorderBrush}" />
            <Grid>
              <TextBlock Text="{x:Bind services:Loc.Get('Add_DoneArticles')}" Style="{StaticResource EqTableCellStyle}" />
              <TextBlock Text="{x:Bind PopupState.AddProduct.DoneArticlesText, Mode=OneWay}" Style="{StaticResource EqTableCellStrongStyle}" />
            </Grid>
            <Grid>
              <TextBlock Text="{x:Bind services:Loc.Get('Add_DoneTotalPrice')}" Style="{StaticResource EqTableCellStyle}" FontFamily="{StaticResource EqUiFontSemiBold}" />
              <TextBlock Text="{x:Bind PopupState.AddProduct.DoneTotalText, Mode=OneWay}" Style="{StaticResource EqTableCellStrongStyle}" FontSize="{StaticResource EqFont2xl}" />
            </Grid>
          </StackPanel>
          <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Padding="0,8,0,0">
            <Button Style="{StaticResource EqSecondaryButtonStyle}" Content="{x:Bind services:Loc.Get('Popup_Close')}" Command="{x:Bind PopupState.AddProduct.DoneCommand}" />
            <Button Style="{StaticResource EqPrimaryButtonStyle}" Command="{x:Bind PopupState.AddProduct.AddAnotherCommand}"
                    Content="{x:Bind services:Loc.Get('Add_DoneAnother')}" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>
    <!-- Return completed: same placement as Product added. -->
    <returns:ReturnCompletedOverlay />
    <!-- Adjustment applied: confirmation over the whole pop-up (header and footer included), same pattern as Product added. -->
    <Border Background="{ThemeResource EqScrimBrush}" Tapped="OnPopupTapped" CornerRadius="{StaticResource EqRadiusXl}"
            Visibility="{x:Bind PopupState.Adjustment.IsCompleted, Mode=OneWay}">
      <Border Width="640" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource EqCardStyle}" Padding="24"
              Background="{ThemeResource EqSurfaceBrush}">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="12">
          <FontIcon Glyph="&#xF0BE;" FontFamily="{StaticResource EqIconFont}" FontSize="48" Foreground="{ThemeResource EqSuccessBrush}"
                    HorizontalAlignment="Center" Grid.Row="0" />
          <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="{x:Bind services:Loc.Get('Adjust_DoneTitle')}" Style="{StaticResource EqCardTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Bind PopupState.Adjustment.DoneSubtitle, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" HorizontalAlignment="Center" />
          </StackPanel>
          <Grid Grid.Row="2" Style="{StaticResource EqTableHeaderStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="72" />
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Adjust_ColProduct')}" Style="{StaticResource EqTableHeaderTextStyle}" />
            <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Adjust_DoneColWas')}" Style="{StaticResource EqTableHeaderTextStyle}" TextAlignment="Right" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="2" Text="{x:Bind services:Loc.Get('Adjust_DoneColChange')}" Style="{StaticResource EqTableHeaderTextStyle}" TextAlignment="Right" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="{x:Bind services:Loc.Get('Adjust_DoneColNow')}" Style="{StaticResource EqTableHeaderTextStyle}" TextAlignment="Right" HorizontalAlignment="Right" />
          </Grid>
          <ScrollViewer Grid.Row="3" MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <ItemsControl ItemsSource="{x:Bind PopupState.Adjustment.CompletedItems, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="adjustvm:AppliedItemViewModel">
                  <Grid MinHeight="56" Style="{StaticResource EqTableRowStyle}">
                    <Border Style="{StaticResource EqTableBandStyle}" Visibility="{x:Bind IsAlternateRow}" />
                    <Grid Padding="12,8,8,8" ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="72" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource EqTableCellStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind DetailText}" Style="{StaticResource EqSecondaryStyle}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{x:Bind PreviousText}" Style="{StaticResource EqTableCellStyle}" TextAlignment="Right" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="2" Text="{x:Bind DifferenceText}" Style="{StaticResource EqTableCellStrongStyle}" TextAlignment="Right"
                                 Foreground="{ThemeResource EqSuccessBrush}" Visibility="{x:Bind IsIncrease}" />
                      <TextBlock Grid.Column="2" Text="{x:Bind DifferenceText}" Style="{StaticResource EqTableCellStrongStyle}" TextAlignment="Right"
                                 Foreground="{ThemeResource EqDangerBrush}" Visibility="{x:Bind IsDecrease}" />
                      <TextBlock Grid.Column="3" Text="{x:Bind NewStockText}" Style="{StaticResource EqTableCellStrongStyle}" TextAlignment="Right" />
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Grid.Row="4" Spacing="8">
            <Rectangle Height="1" Fill="{ThemeResource EqBorderBrush}" />
            <Grid>
              <TextBlock Text="{x:Bind services:Loc.Get('Adjust_Increases')}" Style="{StaticResource EqTableCellStyle}" />
              <TextBlock Text="{x:Bind PopupState.Adjustment.DoneIncreasesText, Mode=OneWay}" Style="{StaticResource EqTableCellStrongStyle}" Foreground="{ThemeResource EqSuccessBrush}" />
            </Grid>
            <Grid>
              <TextBlock Text="{x:Bind services:Loc.Get('Adjust_Decreases')}" Style="{StaticResource EqTableCellStyle}" />
              <TextBlock Text="{x:Bind PopupState.Adjustment.DoneDecreasesText, Mode=OneWay}" Style="{StaticResource EqTableCellStrongStyle}" Foreground="{ThemeResource EqDangerBrush}" />
            </Grid>
            <Grid>
              <TextBlock Text="{x:Bind services:Loc.Get('Adjust_Net')}" Style="{StaticResource EqTableCellStyle}" FontFamily="{StaticResource EqUiFontSemiBold}" />
              <TextBlock Text="{x:Bind PopupState.Adjustment.DoneNetText, Mode=OneWay}" Style="{StaticResource EqTableCellStrongStyle}" FontSize="{StaticResource EqFont2xl}" />
            </Grid>
          </StackPanel>
          <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Padding="0,8,0,0">
            <Button Style="{StaticResource EqSecondaryButtonStyle}" Content="{x:Bind services:Loc.Get('Popup_Close')}" Command="{x:Bind PopupState.Adjustment.DoneCommand}" />
            <Button Style="{StaticResource EqPrimaryButtonStyle}" Command="{x:Bind PopupState.Adjustment.NewAdjustmentCommand}"
                    Content="{x:Bind services:Loc.Get('Adjust_DoneNew')}" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>
      <!-- The point of sale has its own layout (mockup 3) and does not use the shared frame. -->
      <pos:PointOfSaleView x:Name="PosView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           Visibility="{x:Bind PopupState.IsPointOfSale, Mode=OneWay}" Tapped="OnPopupTapped" />
    </Grid>
  </Grid>
</Page>
