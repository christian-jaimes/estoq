<UserControl
    x:Class="Estoq.App.Controls.StatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Status pill: tinted fill, dot and words. The words always carry the meaning; colour only backs them up. -->
  <Grid x:Name="Root" HorizontalAlignment="Left" VerticalAlignment="Center">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="KindStates">
        <VisualState x:Name="Neutral">
          <VisualState.Setters>
            <Setter Target="Tint.Background" Value="{ThemeResource EqTextSecondaryBrush}" />
            <Setter Target="Dot.Fill" Value="{ThemeResource EqTextSecondaryBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Success">
          <VisualState.Setters>
            <Setter Target="Tint.Background" Value="{ThemeResource EqSuccessBrush}" />
            <Setter Target="Dot.Fill" Value="{ThemeResource EqSuccessBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Warning">
          <VisualState.Setters>
            <Setter Target="Tint.Background" Value="{ThemeResource EqWarningBrush}" />
            <Setter Target="Dot.Fill" Value="{ThemeResource EqWarningBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Danger">
          <VisualState.Setters>
            <Setter Target="Tint.Background" Value="{ThemeResource EqDangerBrush}" />
            <Setter Target="Dot.Fill" Value="{ThemeResource EqDangerBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Border x:Name="Tint" Style="{StaticResource EqBadgeStyle}" Background="{ThemeResource EqTextSecondaryBrush}" Opacity="0.18" />
    <StackPanel Orientation="Horizontal" Spacing="6" Padding="10,3" VerticalAlignment="Center">
      <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{ThemeResource EqTextSecondaryBrush}" VerticalAlignment="Center" />
      <TextBlock x:Name="Label" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontXs}"
                 Foreground="{ThemeResource EqTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
