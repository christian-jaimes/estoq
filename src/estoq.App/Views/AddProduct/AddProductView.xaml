<UserControl
    x:Class="Estoq.App.Views.AddProduct.AddProductView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Estoq.App.Controls"
    xmlns:services="using:Estoq.App.Services"
    xmlns:local="using:Estoq.App.Views.AddProduct"
    xmlns:vm="using:Estoq.App.ViewModels.AddProduct">

  <UserControl.Resources>
    <!-- Size chip and colour swatch: a toggle that is outlined when off and gold when on. -->
    <Style x:Key="AddChoiceToggleStyle" TargetType="ToggleButton">
      <Setter Property="FontFamily" Value="{StaticResource EqUiFontSemiBold}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="{StaticResource EqRadiusMd}" />
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Foreground" Value="{ThemeResource EqTextBrush}" />
      <Setter Property="Background" Value="{ThemeResource EqSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource EqBorderBrush}" />
    </Style>
  </UserControl.Resources>

  <StackPanel Spacing="16" MinWidth="900">

    <!-- Duplicate found: brand, product type and model label already exist. -->
    <Border Visibility="{x:Bind ViewModel.HasDuplicate, Mode=OneWay}" Style="{StaticResource EqCardStyle}" Padding="16,12"
            BorderBrush="{ThemeResource EqWarningBrush}">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xF083;" FontFamily="{StaticResource EqIconFont}" FontSize="22" Foreground="{ThemeResource EqWarningBrush}"
                  VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DuplicateMessage, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}"
                   Foreground="{ThemeResource EqTextBrush}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="4*" />
        <ColumnDefinition Width="5*" />
      </Grid.ColumnDefinitions>

      <!-- Left column: General, Pricing, Size and colour. -->
      <StackPanel Grid.Column="0" Spacing="16">

        <Border Style="{StaticResource EqCardStyle}" Padding="20">
          <StackPanel Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon Glyph="&#xEF6E;" FontFamily="{StaticResource EqIconFont}" FontSize="22" Foreground="{ThemeResource EqGoldInkBrush}" />
              <TextBlock Text="{x:Bind services:Loc.Get('Add_General')}" Style="{StaticResource EqCardTitleStyle}" FontSize="18" />
            </StackPanel>

            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{x:Bind services:Loc.Get('Add_ProductType')}" Style="{StaticResource EqLabelStyle}" />
                  <TextBlock Text="*" Style="{StaticResource EqLabelStyle}" Foreground="{ThemeResource EqGoldInkBrush}" />
                </StackPanel>
                <Border Style="{StaticResource EqInputContainerStyle}" Padding="4,0">
                  <ComboBox x:Name="TypeBox" IsEditable="True" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0"
                            ItemsSource="{x:Bind ViewModel.ProductTypeNames}" Text="{x:Bind ViewModel.ProductType, Mode=TwoWay}"
                            TextSubmitted="OnComboTextSubmitted"
                            AutomationProperties.Name="{x:Bind services:Loc.Get('Add_ProductType')}" />
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{x:Bind services:Loc.Get('Add_Category')}" Style="{StaticResource EqLabelStyle}" />
                  <TextBlock Text="*" Style="{StaticResource EqLabelStyle}" Foreground="{ThemeResource EqGoldInkBrush}" />
                </StackPanel>
                <Border Style="{StaticResource EqInputContainerStyle}" Padding="4,0">
                  <ComboBox x:Name="CategoryBox" IsEditable="True" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0"
                            ItemsSource="{x:Bind ViewModel.CategoryNames}" Text="{x:Bind ViewModel.Category, Mode=TwoWay}"
                            TextSubmitted="OnComboTextSubmitted"
                            AutomationProperties.Name="{x:Bind services:Loc.Get('Add_Category')}" />
                </Border>
              </StackPanel>
            </Grid>

            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{x:Bind services:Loc.Get('Add_Brand')}" Style="{StaticResource EqLabelStyle}" />
                  <TextBlock Text="*" Style="{StaticResource EqLabelStyle}" Foreground="{ThemeResource EqGoldInkBrush}" />
                </StackPanel>
                <Border Style="{StaticResource EqInputContainerStyle}" Padding="4,0">
                  <ComboBox x:Name="BrandBox" IsEditable="True" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0"
                            ItemsSource="{x:Bind ViewModel.BrandNames}" Text="{x:Bind ViewModel.Brand, Mode=TwoWay}"
                            TextSubmitted="OnComboTextSubmitted"
                            AutomationProperties.Name="{x:Bind services:Loc.Get('Add_Brand')}" />
                </Border>
              </StackPanel>
              <controls:EqField Grid.Column="1" Label="{x:Bind services:Loc.Get('Add_ModelLabel')}" IsRequired="True"
                                PlaceholderText="{x:Bind services:Loc.Get('Add_ModelLabelHint')}"
                                Text="{x:Bind ViewModel.ModelLabel, Mode=TwoWay}" />
            </Grid>

            <!-- Generated name; editable. "Use generated name" appears once it was typed over. -->
            <StackPanel Spacing="4">
              <controls:EqField Label="{x:Bind services:Loc.Get('Add_Name')}" IsRequired="True"
                                Text="{x:Bind ViewModel.Name, Mode=TwoWay}" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Add_NameHint')}" Style="{StaticResource EqCaptionStyle}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <HyperlinkButton Grid.Column="1" Style="{StaticResource EqLinkButtonStyle}" Padding="0"
                                 Content="{x:Bind services:Loc.Get('Add_UseGeneratedName')}"
                                 Visibility="{x:Bind ViewModel.NameEdited, Mode=OneWay}"
                                 Command="{x:Bind ViewModel.ResetNameCommand}" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{x:Bind services:Loc.Get('Add_Description')}" Style="{StaticResource EqLabelStyle}" />
                <TextBlock Text="{x:Bind services:Loc.Get('Label_Optional')}" Style="{StaticResource EqSecondaryStyle}" VerticalAlignment="Center" />
              </StackPanel>
              <Border Style="{StaticResource EqInputContainerStyle}" Height="72" Padding="12,4">
                <Border.Resources>
                  <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                  <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                  <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                  <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </Border.Resources>
                <TextBox AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0,4"
                         FontFamily="{StaticResource EqUiFont}" FontSize="14"
                         PlaceholderText="{x:Bind services:Loc.Get('Add_DescriptionHint')}"
                         Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{x:Bind services:Loc.Get('Add_Description')}" />
              </Border>
            </StackPanel>

            <controls:EqField Label="{x:Bind services:Loc.Get('Add_SupplierBarcode')}" IsOptional="True"
                              PlaceholderText="{x:Bind services:Loc.Get('Add_SupplierBarcodeHint')}"
                              Text="{x:Bind ViewModel.SupplierBarcode, Mode=TwoWay}" />
          </StackPanel>
        </Border>

        <!-- Pricing: cost and margin are hidden from cashiers. -->
        <Border Style="{StaticResource EqCardStyle}" Padding="20">
          <StackPanel Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon Glyph="&#xF05B;" FontFamily="{StaticResource EqIconFont}" FontSize="22" Foreground="{ThemeResource EqGoldInkBrush}" />
              <TextBlock Text="{x:Bind services:Loc.Get('Add_Pricing')}" Style="{StaticResource EqCardTitleStyle}" FontSize="18" />
            </StackPanel>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <controls:EqField Grid.Column="0" Label="{x:Bind services:Loc.Get('Add_Cost')}" IsOptional="True"
                                Suffix="{x:Bind ViewModel.CurrencyCode}" Visibility="{x:Bind ViewModel.ShowCost, Mode=OneWay}"
                                Text="{x:Bind ViewModel.CostText, Mode=TwoWay}" />
              <controls:EqField Grid.Column="1" Label="{x:Bind services:Loc.Get('Add_Selling')}" IsRequired="True"
                                Suffix="{x:Bind ViewModel.CurrencyCode}"
                                Text="{x:Bind ViewModel.SellingText, Mode=TwoWay}" />
              <StackPanel Grid.Column="2" Spacing="6" Visibility="{x:Bind ViewModel.ShowCost, Mode=OneWay}">
                <TextBlock Text="{x:Bind services:Loc.Get('Add_Margin')}" Style="{StaticResource EqLabelStyle}" TextTrimming="CharacterEllipsis" />
                <Border Style="{StaticResource EqInputContainerStyle}" BorderBrush="{ThemeResource EqSuccessBrush}" Padding="0">
                  <Grid>
                    <Rectangle Fill="{ThemeResource EqSuccessBrush}" Opacity="0.15" RadiusX="7" RadiusY="7" />
                    <TextBlock Text="{x:Bind ViewModel.SummaryMargin, Mode=OneWay}" Style="{StaticResource EqLabelStyle}"
                               Foreground="{ThemeResource EqSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind local:AddProductView.Not(ViewModel.IsMarginNegative), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.SummaryMargin, Mode=OneWay}" Style="{StaticResource EqLabelStyle}"
                               Foreground="{ThemeResource EqDangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind ViewModel.IsMarginNegative, Mode=OneWay}" />
                  </Grid>
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Size and colour: only ticked combinations become variants. -->
        <Border Style="{StaticResource EqCardStyle}" Padding="20">
          <StackPanel Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon Glyph="&#xE53B;" FontFamily="{StaticResource EqIconFont}" FontSize="22" Foreground="{ThemeResource EqGoldInkBrush}" />
              <TextBlock Text="{x:Bind services:Loc.Get('Add_SizeColour')}" Style="{StaticResource EqCardTitleStyle}" FontSize="18" />
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="{x:Bind services:Loc.Get('Add_Sizes')}" Style="{StaticResource EqLabelStyle}" />
              <ItemsRepeater ItemsSource="{x:Bind ViewModel.Sizes}">
                <ItemsRepeater.Layout>
                  <UniformGridLayout MinItemWidth="52" MinItemHeight="36" MinRowSpacing="8" MinColumnSpacing="8" ItemsStretch="None" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChoiceItemViewModel">
                    <ToggleButton Style="{StaticResource AddChoiceToggleStyle}" Content="{x:Bind Label}"
                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}" HorizontalAlignment="Stretch">
                      <ToggleButton.Resources>
                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SystemAccentColor}" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SystemAccentColorLight1}" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SystemAccentColorDark1}" />
                        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="EqOnGoldBrush" />
                        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="EqOnGoldBrush" />
                        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="EqOnGoldBrush" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{ThemeResource SystemAccentColor}" />
                      </ToggleButton.Resources>
                    </ToggleButton>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
              <Button Style="{StaticResource EqSecondaryButtonStyle}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE145;" FontFamily="{StaticResource EqIconFont}" FontSize="18" />
                  <TextBlock Text="{x:Bind services:Loc.Get('Add_AddSize')}" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout x:Name="AddSizeFlyout">
                    <StackPanel Spacing="8" Width="220">
                      <TextBox x:Name="NewSizeBox" PlaceholderText="{x:Bind services:Loc.Get('Add_NewSizeHint')}" MaxLength="8"
                               KeyDown="OnNewSizeKeyDown" />
                      <Button Style="{StaticResource EqPrimaryButtonStyle}" HorizontalAlignment="Stretch"
                              Content="{x:Bind services:Loc.Get('Add_AddSizeConfirm')}" Click="OnAddSizeClick" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="{x:Bind services:Loc.Get('Add_Colours')}" Style="{StaticResource EqLabelStyle}" />
              <ItemsRepeater ItemsSource="{x:Bind ViewModel.VisibleColours}">
                <ItemsRepeater.Layout>
                  <UniformGridLayout MinItemWidth="40" MinItemHeight="40" MinRowSpacing="8" MinColumnSpacing="8" ItemsStretch="None" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChoiceItemViewModel">
                    <ToggleButton Width="40" Height="40" Padding="0" CornerRadius="20" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                  ToolTipService.ToolTip="{x:Bind Label}" AutomationProperties.Name="{x:Bind Label}"
                                  Background="Transparent" BorderBrush="{ThemeResource EqBorderBrush}">
                      <ToggleButton.Resources>
                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SystemAccentColor}" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SystemAccentColorLight1}" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SystemAccentColorDark1}" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{ThemeResource SystemAccentColor}" />
                      </ToggleButton.Resources>
                      <Ellipse Width="28" Height="28" Fill="{x:Bind SwatchBrush}" Stroke="{ThemeResource EqBorderBrush}" StrokeThickness="1" />
                    </ToggleButton>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
              <Button Style="{StaticResource EqSecondaryButtonStyle}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xEF7A;" FontFamily="{StaticResource EqIconFont}" FontSize="18" />
                  <TextBlock Text="{x:Bind services:Loc.Get('Add_MoreColours')}" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout>
                    <StackPanel Spacing="8" Width="240">
                      <TextBox PlaceholderText="{x:Bind services:Loc.Get('Add_SearchColours')}"
                               Text="{x:Bind ViewModel.ColourSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredColours}">
                          <ItemsRepeater.Layout>
                            <StackLayout Spacing="2" />
                          </ItemsRepeater.Layout>
                          <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChoiceItemViewModel">
                              <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="20" Height="20" Fill="{x:Bind SwatchBrush}" Stroke="{ThemeResource EqBorderBrush}"
                                         StrokeThickness="1" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" Content="{x:Bind Label}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" />
                              </Grid>
                            </DataTemplate>
                          </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                      </ScrollViewer>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Right column: image and summary, then the variants table. -->
      <StackPanel Grid.Column="1" Spacing="16">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource EqCardStyle}" Padding="20">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE1A1;" FontFamily="{StaticResource EqIconFont}" FontSize="22" Foreground="{ThemeResource EqGoldInkBrush}" />
                <TextBlock Text="{x:Bind services:Loc.Get('Add_Image')}" Style="{StaticResource EqCardTitleStyle}" FontSize="18" />
              </StackPanel>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="220" CornerRadius="{StaticResource EqRadiusMd}" Background="{ThemeResource EqSurfaceElevatedBrush}"
                        BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1">
                  <Grid>
                    <Image Source="{x:Bind ViewModel.MainImage, Mode=OneWay}" Stretch="Uniform"
                           Visibility="{x:Bind ViewModel.HasMainImage, Mode=OneWay}" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6"
                                Visibility="{x:Bind ViewModel.HasNoMainImage, Mode=OneWay}">
                      <FontIcon Glyph="&#xE1A1;" FontFamily="{StaticResource EqIconFont}" FontSize="36"
                                Foreground="{ThemeResource EqTextSecondaryBrush}" HorizontalAlignment="Center" />
                      <TextBlock Text="{x:Bind services:Loc.Get('Add_NoImage')}" Style="{StaticResource EqCaptionStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource EqPlainIconButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                            Command="{x:Bind ViewModel.RemoveMainImageCommand}" Visibility="{x:Bind ViewModel.HasMainImage, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind services:Loc.Get('Add_RemoveImage')}"
                            AutomationProperties.Name="{x:Bind services:Loc.Get('Add_RemoveImage')}">
                      <FontIcon Glyph="&#xE5CD;" FontFamily="{StaticResource EqIconFont}" FontSize="20" />
                    </Button>
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Spacing="8" Width="56">
                  <ItemsRepeater ItemsSource="{x:Bind ViewModel.Images}">
                    <ItemsRepeater.Layout>
                      <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProductImageViewModel">
                        <Button Width="56" Height="56" Padding="0" Background="Transparent" BorderBrush="{ThemeResource EqBorderBrush}"
                                Click="OnThumbnailClick">
                          <Image Source="{x:Bind Preview}" Stretch="UniformToFill" Width="52" Height="52" />
                        </Button>
                      </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                  </ItemsRepeater>
                  <Button Width="56" Height="56" Padding="0" Background="Transparent" BorderBrush="{ThemeResource EqBorderBrush}"
                          Command="{x:Bind ViewModel.AddImageCommand}"
                          ToolTipService.ToolTip="{x:Bind services:Loc.Get('Add_AddImage')}"
                          AutomationProperties.Name="{x:Bind services:Loc.Get('Add_AddImage')}">
                    <FontIcon Glyph="&#xE145;" FontFamily="{StaticResource EqIconFont}" FontSize="24" />
                  </Button>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Style="{StaticResource EqCardStyle}" Padding="20">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE88E;" FontFamily="{StaticResource EqIconFont}" FontSize="22" Foreground="{ThemeResource EqGoldInkBrush}" />
                <TextBlock Text="{x:Bind services:Loc.Get('Add_Summary')}" Style="{StaticResource EqCardTitleStyle}" FontSize="18" />
              </StackPanel>
              <!-- Label left, value right; a long Spanish label wraps instead of pushing the value out. -->
              <Grid ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MaxWidth="120" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{x:Bind services:Loc.Get('Add_Category')}" Style="{StaticResource EqSecondaryStyle}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.SummaryCategory, Mode=OneWay}" Style="{StaticResource EqLabelStyle}"
                           FontSize="13" TextAlignment="Right" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="{x:Bind services:Loc.Get('Add_Brand')}" Style="{StaticResource EqSecondaryStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SummaryBrand, Mode=OneWay}" Style="{StaticResource EqLabelStyle}"
                           FontSize="13" TextAlignment="Right" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Text="{x:Bind services:Loc.Get('Add_Selling')}" Style="{StaticResource EqSecondaryStyle}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SummarySelling, Mode=OneWay}" Style="{StaticResource EqLabelStyle}"
                           FontSize="13" TextAlignment="Right" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Text="{x:Bind services:Loc.Get('Add_Margin')}" Style="{StaticResource EqSecondaryStyle}"
                           Visibility="{x:Bind ViewModel.ShowCost, Mode=OneWay}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SummaryMargin, Mode=OneWay}" Style="{StaticResource EqLabelStyle}"
                           FontSize="13" TextAlignment="Right" TextWrapping="Wrap" Foreground="{ThemeResource EqSuccessBrush}"
                           Visibility="{x:Bind ViewModel.ShowCost, Mode=OneWay}" />
                <TextBlock Grid.Row="4" Text="{x:Bind services:Loc.Get('Add_SummaryVariants')}" Style="{StaticResource EqSecondaryStyle}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.SummaryVariants, Mode=OneWay}" Style="{StaticResource EqLabelStyle}"
                           FontSize="13" TextAlignment="Right" TextWrapping="Wrap" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Variants and opening stock. SKU can be typed over; the barcode is generated. -->
        <Border Style="{StaticResource EqCardStyle}" Padding="20">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon Glyph="&#xF720;" FontFamily="{StaticResource EqIconFont}" FontSize="22" Foreground="{ThemeResource EqGoldInkBrush}" />
              <StackPanel>
                <TextBlock Text="{x:Bind services:Loc.Get('Add_Variants')}" Style="{StaticResource EqCardTitleStyle}" FontSize="18" />
              </StackPanel>
            </StackPanel>
            <TextBlock Text="{x:Bind services:Loc.Get('Add_VariantsHint')}" Style="{StaticResource EqSecondaryStyle}" />

            <Grid ColumnSpacing="12" Padding="8,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="110" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="32" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Add_ColVariant')}" Style="{StaticResource EqLabelStyle}" FontSize="13" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Add_ColSku')}" Style="{StaticResource EqLabelStyle}" FontSize="13" TextWrapping="Wrap" />
              <TextBlock Grid.Column="2" Text="{x:Bind services:Loc.Get('Add_ColBarcode')}" Style="{StaticResource EqLabelStyle}" FontSize="13" TextWrapping="Wrap" />
              <TextBlock Grid.Column="3" Text="{x:Bind services:Loc.Get('Add_ColStock')}" Style="{StaticResource EqLabelStyle}" FontSize="13" TextWrapping="Wrap" />
            </Grid>
            <Rectangle Height="1" Fill="{ThemeResource EqBorderBrush}" />

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Variants}">
              <ItemsRepeater.Layout>
                <StackLayout Spacing="4" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:VariantRowViewModel">
                  <Grid ColumnSpacing="12" Padding="8,2" MinHeight="44">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" MinWidth="110" />
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="112" />
                      <ColumnDefinition Width="112" />
                      <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                      <Ellipse Width="22" Height="22" Fill="{x:Bind SwatchBrush}" Stroke="{ThemeResource EqBorderBrush}" StrokeThickness="1"
                               Visibility="{x:Bind HasSwatch}" />
                      <TextBlock Text="{x:Bind Label}" Style="{StaticResource EqLabelStyle}" FontSize="13" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBox Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource EqUiFont}" FontSize="13"
                             Text="{x:Bind Sku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                             AutomationProperties.Name="{x:Bind Label}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind InternalBarcode}" Style="{StaticResource EqSecondaryStyle}" VerticalAlignment="Center"
                               IsTextSelectionEnabled="True" />
                    <NumberBox Grid.Column="3" VerticalAlignment="Center" Minimum="0" Maximum="1000000" SmallChange="1" LargeChange="10"
                               SpinButtonPlacementMode="Inline" Value="{x:Bind OpeningStock, Mode=TwoWay}"
                               AutomationProperties.Name="{x:Bind Label}" />
                    <Button Grid.Column="4" Style="{StaticResource EqPlainIconButtonStyle}" Click="OnRemoveVariantClick"
                            VerticalAlignment="Center">
                      <FontIcon Glyph="&#xE5CD;" FontFamily="{StaticResource EqIconFont}" FontSize="18" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <TextBlock Text="{x:Bind services:Loc.Get('Add_NoVariants')}" Style="{StaticResource EqSecondaryStyle}"
                       Visibility="{x:Bind local:AddProductView.Not(ViewModel.HasVariants), Mode=OneWay}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- What is still missing, shown once the form has been touched. -->
    <TextBlock Text="{x:Bind ViewModel.ValidationText, Mode=OneWay}" Foreground="{ThemeResource EqDangerBrush}" FontSize="13"
               TextWrapping="Wrap" HorizontalAlignment="Right" Visibility="{x:Bind ViewModel.ShowValidation, Mode=OneWay}" />
  </StackPanel>
</UserControl>
