<Page
    x:Class="Estoq.App.Views.InventoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Estoq.App.Controls"
    xmlns:local="using:Estoq.App.Views"
    xmlns:services="using:Estoq.App.Services"
    xmlns:vm="using:Estoq.App.ViewModels.Inventory"
    Foreground="{ThemeResource EqTextBrush}">

  <Page.Resources>
    <!-- Tab: text with a gold underline on the selected one. Promote to Themes/Styles.xaml when a second page needs it. -->
    <Style x:Key="InvTabStyle" TargetType="RadioButton">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="FontFamily" Value="{StaticResource EqUiFontSemiBold}" />
      <Setter Property="FontSize" Value="{StaticResource EqFontMd}" />
      <Setter Property="Foreground" Value="{ThemeResource EqTextSecondaryBrush}" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EqGoldInkBrush}" />
      <Setter Property="FocusVisualPrimaryThickness" Value="2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid x:Name="Root" Background="Transparent" CornerRadius="{StaticResource EqRadiusSm}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Root.Background" Value="{ThemeResource EqHoverFillBrush}" />
                      <Setter Target="Presenter.Foreground" Value="{ThemeResource EqTextBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Root.Background" Value="{ThemeResource EqHoverFillBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <VisualState.Setters>
                      <Setter Target="Root.Opacity" Value="0.4" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                  <VisualState x:Name="Unchecked" />
                  <VisualState x:Name="Indeterminate" />
                  <VisualState x:Name="Checked">
                    <VisualState.Setters>
                      <Setter Target="Presenter.Foreground" Value="{ThemeResource EqGoldInkBrush}" />
                      <Setter Target="Underline.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <ContentPresenter x:Name="Presenter" Padding="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}" />
              <Rectangle x:Name="Underline" Visibility="Collapsed" Height="2" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1"
                         Margin="8,0" Fill="{ThemeResource EqGoldBrush}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Filter and sort buttons: secondary button, left text that trims, chevron at the end. -->
    <Style x:Key="InvFilterButtonStyle" TargetType="Button" BasedOn="{StaticResource EqSecondaryButtonStyle}">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontFamily" Value="{StaticResource EqUiFont}" />
    </Style>
  </Page.Resources>

  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16" Margin="0,0,0,24">

    <!-- Title and actions -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="{x:Bind services:Loc.Get('Nav_Inventory')}" Style="{StaticResource EqPageTitleStyle}" />
        <TextBlock Text="{x:Bind services:Loc.Get('Inventory_Subtitle')}" Style="{StaticResource EqSecondaryStyle}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <!-- Import is hidden until a CSV import flow is specified (docs/open-questions.md, Q13). -->
        <Button Style="{StaticResource EqSecondaryButtonStyle}" Content="{x:Bind services:Loc.Get('Inventory_Export')}"
                Command="{x:Bind ViewModel.ExportCommand}"
                Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.CanExport), Mode=OneWay}" />
        <Button Style="{StaticResource EqPrimaryButtonStyle}" Command="{x:Bind ViewModel.AddProductCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE145;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" />
            <TextBlock Text="{x:Bind services:Loc.Get('Inventory_AddProduct')}" VerticalAlignment="Center" />
            <Border BorderBrush="{ThemeResource EqOnGoldBrush}" BorderThickness="1" CornerRadius="{StaticResource EqRadiusSm}" Padding="6,1" Opacity="0.8">
              <TextBlock Text="F2" FontSize="{StaticResource EqFontXs}" />
            </Border>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Result of the last export -->
    <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.ExportMessage, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}"
               Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.HasExportMessage), Mode=OneWay}" />

    <!-- KPI cards -->
    <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
      <Border Grid.Column="0" Style="{StaticResource EqCardStyle}" Padding="16,14">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Width="44" Height="44" CornerRadius="{StaticResource EqRadiusLg}" Background="{ThemeResource EqSurfaceElevatedBrush}" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE1A1;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont4xl}" Foreground="{ThemeResource EqTextSecondaryBrush}" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind services:Loc.Get('Inventory_KpiProducts')}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind ViewModel.TotalProductsText, Mode=OneWay}" Style="{StaticResource EqKpiStyle}" FontSize="26" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource EqCardStyle}" Padding="16,14">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Width="44" Height="44" CornerRadius="{StaticResource EqRadiusLg}" Background="{ThemeResource EqSurfaceElevatedBrush}" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE53B;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont4xl}" Foreground="{ThemeResource EqGoldInkBrush}" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind services:Loc.Get('Inventory_KpiVariants')}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind ViewModel.TotalVariantsText, Mode=OneWay}" Style="{StaticResource EqKpiStyle}" FontSize="26" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource EqCardStyle}" Padding="16,14">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Width="44" Height="44" CornerRadius="{StaticResource EqRadiusLg}" Background="{ThemeResource EqSurfaceElevatedBrush}" VerticalAlignment="Center">
            <FontIcon Glyph="&#xF720;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont4xl}" Foreground="{ThemeResource EqSuccessBrush}" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind services:Loc.Get('Inventory_KpiInStock')}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind ViewModel.InStockText, Mode=OneWay}" Style="{StaticResource EqKpiStyle}" FontSize="26" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="3" Style="{StaticResource EqCardStyle}" Padding="16,14">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Width="44" Height="44" CornerRadius="{StaticResource EqRadiusLg}" Background="{ThemeResource EqSurfaceElevatedBrush}" VerticalAlignment="Center">
            <FontIcon Glyph="&#xF083;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont4xl}" Foreground="{ThemeResource EqWarningBrush}" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind services:Loc.Get('Inventory_KpiLow')}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind ViewModel.LowStockText, Mode=OneWay}" Style="{StaticResource EqKpiStyle}" FontSize="26" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="4" Style="{StaticResource EqCardStyle}" Padding="16,14">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Width="44" Height="44" CornerRadius="{StaticResource EqRadiusLg}" Background="{ThemeResource EqSurfaceElevatedBrush}" VerticalAlignment="Center">
            <FontIcon Glyph="&#xF8B6;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont4xl}" Foreground="{ThemeResource EqDangerBrush}" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind services:Loc.Get('Inventory_KpiOut')}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind ViewModel.OutOfStockText, Mode=OneWay}" Style="{StaticResource EqKpiStyle}" FontSize="26" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Table column and the detail panel -->
    <Grid Grid.Row="3" ColumnDefinitions="*,380" ColumnSpacing="16">

      <!-- Tabs, filters, table, pages -->
      <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="12" MinWidth="0">

        <Border Grid.Row="0" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <RadioButton GroupName="InventoryTabs" Style="{StaticResource InvTabStyle}" Content="{x:Bind services:Loc.Get('Inventory_TabAll')}"
                         IsChecked="{x:Bind ViewModel.IsAllTab, Mode=TwoWay}" />
            <RadioButton GroupName="InventoryTabs" Style="{StaticResource InvTabStyle}" Content="{x:Bind services:Loc.Get('Inventory_TabLow')}"
                         IsChecked="{x:Bind ViewModel.IsLowTab, Mode=TwoWay}" />
            <RadioButton GroupName="InventoryTabs" Style="{StaticResource InvTabStyle}" Content="{x:Bind services:Loc.Get('Inventory_TabOut')}"
                         IsChecked="{x:Bind ViewModel.IsOutTab, Mode=TwoWay}" />
          </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,1.2*,Auto" ColumnSpacing="8">
          <Button Grid.Column="0" Style="{StaticResource InvFilterButtonStyle}"
                  Click="OnCategoryClick" AutomationProperties.Name="{x:Bind services:Loc.Get('Inventory_FilterCategory')}"
                  ToolTipService.ToolTip="{x:Bind services:Loc.Get('Inventory_FilterCategory')}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{x:Bind ViewModel.CategoryLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <FontIcon Grid.Column="1" Glyph="&#xE313;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Grid.Column="1" Style="{StaticResource InvFilterButtonStyle}"
                  Click="OnBrandClick" AutomationProperties.Name="{x:Bind services:Loc.Get('Inventory_FilterBrand')}"
                  ToolTipService.ToolTip="{x:Bind services:Loc.Get('Inventory_FilterBrand')}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{x:Bind ViewModel.BrandLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <FontIcon Grid.Column="1" Glyph="&#xE313;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Grid.Column="2" Style="{StaticResource InvFilterButtonStyle}"
                  Click="OnStatusClick" AutomationProperties.Name="{x:Bind services:Loc.Get('Inventory_FilterStatus')}"
                  ToolTipService.ToolTip="{x:Bind services:Loc.Get('Inventory_FilterStatus')}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{x:Bind ViewModel.StatusLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <FontIcon Grid.Column="1" Glyph="&#xE313;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Grid.Column="3" Style="{StaticResource InvFilterButtonStyle}"
                  Click="OnSortClick" AutomationProperties.Name="{x:Bind services:Loc.Get('Inventory_SortBy')}"
                  ToolTipService.ToolTip="{x:Bind services:Loc.Get('Inventory_SortBy')}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{x:Bind ViewModel.SortLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <FontIcon Grid.Column="1" Glyph="&#xE313;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Grid.Column="4" Style="{StaticResource EqSecondaryButtonStyle}" Width="40" MinWidth="0" Padding="0"
                  Command="{x:Bind ViewModel.ToggleSortDirectionCommand}"
                  ToolTipService.ToolTip="{x:Bind ViewModel.SortDirectionToolTip, Mode=OneWay}"
                  AutomationProperties.Name="{x:Bind ViewModel.SortDirectionToolTip, Mode=OneWay}">
            <FontIcon Glyph="{x:Bind ViewModel.SortDirectionGlyph, Mode=OneWay}" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" />
          </Button>
        </Grid>

        <!-- Table card -->
        <Border Grid.Row="2" Style="{StaticResource EqCardStyle}" Padding="16">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">

            <Grid Grid.Row="0" Style="{StaticResource EqTableHeaderStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="140" />
                <ColumnDefinition Width="116" />
                <ColumnDefinition Width="116" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="132" />
                <ColumnDefinition Width="36" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Inventory_ColProduct')}" Style="{StaticResource EqTableHeaderTextStyle}" />
              <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Inventory_ColCategory')}" Style="{StaticResource EqTableHeaderTextStyle}" />
              <TextBlock Grid.Column="2" Text="{x:Bind services:Loc.Get('Inventory_ColBrand')}" Style="{StaticResource EqTableHeaderTextStyle}" />
              <TextBlock Grid.Column="3" Text="{x:Bind services:Loc.Get('Inventory_ColVariants')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="4" Text="{x:Bind services:Loc.Get('Inventory_ColStock')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="5" Text="{x:Bind services:Loc.Get('Inventory_ColStatus')}" Style="{StaticResource EqTableHeaderTextStyle}" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
              <Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InventoryRowViewModel">
                      <Grid MinHeight="64" Background="Transparent" Style="{StaticResource EqTableRowStyle}" Tapped="OnRowTapped">
                        <Border Style="{StaticResource EqTableBandStyle}"
                                Visibility="{x:Bind local:InventoryBindings.Visible(IsAlternateRow)}" />
                        <Border Background="{ThemeResource EqGoldTintBrush}" IsHitTestVisible="False"
                                Visibility="{x:Bind local:InventoryBindings.Visible(IsSelected), Mode=OneWay}" />
                        <Grid Padding="12,8,8,8" ColumnSpacing="8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="140" />
                            <ColumnDefinition Width="116" />
                            <ColumnDefinition Width="116" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="36" />
                          </Grid.ColumnDefinitions>

                          <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <!-- First-letter placeholder until products have pictures. -->
                            <Border Width="40" Height="40" CornerRadius="{StaticResource EqRadiusMd}" Background="{ThemeResource EqGoldTintBrush}"
                                    VerticalAlignment="Center">
                              <TextBlock Text="{x:Bind Initial}" FontFamily="{StaticResource EqBrandFont}" FontSize="{StaticResource EqFontXl}"
                                         Foreground="{ThemeResource EqGoldInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                              <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="15"
                                         Foreground="{ThemeResource EqTextBrush}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{x:Bind Code}" Style="{StaticResource EqSecondaryStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Grid>
                          <TextBlock Grid.Column="1" Text="{x:Bind Category}" Style="{StaticResource EqTableCellStyle}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{x:Bind Brand}" Style="{StaticResource EqTableCellStyle}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="3" Text="{x:Bind VariantsText}" Style="{StaticResource EqTableCellStyle}" HorizontalAlignment="Right" />
                          <TextBlock Grid.Column="4" Text="{x:Bind StockText}" Style="{StaticResource EqTableCellStrongStyle}" />
                          <controls:StatusBadge Grid.Column="5" Kind="{x:Bind StatusKind}" Text="{x:Bind StatusText}" VerticalAlignment="Center" />
                          <Button Grid.Column="6" Style="{StaticResource EqPlainIconButtonStyle}" VerticalAlignment="Center" Click="OnRowMenuClick"
                                  AutomationProperties.Name="{x:Bind services:Loc.Get('Inventory_RowMenu')}"
                                  ToolTipService.ToolTip="{x:Bind services:Loc.Get('Inventory_RowMenu')}">
                            <FontIcon Glyph="&#xE5D4;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont4xl}" />
                          </Button>
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Nothing to list -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Padding="0,40"
                            Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.IsEmpty), Mode=OneWay}">
                  <FontIcon Glyph="&#xE1A1;" FontFamily="{StaticResource EqIconFont}" FontSize="32" Foreground="{ThemeResource EqTextSecondaryBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" TextAlignment="Center" HorizontalAlignment="Center" />
                  <HyperlinkButton Content="{x:Bind services:Loc.Get('Inventory_ClearFilters')}" Style="{StaticResource EqLinkButtonStyle}" HorizontalAlignment="Center"
                                   Command="{x:Bind ViewModel.ClearFiltersCommand}"
                                   Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.HasActiveFilters), Mode=OneWay}" />
                </StackPanel>
              </Grid>
            </ScrollViewer>

            <!-- Pages -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="{x:Bind ViewModel.ShowingText, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" VerticalAlignment="Center"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Style="{StaticResource EqPlainIconButtonStyle}" Command="{x:Bind ViewModel.PreviousPageCommand}"
                        IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind services:Loc.Get('Inventory_PreviousPage')}"
                        ToolTipService.ToolTip="{x:Bind services:Loc.Get('Inventory_PreviousPage')}">
                  <FontIcon Glyph="&#xE5CB;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont4xl}" />
                </Button>
                <ItemsControl ItemsSource="{x:Bind ViewModel.PageItems, Mode=OneWay}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageItemViewModel">
                      <Grid>
                        <Button Style="{StaticResource EqPrimaryButtonStyle}" Width="36" MinWidth="0" Padding="0" Content="{x:Bind Label}"
                                Tag="{x:Bind Page}" Click="OnPageClick"
                                Visibility="{x:Bind local:InventoryBindings.Visible(IsCurrent)}" />
                        <Button Style="{StaticResource EqSecondaryButtonStyle}" Width="36" MinWidth="0" Padding="0" Content="{x:Bind Label}"
                                Tag="{x:Bind Page}" Click="OnPageClick"
                                Visibility="{x:Bind local:InventoryBindings.Visible(IsOtherPage)}" />
                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource EqSecondaryStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" TextAlignment="Center"
                                   Visibility="{x:Bind local:InventoryBindings.Visible(IsGap)}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource EqPlainIconButtonStyle}" Command="{x:Bind ViewModel.NextPageCommand}"
                        IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind services:Loc.Get('Inventory_NextPage')}"
                        ToolTipService.ToolTip="{x:Bind services:Loc.Get('Inventory_NextPage')}">
                  <FontIcon Glyph="&#xE5CC;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont4xl}" />
                </Button>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- Detail panel of the selected product -->
      <Border Grid.Column="1" Style="{StaticResource EqCardStyle}" Padding="20">
        <Grid>
          <TextBlock Text="{x:Bind services:Loc.Get('Inventory_SelectProduct')}" Style="{StaticResource EqSecondaryStyle}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                     Visibility="{x:Bind local:InventoryBindings.Hidden(ViewModel.HasDetail), Mode=OneWay}" />

          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12"
                Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.HasDetail), Mode=OneWay}">

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="16">
              <Border Width="84" Height="84" CornerRadius="{StaticResource EqRadiusLg}" Background="{ThemeResource EqGoldTintBrush}" VerticalAlignment="Top">
                <TextBlock Text="{x:Bind ViewModel.Detail.Initial, Mode=OneWay}" FontFamily="{StaticResource EqBrandFont}" FontSize="32"
                           Foreground="{ThemeResource EqGoldInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Detail.Name, Mode=OneWay}" Style="{StaticResource EqCardTitleStyle}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind ViewModel.Detail.Code, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <controls:StatusBadge Kind="{x:Bind ViewModel.Detail.StatusKind, Mode=OneWay}" Text="{x:Bind ViewModel.Detail.StatusText, Mode=OneWay}" />
                <Button Style="{StaticResource EqSecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,4,0,0"
                        Content="{x:Bind ViewModel.ArchiveText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleArchiveSelectedCommand}"
                        Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.CanArchive), Mode=OneWay}" />
              </StackPanel>
            </Grid>

            <Border Grid.Row="1" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" Spacing="0">
                <RadioButton GroupName="InventoryDetailTabs" Style="{StaticResource InvTabStyle}" Padding="10,9" FontSize="{StaticResource EqFontSm}"
                             Content="{x:Bind services:Loc.Get('Inventory_DetailOverview')}" IsChecked="{x:Bind ViewModel.IsOverviewTab, Mode=TwoWay}" />
                <RadioButton GroupName="InventoryDetailTabs" Style="{StaticResource InvTabStyle}" Padding="10,9" FontSize="{StaticResource EqFontSm}"
                             Content="{x:Bind services:Loc.Get('Inventory_DetailVariants')}" IsChecked="{x:Bind ViewModel.IsVariantsTab, Mode=TwoWay}" />
                <RadioButton GroupName="InventoryDetailTabs" Style="{StaticResource InvTabStyle}" Padding="10,9" FontSize="{StaticResource EqFontSm}"
                             Content="{x:Bind services:Loc.Get('Inventory_DetailStock')}" IsChecked="{x:Bind ViewModel.IsStockTab, Mode=TwoWay}" />
                <RadioButton GroupName="InventoryDetailTabs" Style="{StaticResource InvTabStyle}" Padding="10,9" FontSize="{StaticResource EqFontSm}"
                             Content="{x:Bind services:Loc.Get('Inventory_DetailHistory')}" IsChecked="{x:Bind ViewModel.IsHistoryTab, Mode=TwoWay}" />
              </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
              <Grid>

                <!-- Overview -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Detail.Overview, Mode=OneWay}"
                              Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.IsOverviewTab), Mode=OneWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetailLine">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,9">
                        <Rectangle Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Fill="{ThemeResource EqBorderBrush}"
                                   Visibility="{x:Bind local:InventoryBindings.Visible(ShowDivider)}" />
                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource EqSecondaryStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontMd}"
                                   Foreground="{ThemeResource EqTextBrush}" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="200" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Variants: size and colour, both barcodes, quantity, price -->
                <Grid RowDefinitions="Auto,*" RowSpacing="8"
                      Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.IsVariantsTab), Mode=OneWay}">
                  <Grid Grid.Row="0" Style="{StaticResource EqTableHeaderStyle}" Padding="12,0,8,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="48" />
                      <ColumnDefinition Width="76" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Inventory_ColVariant')}" Style="{StaticResource EqTableHeaderTextStyle}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Inventory_ColQty')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="{x:Bind services:Loc.Get('Inventory_ColPrice')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
                  </Grid>
                  <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.Detail.Variants, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:VariantRowViewModel">
                        <Grid MinHeight="60" Style="{StaticResource EqTableRowStyle}">
                          <Border Style="{StaticResource EqTableBandStyle}" Visibility="{x:Bind local:InventoryBindings.Visible(IsAlternateRow)}" />
                          <Grid Padding="12,8,8,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="48" />
                              <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                              <TextBlock Text="{x:Bind Title}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontMd}"
                                         Foreground="{ThemeResource EqTextBrush}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{x:Bind Sku}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{x:Bind Barcode}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis"
                                         Visibility="{x:Bind local:InventoryBindings.Visible(HasBarcode)}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind QuantityText}" Style="{StaticResource EqTableCellStrongStyle}" FontSize="{StaticResource EqFontMd}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind PriceText}" Style="{StaticResource EqTableCellStyle}" FontSize="{StaticResource EqFontMd}"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>

                <!-- Stock: level of each variant -->
                <Grid RowDefinitions="Auto,*" RowSpacing="8"
                      Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.IsStockTab), Mode=OneWay}">
                  <Grid Grid.Row="0" Style="{StaticResource EqTableHeaderStyle}" Padding="12,0,8,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="48" />
                      <ColumnDefinition Width="132" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Inventory_ColVariant')}" Style="{StaticResource EqTableHeaderTextStyle}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Inventory_ColQty')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="{x:Bind services:Loc.Get('Inventory_ColStatus')}" Style="{StaticResource EqTableHeaderTextStyle}" />
                  </Grid>
                  <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.Detail.Variants, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:VariantRowViewModel">
                        <Grid MinHeight="52" Style="{StaticResource EqTableRowStyle}">
                          <Border Style="{StaticResource EqTableBandStyle}" Visibility="{x:Bind local:InventoryBindings.Visible(IsAlternateRow)}" />
                          <Grid Padding="12,8,8,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="48" />
                              <ColumnDefinition Width="132" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                              <TextBlock Text="{x:Bind Title}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontMd}"
                                         Foreground="{ThemeResource EqTextBrush}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{x:Bind Sku}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind QuantityText}" Style="{StaticResource EqTableCellStrongStyle}" FontSize="{StaticResource EqFontMd}" />
                            <controls:StatusBadge Grid.Column="2" Kind="{x:Bind StatusKind}" Text="{x:Bind StatusText}" VerticalAlignment="Center" />
                          </Grid>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>

                <!-- History: stock movements, newest first -->
                <Grid RowDefinitions="Auto,*" RowSpacing="8"
                      Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.IsHistoryTab), Mode=OneWay}">
                  <Grid Grid.Row="0" Style="{StaticResource EqTableHeaderStyle}" Padding="12,0,8,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Inventory_ColMovement')}" Style="{StaticResource EqTableHeaderTextStyle}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Inventory_ColQty')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
                  </Grid>
                  <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.Detail.History, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MovementRowViewModel">
                        <Grid MinHeight="56" Style="{StaticResource EqTableRowStyle}">
                          <Border Style="{StaticResource EqTableBandStyle}" Visibility="{x:Bind local:InventoryBindings.Visible(IsAlternateRow)}" />
                          <Grid Padding="12,8,8,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                              <TextBlock Text="{x:Bind TypeText}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontMd}"
                                         Foreground="{ThemeResource EqTextBrush}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{x:Bind WhenText}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{x:Bind Location}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind QuantityText}" Style="{StaticResource EqTableCellStrongStyle}" FontSize="{StaticResource EqFontMd}" />
                          </Grid>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>

              </Grid>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
