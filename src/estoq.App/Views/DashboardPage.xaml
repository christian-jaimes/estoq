<Page
    x:Class="Estoq.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Estoq.App.Controls"
    xmlns:services="using:Estoq.App.Services"
    xmlns:local="using:Estoq.App.Views"
    xmlns:vm="using:Estoq.App.ViewModels"
    xmlns:posvm="using:Estoq.App.ViewModels.PointOfSale"
    Foreground="{ThemeResource EqTextBrush}">

  <Page.Resources>
    <!-- Choice chip (range, daily/weekly): the same pill as the till's currency chips; the selected one is gold. -->
    <Style x:Key="DashChipButtonStyle" TargetType="Button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EqGoldInkBrush}" />
      <Setter Property="FocusVisualPrimaryThickness" Value="2" />
      <Setter Property="FocusVisualMargin" Value="-3" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Chip.Background" Value="{ThemeResource EqHoverFillBrush}" />
                      <Setter Target="Chip.BorderBrush" Value="{ThemeResource EqGoldBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Chip.Background" Value="{ThemeResource EqHoverFillBrush}" />
                      <Setter Target="Chip.BorderBrush" Value="{ThemeResource EqGoldBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border x:Name="Chip" Background="{ThemeResource EqSurfaceElevatedBrush}" BorderBrush="{ThemeResource EqBorderBrush}"
                      BorderThickness="1" CornerRadius="18" />
              <ContentPresenter CornerRadius="18" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="ChipTemplate" x:DataType="posvm:CurrencyChipViewModel">
      <Button Style="{StaticResource DashChipButtonStyle}" Command="{x:Bind SelectCommand}" AutomationProperties.Name="{x:Bind Label}">
        <Grid Height="{StaticResource EqControlHeight}" MinWidth="72" CornerRadius="18">
          <Border Background="{ThemeResource EqGoldBrush}" CornerRadius="18" Visibility="{x:Bind local:DashboardBindings.Visible(IsSelected), Mode=OneWay}" />
          <TextBlock Text="{x:Bind Label}" Style="{StaticResource EqLabelStyle}" Margin="16,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{ThemeResource EqTextBrush}" Visibility="{x:Bind local:DashboardBindings.Hidden(IsSelected), Mode=OneWay}" />
          <TextBlock Text="{x:Bind Label}" Style="{StaticResource EqLabelStyle}" Margin="16,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{ThemeResource EqOnGoldBrush}" Visibility="{x:Bind local:DashboardBindings.Visible(IsSelected), Mode=OneWay}" />
        </Grid>
      </Button>
    </DataTemplate>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid RowSpacing="16" Padding="0,0,12,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Title, subtitle with the period, range chips and Export report. -->
      <StackPanel Grid.Row="0" Spacing="12">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="2">
            <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource EqPageTitleStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                      Visibility="{x:Bind local:DashboardBindings.Visible(ViewModel.CanExport), Mode=OneWay}">
            <TextBlock Text="{x:Bind ViewModel.ExportStatus, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" VerticalAlignment="Center" />
            <Button Style="{StaticResource EqSecondaryButtonStyle}" Command="{x:Bind ViewModel.ExportCommand}"
                    Content="{x:Bind services:Loc.Get('Dash_Export')}" />
          </StackPanel>
        </Grid>
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Ranges, Mode=OneWay}" ItemTemplate="{StaticResource ChipTemplate}">
          <ItemsRepeater.Layout>
            <StackLayout Orientation="Horizontal" Spacing="8" />
          </ItemsRepeater.Layout>
        </ItemsRepeater>
      </StackPanel>

      <!-- KPI cards: icon, label, value, change against the previous period. They wrap when the window is narrow. -->
      <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind ViewModel.Kpis, Mode=OneWay}">
        <ItemsRepeater.Layout>
          <UniformGridLayout MinItemWidth="210" MinRowSpacing="16" MinColumnSpacing="16" ItemsStretch="Fill" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="vm:DashboardKpi">
            <Border Style="{StaticResource EqCardStyle}" Padding="16,14">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="1" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource EqIconStyle}" FontSize="28" Foreground="{ThemeResource EqGoldInkBrush}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{ThemeResource EqBorderBrush}" />
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Label}" Style="{StaticResource EqSecondaryStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{x:Bind Value}" Style="{StaticResource EqKpiStyle}" FontSize="24" TextTrimming="CharacterEllipsis"
                             ToolTipService.ToolTip="{x:Bind Value}" />
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="{x:Bind ChangeGlyph}" Style="{StaticResource EqIconStyle}" FontSize="16" VerticalAlignment="Center"
                              Foreground="{x:Bind local:DashboardBindings.ToneBrush(Tone)}" />
                    <TextBlock Text="{x:Bind Change}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{x:Bind local:DashboardBindings.ToneBrush(Tone)}" Visibility="{x:Bind local:DashboardBindings.WhenTone(Tone, 1)}" />
                    <TextBlock Text="{x:Bind Change}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{x:Bind local:DashboardBindings.ToneBrush(Tone)}" Visibility="{x:Bind local:DashboardBindings.WhenTone(Tone, -1)}" />
                    <TextBlock Text="{x:Bind Change}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Visibility="{x:Bind local:DashboardBindings.WhenTone(Tone, 0)}" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>

      <!-- Sales over time and sales by payment method (manager and owner). -->
      <Grid Grid.Row="2" ColumnSpacing="16" Visibility="{x:Bind local:DashboardBindings.Visible(ViewModel.ShowCharts), Mode=OneWay}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" MinWidth="360" />
          <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource EqCardStyle}">
          <Grid RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="280" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind services:Loc.Get('Dash_SalesOverTime')}" Style="{StaticResource EqCardTitleStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind ViewModel.Granularities, Mode=OneWay}" ItemTemplate="{StaticResource ChipTemplate}">
                <ItemsRepeater.Layout>
                  <StackLayout Orientation="Horizontal" Spacing="8" />
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </Grid>
            <Grid Grid.Row="1">
              <controls:AreaChart x:Name="SalesChart" Points="{x:Bind ViewModel.SalesSeries, Mode=OneWay}"
                                  Visibility="{x:Bind local:DashboardBindings.Visible(ViewModel.HasSalesSeries), Mode=OneWay}" />
              <TextBlock Text="{x:Bind services:Loc.Get('Dash_EmptySales')}" Style="{StaticResource EqSecondaryStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center" Visibility="{x:Bind local:DashboardBindings.Hidden(ViewModel.HasSalesSeries), Mode=OneWay}" />
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource EqCardStyle}">
          <Grid RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Bind services:Loc.Get('Dash_SalesByPayment')}" Style="{StaticResource EqCardTitleStyle}" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Row="1" Spacing="16" Visibility="{x:Bind local:DashboardBindings.Visible(ViewModel.HasPayments), Mode=OneWay}">
              <controls:DonutChart Width="172" Height="172" Slices="{x:Bind ViewModel.PaymentSlices, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0" MaxWidth="110">
                  <TextBlock Text="{x:Bind services:Loc.Get('Dash_Total')}" Style="{StaticResource EqCaptionStyle}" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Bind ViewModel.PaymentTotal, Mode=OneWay}" Style="{StaticResource EqLabelStyle}" HorizontalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </controls:DonutChart>
              <ItemsRepeater ItemsSource="{x:Bind ViewModel.Payments, Mode=OneWay}">
                <ItemsRepeater.Layout>
                  <StackLayout Orientation="Vertical" Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate x:DataType="vm:PaymentRow">
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" MinWidth="88" />
                      </Grid.ColumnDefinitions>
                      <controls:ChartSwatch ColorIndex="{x:Bind ColorIndex}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{x:Bind Label}" Style="{StaticResource EqTableCellStyle}" FontSize="14" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{x:Bind Share}" Style="{StaticResource EqSecondaryStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                      <TextBlock Grid.Column="3" Text="{x:Bind Amount}" Style="{StaticResource EqTableCellStrongStyle}" FontSize="14" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{x:Bind services:Loc.Get('Dash_EmptyPayments')}" Style="{StaticResource EqSecondaryStyle}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextAlignment="Center" Visibility="{x:Bind local:DashboardBindings.Hidden(ViewModel.HasPayments), Mode=OneWay}" />
          </Grid>
        </Border>
      </Grid>

      <!-- Top sellers, sales by category (manager and owner) and low stock (everyone). -->
      <Grid Grid.Row="3" ColumnSpacing="16" x:Name="ListsGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.2*" MinWidth="320" />
          <ColumnDefinition Width="*" MinWidth="280" />
          <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <Border x:Name="TopCard" Style="{StaticResource EqCardStyle}" Visibility="{x:Bind local:DashboardBindings.Visible(ViewModel.ShowCharts), Mode=OneWay}">
          <Grid RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Bind services:Loc.Get('Dash_TopProducts')}" Style="{StaticResource EqCardTitleStyle}" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Row="1" Visibility="{x:Bind local:DashboardBindings.Visible(ViewModel.HasTopProducts), Mode=OneWay}">
              <Grid Style="{StaticResource EqTableHeaderStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="56" />
                  <ColumnDefinition Width="Auto" MinWidth="84" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" Style="{StaticResource EqTableHeaderTextStyle}" />
                <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Dash_ColProduct')}" Style="{StaticResource EqTableHeaderTextStyle}" />
                <TextBlock Grid.Column="2" Text="{x:Bind services:Loc.Get('Dash_ColUnits')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" TextAlignment="Right" />
                <TextBlock Grid.Column="3" Text="{x:Bind services:Loc.Get('Dash_ColSales')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" TextAlignment="Right" />
              </Grid>
              <ItemsControl ItemsSource="{x:Bind ViewModel.TopProducts, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TopProductRow">
                    <Grid MinHeight="56" Style="{StaticResource EqTableRowStyle}">
                      <Border Style="{StaticResource EqTableBandStyle}" Visibility="{x:Bind local:DashboardBindings.Visible(IsAlternateRow)}" />
                      <Grid Padding="12,8,8,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="24" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="56" />
                          <ColumnDefinition Width="Auto" MinWidth="84" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Rank}" Style="{StaticResource EqTableCellStyle}" Foreground="{ThemeResource EqGoldInkBrush}" />
                        <Grid Grid.Column="1" ColumnSpacing="10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <!-- The sample tables hold no product pictures; the tile keeps the place the picture takes in the visual reference. -->
                          <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource EqSurfaceElevatedBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE1A1;" Style="{StaticResource EqIconStyle}" FontSize="20" Foreground="{ThemeResource EqTextSecondaryBrush}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource EqTableCellStyle}" FontSize="14" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind Name}" />
                            <TextBlock Text="{x:Bind Sku}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                        <TextBlock Grid.Column="2" Text="{x:Bind Units}" Style="{StaticResource EqTableCellStrongStyle}" FontSize="14" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Sales}" Style="{StaticResource EqTableCellStrongStyle}" FontSize="14" />
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{x:Bind services:Loc.Get('Dash_EmptyTop')}" Style="{StaticResource EqSecondaryStyle}" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,24" Visibility="{x:Bind local:DashboardBindings.Hidden(ViewModel.HasTopProducts), Mode=OneWay}" />
          </Grid>
        </Border>

        <Border x:Name="CategoryCard" Grid.Column="1" Style="{StaticResource EqCardStyle}" Visibility="{x:Bind local:DashboardBindings.Visible(ViewModel.ShowCharts), Mode=OneWay}">
          <Grid RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Bind services:Loc.Get('Dash_SalesByCategory')}" Style="{StaticResource EqCardTitleStyle}" TextTrimming="CharacterEllipsis" />
            <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}" Visibility="{x:Bind local:DashboardBindings.Visible(ViewModel.HasCategories), Mode=OneWay}">
              <ItemsRepeater.Layout>
                <StackLayout Orientation="Vertical" Spacing="14" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:CategoryRow">
                  <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" MinWidth="88" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Bind Label}" Style="{StaticResource EqTableCellStyle}" FontSize="14" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{x:Bind Share}" Style="{StaticResource EqSecondaryStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                      <TextBlock Grid.Column="2" Text="{x:Bind Amount}" Style="{StaticResource EqTableCellStrongStyle}" FontSize="14" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <controls:ShareBar Fraction="{x:Bind Fraction}" ColorIndex="{x:Bind ColorIndex}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <TextBlock Grid.Row="1" Text="{x:Bind services:Loc.Get('Dash_EmptyCategories')}" Style="{StaticResource EqSecondaryStyle}" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,24" Visibility="{x:Bind local:DashboardBindings.Hidden(ViewModel.HasCategories), Mode=OneWay}" />
          </Grid>
        </Border>

        <Border x:Name="LowStockCard" Grid.Column="2" Style="{StaticResource EqCardStyle}">
          <Grid RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind services:Loc.Get('Dash_LowStockTitle')}" Style="{StaticResource EqCardTitleStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind ViewModel.LowStockCount, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" />
              </StackPanel>
              <HyperlinkButton Grid.Column="1" Style="{StaticResource EqLinkButtonStyle}" Command="{x:Bind ViewModel.OpenInventoryCommand}" VerticalAlignment="Top"
                               Content="{x:Bind services:Loc.Get('Dash_ViewAll')}" />
            </Grid>
            <StackPanel Grid.Row="1" Visibility="{x:Bind local:DashboardBindings.Visible(ViewModel.HasLowStock), Mode=OneWay}">
              <Grid Style="{StaticResource EqTableHeaderStyle}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" MinWidth="72" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Dash_ColProduct')}" Style="{StaticResource EqTableHeaderTextStyle}" />
                <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Dash_ColStock')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" TextAlignment="Right" />
              </Grid>
              <ItemsControl ItemsSource="{x:Bind ViewModel.LowStockItems, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LowStockRow">
                    <Grid MinHeight="56" Style="{StaticResource EqTableRowStyle}">
                      <Border Style="{StaticResource EqTableBandStyle}" Visibility="{x:Bind local:DashboardBindings.Visible(IsAlternateRow)}" />
                      <Grid Padding="12,8,8,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" MinWidth="72" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{x:Bind Name}" Style="{StaticResource EqTableCellStyle}" FontSize="14" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                          <TextBlock Text="{x:Bind Sku}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <!-- Danger fill with white words for the scarcest items, warning fill with dark words for the rest; the words say it too. -->
                        <Border Grid.Column="1" Style="{StaticResource EqBadgeStyle}" Background="{x:Bind local:DashboardBindings.PillFill(IsCritical)}"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                          <Grid>
                            <TextBlock Text="{x:Bind Left}" Style="{StaticResource EqLabelStyle}" FontSize="13" Foreground="White" TextWrapping="NoWrap"
                                       Visibility="{x:Bind local:DashboardBindings.PillTextWhite(IsCritical)}" />
                            <TextBlock Text="{x:Bind Left}" Style="{StaticResource EqLabelStyle}" FontSize="13" Foreground="{ThemeResource EqOnGoldBrush}" TextWrapping="NoWrap"
                                       Visibility="{x:Bind local:DashboardBindings.PillTextDark(IsCritical)}" />
                          </Grid>
                        </Border>
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{x:Bind services:Loc.Get('Dash_EmptyLowStock')}" Style="{StaticResource EqSecondaryStyle}" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,24" Visibility="{x:Bind local:DashboardBindings.Hidden(ViewModel.HasLowStock), Mode=OneWay}" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</Page>
