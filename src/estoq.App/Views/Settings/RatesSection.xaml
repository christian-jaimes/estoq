<UserControl
    x:Class="Estoq.App.Views.Settings.RatesSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Estoq.App.Controls"
    xmlns:services="using:Estoq.App.Services"
    xmlns:vm="using:Estoq.App.ViewModels.Settings">

  <StackPanel Spacing="16">
    <!-- Update rate: appends a new rate; old rates stay in the history. -->
    <Border Style="{StaticResource EqCardStyle}" Padding="16" Background="{ThemeResource EqSurfaceElevatedBrush}">
      <StackPanel Spacing="12">
        <TextBlock Text="{x:Bind services:Loc.Get('Settings_RatesUpdateTitle')}" Style="{StaticResource EqCardTitleStyle}" FontSize="{StaticResource EqFontXl}" />
        <TextBlock Text="{x:Bind services:Loc.Get('Settings_RatesNever')}" Style="{StaticResource EqSecondaryStyle}" TextWrapping="Wrap" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" MinWidth="0" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="6">
            <TextBlock Text="{x:Bind services:Loc.Get('Settings_RatesCurrency')}" Style="{StaticResource EqLabelStyle}" />
            <Border Style="{StaticResource EqInputContainerStyle}" Padding="4,0">
              <ComboBox HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                        ItemsSource="{x:Bind ViewModel.Editable}" SelectedItem="{x:Bind ViewModel.SelectedCurrency, Mode=TwoWay}"
                        AutomationProperties.Name="{x:Bind services:Loc.Get('Settings_RatesCurrency')}" />
            </Border>
          </StackPanel>
          <controls:EqField Grid.Column="1" Label="{x:Bind ViewModel.RateLabel, Mode=OneWay}" Text="{x:Bind ViewModel.NewRateText, Mode=TwoWay}"
                            ErrorText="{x:Bind ViewModel.Error, Mode=OneWay}" />
          <Button Grid.Column="2" Style="{StaticResource EqPrimaryButtonStyle}" VerticalAlignment="Top" Margin="0,28,0,0" Command="{x:Bind ViewModel.UpdateCommand}"
                  Content="{x:Bind services:Loc.Get('Settings_RatesUpdate')}" />
        </Grid>
        <TextBlock Text="{x:Bind ViewModel.Notice, Mode=OneWay}" Foreground="{ThemeResource EqSuccessBrush}" TextWrapping="Wrap" FontSize="{StaticResource EqFontSm}" />
      </StackPanel>
    </Border>

    <!-- Current rates: one row per currency, the base first. -->
    <Grid RowDefinitions="Auto,Auto">
      <Grid Grid.Row="0" Style="{StaticResource EqTableHeaderStyle}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="140" />
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="190" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Settings_RatesCurrency')}" Style="{StaticResource EqTableHeaderTextStyle}" />
        <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Settings_RatesRate')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="2" Text="{x:Bind services:Loc.Get('Settings_RatesUpdated')}" Style="{StaticResource EqTableHeaderTextStyle}" />
        <TextBlock Grid.Column="3" Text="{x:Bind services:Loc.Get('Settings_RatesBy')}" Style="{StaticResource EqTableHeaderTextStyle}" />
        <TextBlock Grid.Column="4" Text="{x:Bind services:Loc.Get('Settings_StaffActions')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
      </Grid>
      <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}">
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="vm:RateRowViewModel">
            <Grid Style="{StaticResource EqTableRowStyle}">
              <Border Style="{StaticResource EqTableBandStyle}" Visibility="{x:Bind IsAlternateRow}" />
              <Grid MinHeight="56" Padding="12,7,8,7" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MinWidth="140" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Code}" Style="{StaticResource EqTableCellStrongStyle}" TextAlignment="Left" />
                  <TextBlock Text="{x:Bind Name}" Style="{StaticResource EqSecondaryStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind RateText}" Style="{StaticResource EqTableCellStrongStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="{x:Bind UpdatedText}" Style="{StaticResource EqTableCellStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Grid.Column="3" Text="{x:Bind ByText}" Style="{StaticResource EqTableCellStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{x:Bind IsNotBase}">
                  <Button Style="{StaticResource EqSecondaryButtonStyle}" MinWidth="0" Padding="12,0" DataContext="{x:Bind}" Click="OnUpdateClick"
                          Content="{x:Bind services:Loc.Get('Settings_RatesUpdate')}" />
                  <Button Style="{StaticResource EqSecondaryButtonStyle}" MinWidth="0" Padding="12,0" DataContext="{x:Bind}" Click="OnHistoryClick"
                          Content="{x:Bind services:Loc.Get('Settings_RatesHistory')}" />
                </StackPanel>
              </Grid>
            </Grid>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </Grid>

    <!-- History of the chosen currency, newest first. -->
    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay}">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="0" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind ViewModel.HistoryTitle, Mode=OneWay}" Style="{StaticResource EqCardTitleStyle}" FontSize="{StaticResource EqFontXl}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Style="{StaticResource EqPlainIconButtonStyle}" Command="{x:Bind ViewModel.CloseHistoryCommand}"
                AutomationProperties.Name="{x:Bind services:Loc.Get('Popup_Close')}" ToolTipService.ToolTip="{x:Bind services:Loc.Get('Popup_Close')}">
          <FontIcon Glyph="&#xE5CD;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont2xl}" />
        </Button>
      </Grid>
      <Grid Style="{StaticResource EqTableHeaderStyle}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="*" MinWidth="120" />
          <ColumnDefinition Width="*" MinWidth="100" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Settings_RatesRate')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Settings_RatesEffective')}" Style="{StaticResource EqTableHeaderTextStyle}" />
        <TextBlock Grid.Column="2" Text="{x:Bind services:Loc.Get('Settings_RatesBy')}" Style="{StaticResource EqTableHeaderTextStyle}" />
      </Grid>
      <ItemsRepeater ItemsSource="{x:Bind ViewModel.History}">
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="vm:RateHistoryRowViewModel">
            <Grid Style="{StaticResource EqTableRowStyle}">
              <Border Style="{StaticResource EqTableBandStyle}" Visibility="{x:Bind IsAlternateRow}" />
              <Grid MinHeight="44" Padding="12,6,8,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="*" MinWidth="120" />
                  <ColumnDefinition Width="*" MinWidth="100" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind RateText}" Style="{StaticResource EqTableCellStrongStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="1" Text="{x:Bind EffectiveText}" Style="{StaticResource EqTableCellStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Grid.Column="2" Text="{x:Bind By}" Style="{StaticResource EqTableCellStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Grid>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </StackPanel>
  </StackPanel>
</UserControl>
