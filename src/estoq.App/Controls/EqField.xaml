<UserControl
    x:Class="Estoq.App.Controls.EqField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Estoq.App.Services">

  <!-- Labelled input (design system, Input): label, optional or required mark, 36 px field, error text.
       The inner TextBox and PasswordBox are borderless; the container draws the border and the focus and error states. -->
  <StackPanel Spacing="6">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="FocusStates">
        <VisualState x:Name="Unfocused" />
        <VisualState x:Name="Focused">
          <VisualState.Setters>
            <Setter Target="Box.BorderBrush" Value="{ThemeResource EqGoldBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="ValidationStates">
        <VisualState x:Name="Valid" />
        <VisualState x:Name="Invalid">
          <VisualState.Setters>
            <Setter Target="Box.BorderBrush" Value="{ThemeResource EqDangerBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <StackPanel Orientation="Horizontal" Spacing="4">
      <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource EqLabelStyle}"
                 Foreground="{ThemeResource EqTextBrush}" />
      <TextBlock x:Name="RequiredMark" Text="*" Style="{StaticResource EqLabelStyle}"
                 Foreground="{ThemeResource EqGoldInkBrush}" Visibility="Collapsed" />
      <TextBlock x:Name="OptionalMark" Text="{x:Bind services:Loc.Get('Label_Optional')}"
                 Style="{StaticResource EqSecondaryStyle}" VerticalAlignment="Center" Visibility="Collapsed" />
    </StackPanel>

    <Border x:Name="Box" Style="{StaticResource EqInputContainerStyle}">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.Resources>
          <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
          <SolidColorBrush x:Key="PasswordBoxBackground" Color="Transparent" />
          <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
          <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
        </Grid.Resources>

        <TextBox x:Name="Input" Grid.Column="0" VerticalAlignment="Center"
                 PlaceholderText="{x:Bind PlaceholderText, Mode=OneWay}"
                 Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Background="Transparent" BorderThickness="0" MinHeight="0" Padding="0,6"
                 FontFamily="{StaticResource EqUiFont}" FontSize="14"
                 AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                 GotFocus="OnInputGotFocus" LostFocus="OnInputLostFocus" />
        <PasswordBox x:Name="SecretInput" Grid.Column="0" VerticalAlignment="Center" Visibility="Collapsed"
                     Password="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent" BorderThickness="0" MinHeight="0" Padding="0,6"
                     FontFamily="{StaticResource EqUiFont}" FontSize="14"
                     AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                     GotFocus="OnInputGotFocus" LostFocus="OnInputLostFocus" />
        <TextBlock x:Name="SuffixText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource EqSecondaryStyle}"
                   Visibility="Collapsed" />
      </Grid>
    </Border>

    <TextBlock x:Name="ErrorBlock" Text="{x:Bind ErrorText, Mode=OneWay}" FontSize="12"
               Foreground="{ThemeResource EqDangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
  </StackPanel>
</UserControl>
