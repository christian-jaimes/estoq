<Page
    x:Class="Estoq.App.Views.Sales.SalesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Estoq.App.Views.Sales"
    xmlns:vm="using:Estoq.App.ViewModels.Sales"
    xmlns:services="using:Estoq.App.Services"
    Foreground="{ThemeResource EqTextBrush}">

  <Page.Resources>
    <ResourceDictionary>
    <!-- Period tab (docs/features/sales.md): text with a gold tint and 2 px gold underline when selected. -->
    <Style x:Key="SalesTabStyle" TargetType="RadioButton">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Foreground" Value="{ThemeResource EqTextSecondaryBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource EqUiFontSemiBold}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EqGoldInkBrush}" />
      <Setter Property="FocusVisualPrimaryThickness" Value="2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid x:Name="Root" Height="40" Background="Transparent" CornerRadius="8,8,0,0">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Root.Background" Value="{ThemeResource EqSurfaceElevatedBrush}" />
                      <Setter Target="Presenter.Foreground" Value="{ThemeResource EqTextBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Root.Background" Value="{ThemeResource EqSurfaceElevatedBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                  <VisualState x:Name="Unchecked" />
                  <VisualState x:Name="Indeterminate" />
                  <VisualState x:Name="Checked">
                    <VisualState.Setters>
                      <Setter Target="Root.Background" Value="{ThemeResource EqGoldTintBrush}" />
                      <Setter Target="Presenter.Foreground" Value="{ThemeResource EqGoldInkBrush}" />
                      <Setter Target="Underline.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <ContentPresenter x:Name="Presenter" Padding="{TemplateBinding Padding}" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
              <Rectangle x:Name="Underline" Visibility="Collapsed" Height="2" VerticalAlignment="Bottom"
                         Fill="{ThemeResource EqGoldBrush}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Table header cell and row text. -->
    <Style x:Key="SalesHeaderCellStyle" TargetType="TextBlock" BasedOn="{StaticResource EqLabelStyle}">
      <Setter Property="Foreground" Value="{ThemeResource EqTextSecondaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SalesRowStyle" TargetType="ListViewItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- Selected and hovered rows take the gold tint and surface tokens instead of the system accent. -->
    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
    <ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary x:Key="Light">
        <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="EqGoldTintBrush" />
        <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="EqGoldTintBrush" />
        <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="EqGoldTintBrush" />
        <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="EqSurfaceElevatedBrush" />
        <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="EqSurfaceElevatedBrush" />
      </ResourceDictionary>
      <ResourceDictionary x:Key="Dark">
        <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="EqGoldTintBrush" />
        <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="EqGoldTintBrush" />
        <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="EqGoldTintBrush" />
        <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="EqSurfaceElevatedBrush" />
        <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="EqSurfaceElevatedBrush" />
      </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Borderless text box inside the search container (same overrides as EqField). -->
    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>

    <Style x:Key="SalesComboStyle" TargetType="ComboBox">
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="{StaticResource EqRadiusMd}" />
      <Setter Property="Background" Value="{ThemeResource EqSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource EqBorderBrush}" />
      <Setter Property="Padding" Value="12,0,0,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    </ResourceDictionary>
  </Page.Resources>

  <Grid ColumnDefinitions="*,360" ColumnSpacing="24">

    <!-- Left column: header, KPIs, tabs, filters, table. -->
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

      <!-- Title and actions. -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,0,0,20">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{x:Bind services:Loc.Get('Sales_Title')}" Style="{StaticResource EqPageTitleStyle}" />
          <TextBlock Text="{x:Bind services:Loc.Get('Sales_Subtitle')}" Style="{StaticResource EqSecondaryStyle}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <!-- Date range: editing either date switches the period to Custom. -->
          <Button Style="{StaticResource EqSecondaryButtonStyle}" AutomationProperties.Name="{x:Bind services:Loc.Get('Sales_DateRange')}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE935;" Style="{StaticResource EqIconStyle}" FontSize="18" />
              <TextBlock Text="{x:Bind ViewModel.DateRangeText, Mode=OneWay}" VerticalAlignment="Center" />
              <FontIcon Glyph="&#xE313;" Style="{StaticResource EqIconStyle}" FontSize="18" />
            </StackPanel>
            <Button.Flyout>
              <Flyout>
                <StackPanel Spacing="12" MinWidth="240">
                  <CalendarDatePicker Header="{x:Bind services:Loc.Get('Sales_From')}" HorizontalAlignment="Stretch"
                                      Date="{x:Bind ViewModel.CustomFromDate, Mode=TwoWay}" />
                  <CalendarDatePicker Header="{x:Bind services:Loc.Get('Sales_To')}" HorizontalAlignment="Stretch"
                                      Date="{x:Bind ViewModel.CustomToDate, Mode=TwoWay}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <Button Style="{StaticResource EqSecondaryButtonStyle}" Command="{x:Bind ViewModel.ExportCommand}"
                  Visibility="{x:Bind local:SalesBindings.Visible(ViewModel.CanExport)}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE5D8;" Style="{StaticResource EqIconStyle}" FontSize="18" />
              <TextBlock Text="{x:Bind services:Loc.Get('Sales_Export')}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Style="{StaticResource EqSecondaryButtonStyle}" Command="{x:Bind ViewModel.PrintReportCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xEF6E;" Style="{StaticResource EqIconStyle}" FontSize="18" />
              <TextBlock Text="{x:Bind services:Loc.Get('Sales_PrintReport')}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- The one gold primary of the page. F1 is handled by the shell. -->
          <Button Style="{StaticResource EqPrimaryButtonStyle}" Command="{x:Bind ViewModel.NewSaleCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE145;" Style="{StaticResource EqIconStyle}" FontSize="18" />
              <TextBlock Text="{x:Bind services:Loc.Get('Sales_NewSale')}" VerticalAlignment="Center" />
              <Border CornerRadius="{StaticResource EqRadiusSm}" Padding="6,1" VerticalAlignment="Center"
                      Background="{ThemeResource EqSurfaceBrush}" Opacity="0.85">
                <TextBlock Text="F1" Style="{StaticResource EqLabelStyle}" FontSize="12" Foreground="{ThemeResource EqTextBrush}" />
              </Border>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- One-line status after an export or a print. -->
      <Border Grid.Row="1" Margin="0,0,0,12" Padding="12,8" CornerRadius="{StaticResource EqRadiusMd}"
              Background="{ThemeResource EqGoldTintBrush}" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1"
              Visibility="{x:Bind local:SalesBindings.Visible(ViewModel.HasNotice), Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE88E;" Style="{StaticResource EqIconStyle}" FontSize="18" Foreground="{ThemeResource EqGoldInkBrush}" />
          <TextBlock Text="{x:Bind ViewModel.NoticeText, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}"
                     Foreground="{ThemeResource EqTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- KPI cards: total sales, transactions, items sold, average sale. -->
      <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="16" Margin="0,0,0,20">
        <Border Grid.Column="0" Style="{StaticResource EqCardStyle}" Padding="16">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Grid Width="44" Height="44">
              <Border CornerRadius="{StaticResource EqRadiusMd}" Background="{ThemeResource EqSuccessBrush}" Opacity="0.18" />
              <FontIcon Glyph="&#xEF63;" Style="{StaticResource EqIconStyle}" Foreground="{ThemeResource EqSuccessBrush}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind services:Loc.Get('Sales_KpiTotal')}" Style="{StaticResource EqSecondaryStyle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ViewModel.TotalSalesText, Mode=OneWay}" Style="{StaticResource EqKpiStyle}" FontSize="24" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource EqCardStyle}" Padding="16">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Grid Width="44" Height="44">
              <Border CornerRadius="{StaticResource EqRadiusMd}" Background="{ThemeResource EqGoldBrush}" Opacity="0.18" />
              <FontIcon Glyph="&#xF05B;" Style="{StaticResource EqIconStyle}" Foreground="{ThemeResource EqGoldInkBrush}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind services:Loc.Get('Sales_KpiTransactions')}" Style="{StaticResource EqSecondaryStyle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ViewModel.TransactionsText, Mode=OneWay}" Style="{StaticResource EqKpiStyle}" FontSize="24" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource EqCardStyle}" Padding="16">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Grid Width="44" Height="44">
              <Border CornerRadius="{StaticResource EqRadiusMd}" Background="{ThemeResource EqInfoBrush}" Opacity="0.18" />
              <FontIcon Glyph="&#xE8CC;" Style="{StaticResource EqIconStyle}" Foreground="{ThemeResource EqInfoBrush}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind services:Loc.Get('Sales_KpiItems')}" Style="{StaticResource EqSecondaryStyle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ViewModel.ItemsSoldText, Mode=OneWay}" Style="{StaticResource EqKpiStyle}" FontSize="24" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="3" Style="{StaticResource EqCardStyle}" Padding="16">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Grid Width="44" Height="44">
              <Border CornerRadius="{StaticResource EqRadiusMd}" Background="{ThemeResource EqGoldBrush}" Opacity="0.18" />
              <FontIcon Glyph="&#xEF6E;" Style="{StaticResource EqIconStyle}" Foreground="{ThemeResource EqGoldInkBrush}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind services:Loc.Get('Sales_KpiAverage')}" Style="{StaticResource EqSecondaryStyle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ViewModel.AverageSaleText, Mode=OneWay}" Style="{StaticResource EqKpiStyle}" FontSize="24" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- Period tabs. -->
      <Border Grid.Row="3" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,16">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PeriodTabViewModel">
              <RadioButton GroupName="SalesPeriod" Style="{StaticResource SalesTabStyle}" Content="{x:Bind Label}"
                           IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- Filters: search, payment method, staff, status. -->
      <Grid Grid.Row="4" ColumnDefinitions="*,240,190,190" ColumnSpacing="12" Margin="0,0,0,16">
        <Border Grid.Column="0" Style="{StaticResource EqInputContainerStyle}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <FontIcon Glyph="&#xEF7A;" Style="{StaticResource EqIconStyle}" FontSize="18" Foreground="{ThemeResource EqTextSecondaryBrush}" />
            <TextBox Grid.Column="1" VerticalAlignment="Center" Padding="0,8"
                     PlaceholderText="{x:Bind services:Loc.Get('Sales_SearchPlaceholder')}"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Bind services:Loc.Get('Sales_SearchPlaceholder')}" />
          </Grid>
        </Border>
        <ComboBox Grid.Column="1" Style="{StaticResource SalesComboStyle}" HorizontalAlignment="Stretch"
                  ItemsSource="{x:Bind ViewModel.MethodOptions}" DisplayMemberPath="Label"
                  SelectedItem="{x:Bind ViewModel.SelectedMethod, Mode=TwoWay}"
                  AutomationProperties.Name="{x:Bind services:Loc.Get('Sales_ColMethod')}" />
        <ComboBox Grid.Column="2" Style="{StaticResource SalesComboStyle}" HorizontalAlignment="Stretch"
                  ItemsSource="{x:Bind ViewModel.StaffOptions}" DisplayMemberPath="Label"
                  SelectedItem="{x:Bind ViewModel.SelectedStaff, Mode=TwoWay}"
                  AutomationProperties.Name="{x:Bind services:Loc.Get('Sales_ColStaff')}" />
        <ComboBox Grid.Column="3" Style="{StaticResource SalesComboStyle}" HorizontalAlignment="Stretch"
                  ItemsSource="{x:Bind ViewModel.StatusOptions}" DisplayMemberPath="Label"
                  SelectedItem="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}"
                  AutomationProperties.Name="{x:Bind services:Loc.Get('Sales_ColStatus')}" />
      </Grid>

      <!-- Table card: header, scrolling rows, pager. Narrow windows scroll sideways instead of clipping columns. -->
      <Border Grid.Row="5" Style="{StaticResource EqCardStyle}" Padding="0">
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                        VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
            <Grid MinWidth="900" RowDefinitions="Auto,*">
              <Grid Grid.Row="0" Padding="16,14" ColumnDefinitions="110,2*,80,110,170,*,140,44" ColumnSpacing="12"
                    BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="0,0,0,1">
                <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Sales_ColReceipt')}" Style="{StaticResource SalesHeaderCellStyle}" />
                <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Sales_ColDate')}" Style="{StaticResource SalesHeaderCellStyle}" />
                <TextBlock Grid.Column="2" Text="{x:Bind services:Loc.Get('Sales_ColItems')}" Style="{StaticResource SalesHeaderCellStyle}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{x:Bind services:Loc.Get('Sales_ColTotal')}" Style="{StaticResource SalesHeaderCellStyle}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="{x:Bind services:Loc.Get('Sales_ColMethod')}" Style="{StaticResource SalesHeaderCellStyle}" />
                <TextBlock Grid.Column="5" Text="{x:Bind services:Loc.Get('Sales_ColStaff')}" Style="{StaticResource SalesHeaderCellStyle}" />
                <TextBlock Grid.Column="6" Text="{x:Bind services:Loc.Get('Sales_ColStatus')}" Style="{StaticResource SalesHeaderCellStyle}" />
              </Grid>

              <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                        SelectionMode="Single" ItemContainerStyle="{StaticResource SalesRowStyle}">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="vm:SaleRowViewModel">
                    <Grid Padding="16,0" ColumnDefinitions="110,2*,80,110,170,*,140,44" ColumnSpacing="12" MinHeight="52"
                          BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="0,0,0,1">
                      <TextBlock Grid.Column="0" Text="{x:Bind ReceiptNumber}" VerticalAlignment="Center"
                                 FontFamily="{StaticResource EqUiFontSemiBold}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{x:Bind DateText}" VerticalAlignment="Center"
                                 Style="{StaticResource EqSecondaryStyle}" Foreground="{ThemeResource EqTextBrush}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{x:Bind ItemsText}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{x:Bind TotalText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                 FontFamily="{StaticResource EqUiFontSemiBold}" TextTrimming="CharacterEllipsis" />

                      <!-- Payment method badge: icon or brand letter, then the name. -->
                      <Border Grid.Column="4" Style="{StaticResource EqBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Background="{ThemeResource EqSurfaceElevatedBrush}" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <FontIcon Glyph="{x:Bind MethodGlyph}" Style="{StaticResource EqIconStyle}" FontSize="16"
                                    Foreground="{ThemeResource EqGoldInkBrush}" VerticalAlignment="Center"
                                    Visibility="{x:Bind local:SalesBindings.Visible(HasMethodGlyph)}" />
                          <Border Width="16" Height="16" CornerRadius="8" VerticalAlignment="Center" Background="{x:Bind MethodBrandBrush}"
                                  Visibility="{x:Bind local:SalesBindings.Visible(HasMethodBrand)}">
                            <TextBlock Text="{x:Bind MethodBrandLetter}" FontSize="10" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Text="{x:Bind MethodText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>

                      <TextBlock Grid.Column="5" Text="{x:Bind StaffText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                      <!-- Status badge: colour tint plus the word, never colour alone. -->
                      <Border Grid.Column="6" Style="{StaticResource EqBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Background="{x:Bind local:SalesBindings.StatusBackground(Status)}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind local:SalesBindings.StatusForeground(Status)}" />
                          <TextBlock Text="{x:Bind StatusText}" FontSize="12" VerticalAlignment="Center"
                                     Foreground="{x:Bind local:SalesBindings.StatusForeground(Status)}" />
                        </StackPanel>
                      </Border>

                      <Button Grid.Column="7" Style="{StaticResource EqPlainIconButtonStyle}" Width="32" Height="32"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRowMenuClick"
                              AutomationProperties.Name="{x:Bind services:Loc.Get('Sales_RowActions')}">
                        <FontIcon Glyph="&#xE5D4;" Style="{StaticResource EqIconStyle}" FontSize="20" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>

              <TextBlock Grid.Row="1" Text="{x:Bind services:Loc.Get('Sales_Empty')}" Style="{StaticResource EqSecondaryStyle}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                         Visibility="{x:Bind local:SalesBindings.Visible(ViewModel.IsEmpty), Mode=OneWay}" />
            </Grid>
          </ScrollViewer>

          <!-- Pager. -->
          <Grid Grid.Row="1" Padding="16,12" ColumnDefinitions="*,Auto" ColumnSpacing="16"
                BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.FooterText, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
              <Button Style="{StaticResource EqPlainIconButtonStyle}" Width="32" Height="32"
                      Command="{x:Bind ViewModel.PreviousPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind services:Loc.Get('Sales_PrevPage')}">
                <FontIcon Glyph="&#xE5CB;" Style="{StaticResource EqIconStyle}" FontSize="20" />
              </Button>
              <ItemsControl ItemsSource="{x:Bind ViewModel.PageButtons, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PageButtonViewModel">
                    <Grid>
                      <!-- Current page: gold. Other pages: plain buttons. Gap: ellipsis. -->
                      <Border Width="32" Height="32" CornerRadius="{StaticResource EqRadiusMd}" Background="{ThemeResource EqGoldBrush}"
                              Visibility="{x:Bind local:SalesBindings.Visible(IsCurrent)}">
                        <TextBlock Text="{x:Bind Text}" Foreground="{ThemeResource EqOnGoldBrush}" FontFamily="{StaticResource EqUiFontSemiBold}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Button Style="{StaticResource EqPlainIconButtonStyle}" Width="32" Height="32" Click="OnPageButtonClick"
                              Visibility="{x:Bind local:SalesBindings.Visible(IsLink)}" AutomationProperties.Name="{x:Bind AutomationName}">
                        <TextBlock Text="{x:Bind Text}" Foreground="{ThemeResource EqTextBrush}" />
                      </Button>
                      <TextBlock Text="{x:Bind Text}" Style="{StaticResource EqSecondaryStyle}" Width="32" TextAlignment="Center" VerticalAlignment="Center"
                                 Visibility="{x:Bind local:SalesBindings.Visible(IsGap)}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Style="{StaticResource EqPlainIconButtonStyle}" Width="32" Height="32"
                      Command="{x:Bind ViewModel.NextPageCommand}" IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind services:Loc.Get('Sales_NextPage')}">
                <FontIcon Glyph="&#xE5CC;" Style="{StaticResource EqIconStyle}" FontSize="20" />
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- Detail panel of the selected sale. -->
    <Border Grid.Column="1" Style="{StaticResource EqCardStyle}" Padding="20">
      <Grid>
        <TextBlock Text="{x:Bind services:Loc.Get('Sales_NoSelection')}" Style="{StaticResource EqSecondaryStyle}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                   Visibility="{x:Bind local:SalesBindings.Hidden(ViewModel.HasSelection), Mode=OneWay}" />

        <Grid RowDefinitions="*,Auto" RowSpacing="16"
              Visibility="{x:Bind local:SalesBindings.Visible(ViewModel.HasSelection), Mode=OneWay}">
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Padding="0,0,4,0">

              <!-- Receipt number, status badge, date, staff. -->
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{x:Bind ViewModel.DetailReceipt, Mode=OneWay}" Style="{StaticResource EqCardTitleStyle}" FontSize="22"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="1" Style="{StaticResource EqBadgeStyle}" VerticalAlignment="Center"
                        Background="{x:Bind local:SalesBindings.StatusBackground(ViewModel.DetailStatus), Mode=OneWay}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{x:Bind local:SalesBindings.StatusForeground(ViewModel.DetailStatus), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.DetailStatusText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{x:Bind local:SalesBindings.StatusForeground(ViewModel.DetailStatus), Mode=OneWay}" />
                  </StackPanel>
                </Border>
              </Grid>

              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <FontIcon Glyph="&#xE935;" Style="{StaticResource EqIconStyle}" FontSize="18" Foreground="{ThemeResource EqTextSecondaryBrush}" />
                  <TextBlock Text="{x:Bind ViewModel.DetailDateText, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" Foreground="{ThemeResource EqTextBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <FontIcon Glyph="&#xF0D3;" Style="{StaticResource EqIconStyle}" FontSize="18" Foreground="{ThemeResource EqTextSecondaryBrush}" />
                  <TextBlock Text="{x:Bind ViewModel.DetailStaffText, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" Foreground="{ThemeResource EqTextBrush}" />
                </StackPanel>
              </StackPanel>

              <Rectangle Height="1" Fill="{ThemeResource EqBorderBrush}" />

              <!-- Items: picture tile (initial until products have pictures), name, SKU and variant, quantity times price, line total. -->
              <TextBlock Text="{x:Bind ViewModel.DetailItemsHeader, Mode=OneWay}" Style="{StaticResource EqCardTitleStyle}" FontSize="16" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.DetailLines}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="12" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SaleDetailLineViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <Border Width="44" Height="44" CornerRadius="{StaticResource EqRadiusMd}" Background="{ThemeResource EqSurfaceElevatedBrush}"
                              BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                        <TextBlock Text="{x:Bind Initial}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="18"
                                   Foreground="{ThemeResource EqGoldInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind SkuAndVariant}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind QuantityAndPrice}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{x:Bind TotalText}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="13"
                                 VerticalAlignment="Top" HorizontalAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Rectangle Height="1" Fill="{ThemeResource EqBorderBrush}" />

              <!-- Totals. -->
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                <TextBlock Grid.Row="0" Text="{x:Bind services:Loc.Get('Sales_Subtotal')}" Style="{StaticResource EqSecondaryStyle}" Foreground="{ThemeResource EqTextBrush}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.DetailSubtotalText, Mode=OneWay}" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="1" Text="{x:Bind services:Loc.Get('Sales_Discount')}" Style="{StaticResource EqSecondaryStyle}" Foreground="{ThemeResource EqTextBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DetailDiscountText, Mode=OneWay}" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.DetailTaxLabel, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" Foreground="{ThemeResource EqTextBrush}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.DetailTaxText, Mode=OneWay}" HorizontalAlignment="Right" />
              </Grid>

              <Rectangle Height="1" Fill="{ThemeResource EqBorderBrush}" />

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{x:Bind services:Loc.Get('Sales_Total')}" Style="{StaticResource EqCardTitleStyle}" FontSize="20" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DetailTotalText, Mode=OneWay}" Style="{StaticResource EqCardTitleStyle}" FontSize="20" />
              </Grid>

              <!-- Payments: each in its own currency, with the rate snapshot when it is not the base currency. -->
              <TextBlock Text="{x:Bind services:Loc.Get('Sales_Payments')}" Style="{StaticResource EqCardTitleStyle}" FontSize="16" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.DetailPayments}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SalePaymentViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel>
                        <TextBlock Text="{x:Bind MethodText}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind RateText}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis"
                                   Visibility="{x:Bind local:SalesBindings.Visible(HasRate)}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{x:Bind AmountText}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="13"
                                 VerticalAlignment="Top" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!-- F8 prints the receipt wherever focus is on this page. -->
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button Style="{StaticResource EqSecondaryButtonStyle}" HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.PrintReceiptCommand}">
              <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="F8" />
              </Button.KeyboardAccelerators>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xEF6E;" Style="{StaticResource EqIconStyle}" FontSize="18" Foreground="{ThemeResource EqGoldInkBrush}" />
                <TextBlock Text="{x:Bind services:Loc.Get('Sales_PrintReceiptF8')}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource EqSecondaryButtonStyle}" MinWidth="40" Width="40" Padding="0"
                    Click="OnDetailMenuClick" AutomationProperties.Name="{x:Bind services:Loc.Get('Sales_MoreActions')}">
              <FontIcon Glyph="&#xE5D3;" Style="{StaticResource EqIconStyle}" FontSize="20" />
            </Button>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Page>
