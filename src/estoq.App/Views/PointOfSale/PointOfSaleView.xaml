<UserControl
    x:Class="Estoq.App.Views.PointOfSale.PointOfSaleView"
    x:Name="RootView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Estoq.App.Controls"
    xmlns:services="using:Estoq.App.Services"
    xmlns:local="using:Estoq.App.Views.PointOfSale"
    xmlns:vm="using:Estoq.App.ViewModels.PointOfSale"
    xmlns:core="using:Estoq.Core.Sales">

  <UserControl.Resources>
    <!-- Flat button: no chrome of its own; the content draws every state (chips, payment tiles, discount pill). -->
    <Style x:Key="PosFlatButtonStyle" TargetType="Button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EqGoldInkBrush}" />
      <Setter Property="FocusVisualPrimaryThickness" Value="2" />
      <Setter Property="FocusVisualMargin" Value="-3" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch" CornerRadius="{StaticResource EqRadiusMd}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Payment tiles act like spring buttons: show hover/press feedback without a persistent selected state. -->
    <Style x:Key="PosPaymentMethodButtonStyle" TargetType="Button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EqGoldInkBrush}" />
      <Setter Property="FocusVisualPrimaryThickness" Value="2" />
      <Setter Property="FocusVisualMargin" Value="-3" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Tile.BorderBrush" Value="{ThemeResource EqGoldBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Tile.Background" Value="{ThemeResource EqGoldTintBrush}" />
                      <Setter Target="Tile.BorderBrush" Value="{ThemeResource EqGoldBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <VisualState.Setters>
                      <Setter Target="Tile.Opacity" Value="0.4" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border x:Name="Tile" Background="{ThemeResource EqSurfaceElevatedBrush}"
                      BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource EqRadiusMd}" />
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Padding="{TemplateBinding Padding}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Round 32 px stepper button for the quantity (minus and plus). -->
    <Style x:Key="PosStepButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{ThemeResource EqTextBrush}" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EqGoldInkBrush}" />
      <Setter Property="FocusVisualPrimaryThickness" Value="2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" Background="{ThemeResource EqSurfaceElevatedBrush}" BorderBrush="{ThemeResource EqBorderBrush}"
                  BorderThickness="1" CornerRadius="{StaticResource EqRadiusMd}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Root.BorderBrush" Value="{ThemeResource EqGoldBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Root.BorderBrush" Value="{ThemeResource EqGoldBrush}" />
                      <Setter Target="Root.Background" Value="{ThemeResource EqGoldTintBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <VisualState.Setters>
                      <Setter Target="Root.Opacity" Value="0.4" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Borderless text box inside a bordered container (the container draws the focus border). -->
    <Style x:Key="PosBareTextBoxStyle" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Left" />
      <Setter Property="FontFamily" Value="{StaticResource EqUiFont}" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="PosPaymentFlyoutPresenterStyle" TargetType="FlyoutPresenter">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Light-weight stat text for the summary rows. -->
    <Style x:Key="PosRowLabelStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource EqUiFont}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{ThemeResource EqTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PosRowValueStyle" TargetType="TextBlock" BasedOn="{StaticResource PosRowLabelStyle}">
      <Setter Property="FontFamily" Value="{StaticResource EqUiFontSemiBold}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
  </UserControl.Resources>

  <!-- Point of sale (F1): scan and cart on the left; payment methods, sale summary and completion on the right. -->
  <Grid>
    <Border Background="{ThemeResource EqSurfaceBrush}" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1"
            CornerRadius="{StaticResource EqRadiusXl}">
      <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,16,16,16" ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{x:Bind services:Loc.Get('Popup_Sale_Title')}" Style="{StaticResource EqCardTitleStyle}" />
              <Border Style="{StaticResource EqBadgeStyle}" CornerRadius="{StaticResource EqRadiusSm}" Padding="8,2"
                      Background="{ThemeResource EqSurfaceElevatedBrush}" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1"
                      VerticalAlignment="Center" Visibility="{x:Bind local:PosBindings.Visible(ViewModel.ShowShortcutHints), Mode=OneWay}">
                <TextBlock Text="F1" Style="{StaticResource EqLabelStyle}" FontSize="12" />
              </Border>
            </StackPanel>
            <TextBlock Text="{x:Bind services:Loc.Get('Pos_Subtitle')}" Style="{StaticResource EqSecondaryStyle}" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <!-- Currency chips: the selected one is gold. They switch the display and entry currency. -->
          <ItemsRepeater Grid.Column="2" ItemsSource="{x:Bind ViewModel.Currencies, Mode=OneWay}" VerticalAlignment="Center">
            <ItemsRepeater.Layout>
              <StackLayout Orientation="Horizontal" Spacing="8" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:CurrencyChipViewModel">
                <Button Style="{StaticResource PosFlatButtonStyle}" Command="{x:Bind SelectCommand}"
                        AutomationProperties.Name="{x:Bind Code}">
                  <Grid Height="36" MinWidth="72" CornerRadius="18">
                    <Border Background="{ThemeResource EqSurfaceElevatedBrush}" BorderBrush="{ThemeResource EqBorderBrush}"
                            BorderThickness="1" CornerRadius="18" />
                    <Border Background="{ThemeResource EqGoldBrush}" CornerRadius="18"
                            Visibility="{x:Bind local:PosBindings.Visible(IsSelected), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource EqLabelStyle}" FontSize="14" Margin="16,0"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource EqTextBrush}"
                               Visibility="{x:Bind local:PosBindings.Hidden(IsSelected), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource EqLabelStyle}" FontSize="14" Margin="16,0"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource EqOnGoldBrush}"
                               Visibility="{x:Bind local:PosBindings.Visible(IsSelected), Mode=OneWay}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>

          <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource EqPlainIconButtonStyle}" VerticalAlignment="Top"
                  Click="OnCloseClick" ToolTipService.ToolTip="{x:Bind services:Loc.Get('Popup_CloseTip')}"
                  AutomationProperties.Name="{x:Bind services:Loc.Get('Popup_Close')}">
            <FontIcon Glyph="&#xE5CD;" FontFamily="{StaticResource EqIconFont}" FontSize="24" />
            <Button.KeyboardAccelerators>
              <KeyboardAccelerator Key="Escape" />
            </Button.KeyboardAccelerators>
          </Button>
        </Grid>
        <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource EqBorderBrush}" />

        <!-- Body -->
        <Grid Grid.Row="1" Padding="16" ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="0" />
            <ColumnDefinition Width="*" MinWidth="0" />
          </Grid.ColumnDefinitions>

          <!-- Left: scan field and cart -->
          <Border Grid.Column="0" Style="{StaticResource EqCardStyle}" Padding="16" Background="{ThemeResource EqSurfaceBrush}">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">

              <!-- Scan or search -->
              <Border x:Name="ScanBox" Grid.Row="0" Height="52" Background="{ThemeResource EqSurfaceBrush}" BorderBrush="{ThemeResource EqGoldBrush}"
                      BorderThickness="2" CornerRadius="{StaticResource EqRadiusLg}" Padding="16,0">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                  </Grid.Resources>
                  <FontIcon Grid.Column="0" Glyph="&#xE70C;" FontFamily="{StaticResource EqIconFont}" FontSize="26"
                            Foreground="{ThemeResource EqTextSecondaryBrush}" VerticalAlignment="Center" />
                  <TextBox x:Name="ScanInput" Grid.Column="1" Style="{StaticResource PosBareTextBoxStyle}" 
                           FontSize="16" TextAlignment="Left" MinHeight="0" Padding="0,6"
                           PlaceholderText="{x:Bind services:Loc.Get('Pos_ScanPlaceholder')}"
                           Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           AutomationProperties.Name="{x:Bind services:Loc.Get('Pos_ScanPlaceholder')}"
                           KeyDown="OnScanKeyDown" />
                </Grid>
              </Border>

              <!-- Message under the field when nothing matches -->
              <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.ScanMessage, Mode=OneWay}" Foreground="{ThemeResource EqDangerBrush}"
                         FontSize="13" TextWrapping="Wrap"
                         Visibility="{x:Bind local:PosBindings.Visible(ViewModel.HasScanMessage), Mode=OneWay}" />

              <!-- Cart table -->
              <Grid Grid.Row="2" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" Style="{StaticResource EqTableHeaderStyle}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" MinWidth="80" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="36" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="#" Style="{StaticResource EqTableHeaderTextStyle}" />
                  <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Pos_ColItem')}" Style="{StaticResource EqTableHeaderTextStyle}" />
                  <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.PriceHeader, Mode=OneWay}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="3" Text="{x:Bind services:Loc.Get('Pos_ColQty')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.TotalHeader, Mode=OneWay}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                  <Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CartLineViewModel">
                          <Grid MinHeight="72" Style="{StaticResource EqTableRowStyle}">
                            <Border Style="{StaticResource EqTableBandStyle}"
                                    Visibility="{x:Bind local:PosBindings.Visible(IsAlternateRow)}" />
                            <Grid Padding="12,8,8,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="24" />
                              <ColumnDefinition Width="*" MinWidth="80" />
                              <ColumnDefinition Width="72" />
                              <ColumnDefinition Width="120" />
                              <ColumnDefinition Width="80" />
                              <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Number}" Style="{StaticResource PosRowLabelStyle}" />

                            <Grid Grid.Column="1" ColumnSpacing="12">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <!-- First-letter placeholder until a product image is available. -->
                              <Border Grid.Column="0" Width="52" Height="52" CornerRadius="{StaticResource EqRadiusMd}"
                                      Background="{ThemeResource EqGoldTintBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Initial}" FontFamily="{StaticResource EqBrandFont}" FontSize="20"
                                           Foreground="{ThemeResource EqGoldInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="15"
                                           Foreground="{ThemeResource EqTextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Sku}" Style="{StaticResource EqSecondaryStyle}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind StockNoteVisibility}">
                                  <FontIcon Glyph="&#xF083;" FontFamily="{StaticResource EqIconFont}" FontSize="14"
                                            Foreground="{ThemeResource EqWarningBrush}" VerticalAlignment="Center" />
                                  <TextBlock Text="{x:Bind StockNote}" FontSize="12" Foreground="{ThemeResource EqWarningBrush}"
                                             TextWrapping="Wrap" />
                                </StackPanel>
                              </StackPanel>
                            </Grid>

                            <TextBlock Grid.Column="2" Text="{x:Bind PriceText}" Style="{StaticResource PosRowValueStyle}" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                              <Button Style="{StaticResource PosStepButtonStyle}" Command="{x:Bind DecreaseCommand}"
                                      AutomationProperties.Name="{x:Bind services:Loc.Get('Pos_QtyDecrease')}">
                                <FontIcon Glyph="&#xE15B;" FontFamily="{StaticResource EqIconFont}" FontSize="18" />
                              </Button>
                              <TextBox Text="{x:Bind QuantityText}" Width="40" Height="36" Padding="0,9"
                                       TextAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource PosBareTextBoxStyle}"
                                       FontFamily="{StaticResource EqUiFontSemiBold}" InputScope="Number" MaxLength="4"
                                       AutomationProperties.Name="{x:Bind services:Loc.Get('Pos_ColQty')}"
                                       LostFocus="OnQuantityCommit" KeyDown="OnQuantityKeyDown">
                                <TextBox.Resources>
                                  <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                  <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource SystemAccentColor}" />
                                  <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                  <Thickness x:Key="TextControlBorderThemeThicknessFocused">0,0,0,2</Thickness>
                                </TextBox.Resources>
                              </TextBox>
                              <Button Style="{StaticResource PosStepButtonStyle}" Command="{x:Bind IncreaseCommand}"
                                      AutomationProperties.Name="{x:Bind services:Loc.Get('Pos_QtyIncrease')}">
                                <FontIcon Glyph="&#xE145;" FontFamily="{StaticResource EqIconFont}" FontSize="18" />
                              </Button>
                            </StackPanel>

                            <TextBlock Grid.Column="4" Text="{x:Bind TotalText}" Style="{StaticResource PosRowValueStyle}" />

                            <Button Grid.Column="5" Style="{StaticResource PosStepButtonStyle}" Command="{x:Bind RemoveCommand}"
                                    Width="36" Height="36" HorizontalAlignment="Right"
                                    ToolTipService.ToolTip="{x:Bind services:Loc.Get('Pos_RemoveItem')}"
                                    AutomationProperties.Name="{x:Bind services:Loc.Get('Pos_RemoveItem')}">
                              <FontIcon Glyph="&#xE872;" FontFamily="{StaticResource EqIconFont}" FontSize="20" />
                            </Button>
                            </Grid>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{x:Bind services:Loc.Get('Pos_EmptyCart')}" Style="{StaticResource EqSecondaryStyle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,64,0,0" TextAlignment="Center"
                               Visibility="{x:Bind local:PosBindings.Visible(ViewModel.IsCartEmpty), Mode=OneWay}" />
                  </Grid>
                </ScrollViewer>

                <!-- Search suggestions, drawn over the cart -->
                <Border Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top" Canvas.ZIndex="5"
                        Background="{ThemeResource EqSurfaceElevatedBrush}" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource EqRadiusLg}" Padding="4"
                        Visibility="{x:Bind local:PosBindings.Visible(ViewModel.HasSuggestions), Mode=OneWay}">
                  <ItemsControl ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="services:SaleVariant">
                        <Button Style="{StaticResource PosFlatButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Click="OnSuggestionClick" Tag="{x:Bind}">
                          <Grid Padding="12,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                              <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="14"
                                         Foreground="{ThemeResource EqTextBrush}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{x:Bind Sku}" Style="{StaticResource EqSecondaryStyle}" />
                                <TextBlock Text="{x:Bind Barcode}" Style="{StaticResource EqSecondaryStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind OnHand}" Style="{StaticResource EqSecondaryStyle}" VerticalAlignment="Center" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </Grid>

            </Grid>
          </Border>

          <!-- Right: payment methods, summary and pinned sale actions -->
          <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="12">
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Spacing="12">
              <!-- Payment -->
              <Border Style="{StaticResource EqCardStyle}" Padding="16">
                <StackPanel Spacing="12">
                  <TextBlock Text="{x:Bind services:Loc.Get('Pos_PaymentMethod')}" Style="{StaticResource EqCardTitleStyle}" FontSize="18" />

                  <ItemsRepeater ItemsSource="{x:Bind ViewModel.Methods, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                      <UniformGridLayout MinItemWidth="84" MinItemHeight="76" MinRowSpacing="8" MinColumnSpacing="8"
                                         MaximumRowsOrColumns="4" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                      <DataTemplate x:DataType="vm:PaymentMethodViewModel">
                        <Button Style="{StaticResource PosPaymentMethodButtonStyle}" Tag="{x:Bind Method}" Click="OnPaymentMethodClick"
                                PointerPressed="OnPaymentMethodPointerPressed"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="{x:Bind Label}">
                          <Grid Height="76" CornerRadius="{StaticResource EqRadiusMd}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Padding="4,0">
                              <Grid Height="28" HorizontalAlignment="Center">
                                <FontIcon Glyph="{x:Bind Glyph}" FontFamily="{StaticResource EqIconFont}" FontSize="26"
                                          Foreground="{ThemeResource EqTextBrush}" Visibility="{x:Bind local:PosBindings.Visible(HasGlyph)}" />
                                <Border Width="28" Height="28" CornerRadius="14" Background="{x:Bind BrandBrush}"
                                        Visibility="{x:Bind local:PosBindings.Visible(HasBrand)}">
                                  <TextBlock Text="{x:Bind BrandLetter}" FontFamily="{StaticResource EqBrandFont}" FontSize="15"
                                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                              </Grid>
                              <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource EqUiFont}" FontSize="13" TextAlignment="Center"
                                         TextWrapping="Wrap" MaxLines="2" Foreground="{ThemeResource EqTextBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                          </Grid>
                          <Button.Flyout>
                            <Flyout Opening="OnPaymentFlyoutOpening" Placement="BottomEdgeAlignedRight"
                                    FlyoutPresenterStyle="{StaticResource PosPaymentFlyoutPresenterStyle}">
                              <Border Width="300" Padding="8" Background="{ThemeResource EqSurfaceBrush}" BorderBrush="{ThemeResource EqBorderBrush}"
                                      BorderThickness="1" CornerRadius="{StaticResource EqRadiusMd}">
                                <Grid ColumnSpacing="8">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock x:Name="PaymentCurrencySymbol" Grid.Column="0" Text="$" FontFamily="{StaticResource EqUiFontSemiBold}"
                                             FontSize="16" Foreground="{ThemeResource EqTextBrush}" VerticalAlignment="Center" Margin="4,0" />
                                  <Border Grid.Column="1" Height="40" Background="{ThemeResource EqSurfaceBrush}" BorderBrush="{ThemeResource EqBorderBrush}"
                                          BorderThickness="1" CornerRadius="{StaticResource EqRadiusMd}">
                                    <Border.RenderTransform>
                                      <CompositeTransform />
                                    </Border.RenderTransform>
                                    <TextBox Height="38" MinHeight="0" Padding="10,9" Background="Transparent" BorderThickness="0"
                                             VerticalAlignment="Stretch" VerticalContentAlignment="Center" TextAlignment="Left"
                                             PlaceholderText="{x:Bind services:Loc.Get('Pos_AmountReceived')}" InputScope="Number"
                                             TextChanged="OnPaymentAmountChanged" KeyDown="OnPaymentAmountKeyDown"
                                             AutomationProperties.Name="{x:Bind services:Loc.Get('Pos_AmountReceived')}">
                                    </TextBox>
                                  </Border>
                                  <Button Grid.Column="2" Style="{StaticResource EqPrimaryButtonStyle}" Width="40" MinWidth="0" Height="40" Padding="0"
                                        Tag="{x:Bind Method}"
                                        Click="OnPaymentSubmit" AutomationProperties.Name="{x:Bind services:Loc.Get('Pos_SubmitPayment')}"
                                        ToolTipService.ToolTip="{x:Bind services:Loc.Get('Pos_SubmitPayment')}">
                                    <FontIcon Glyph="&#xF0BE;" FontFamily="{StaticResource EqIconFont}" FontSize="20" />
                                  </Button>
                                </Grid>
                              </Border>
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                      </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                  </ItemsRepeater>

                </StackPanel>
              </Border>

              <!-- Sale summary -->
              <Border Style="{StaticResource EqCardStyle}" Padding="16">
                <StackPanel Spacing="10">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Text="{x:Bind services:Loc.Get('Pos_Summary')}" Style="{StaticResource EqCardTitleStyle}" FontSize="18" />
                      <TextBlock Text="{x:Bind ViewModel.ItemsText, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" />
                    </StackPanel>
                    <!-- Gold tint rather than a second gold fill: one gold primary per view (design system). -->
                    <Button x:Name="DiscountButton" Grid.Column="1" Style="{StaticResource PosFlatButtonStyle}">
                      <Border Height="40" Padding="14,0" CornerRadius="{StaticResource EqRadiusMd}"
                              Background="{ThemeResource EqGoldTintBrush}" BorderBrush="{ThemeResource EqGoldBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <FontIcon Glyph="&#xF05B;" FontFamily="{StaticResource EqIconFont}" FontSize="20" Foreground="{ThemeResource EqGoldInkBrush}" />
                          <TextBlock Text="{x:Bind services:Loc.Get('Pos_AddDiscount')}" FontFamily="{StaticResource EqUiFontSemiBold}"
                                     FontSize="14" Foreground="{ThemeResource EqGoldInkBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                      <Button.Flyout>
                        <Flyout x:Name="DiscountFlyout" Opening="OnDiscountOpening" Placement="BottomEdgeAlignedRight"
                                FlyoutPresenterStyle="{StaticResource PosPaymentFlyoutPresenterStyle}">
                          <Border Width="{x:Bind ViewModel.DiscountFlyoutWidth, Mode=OneWay}" Padding="16" Background="{ThemeResource EqSurfaceBrush}" BorderBrush="{ThemeResource EqBorderBrush}"
                                  BorderThickness="1" CornerRadius="{StaticResource EqRadiusMd}">
                            <StackPanel Spacing="12">
                              <ItemsRepeater ItemsSource="{x:Bind ViewModel.DiscountPresets, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                  <StackLayout Orientation="Horizontal" Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                  <DataTemplate x:DataType="vm:DiscountPresetViewModel">
                                    <Button Width="{x:Bind ButtonWidth}" Height="36" MinWidth="0" Padding="0"
                                            Style="{StaticResource EqSecondaryButtonStyle}"
                                            Content="{x:Bind Label}" Tag="{x:Bind Tag}" Click="OnDiscountPresetClick" />
                                  </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                              </ItemsRepeater>
                              <Rectangle Height="1" Fill="{ThemeResource EqBorderBrush}" />
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE88E;" FontFamily="{StaticResource EqIconFont}" FontSize="13"
                                          Foreground="{ThemeResource EqTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.DiscountHint, Mode=OneWay}" Style="{StaticResource EqCaptionStyle}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                              </StackPanel>

                              <StackPanel Spacing="6" Visibility="{x:Bind local:PosBindings.Visible(ViewModel.NeedsApproval), Mode=OneWay}">
                                <TextBlock Text="{x:Bind services:Loc.Get('Pos_DiscountApproval')}" Style="{StaticResource EqSecondaryStyle}" />
                                <Border Style="{StaticResource EqInputContainerStyle}">
                                  <PasswordBox x:Name="DiscountApprovalInput" Password="{x:Bind ViewModel.ApprovalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               Height="40" VerticalContentAlignment="Center" KeyDown="OnDiscountKeyDown"
                                               MaxLength="6" Background="Transparent" BorderThickness="0" MinHeight="0" Padding="0,6"
                                               VerticalAlignment="Center" FontFamily="{StaticResource EqUiFont}" FontSize="14"
                                               PlaceholderText="{x:Bind services:Loc.Get('Pos_DiscountApprovalCode')}"
                                               AutomationProperties.Name="{x:Bind services:Loc.Get('Pos_DiscountApprovalCode')}">
                                    <PasswordBox.Resources>
                                      <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                      <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                      <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                      <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    </PasswordBox.Resources>
                                  </PasswordBox>
                                </Border>
                                <Button Style="{StaticResource EqPrimaryButtonStyle}" Content="{x:Bind services:Loc.Get('Pos_DiscountApply')}"
                                        HorizontalAlignment="Right" Click="OnDiscountApply" />
                              </StackPanel>
                              <TextBlock Text="{x:Bind ViewModel.DiscountError, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource EqDangerBrush}"
                                       Visibility="{x:Bind local:PosBindings.Visible(ViewModel.HasDiscountError), Mode=OneWay}" />

                            </StackPanel>
                          </Border>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>

                  <Rectangle Height="1" Fill="{ThemeResource EqBorderBrush}" />

                  <Grid>
                    <TextBlock Text="{x:Bind services:Loc.Get('Pos_Subtotal')}" Style="{StaticResource PosRowLabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.SubtotalText, Mode=OneWay}" Style="{StaticResource PosRowValueStyle}" />
                  </Grid>
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Pos_Discount')}" Style="{StaticResource PosRowLabelStyle}" Visibility="{x:Bind local:PosBindings.Visible(ViewModel.HasDiscount), Mode=OneWay}" />
                    <Button Grid.Column="1" Style="{StaticResource PosFlatButtonStyle}" Command="{x:Bind ViewModel.RemoveDiscountCommand}"
                            IsEnabled="{x:Bind ViewModel.HasDiscount, Mode=OneWay}" HorizontalAlignment="Right" Visibility="{x:Bind local:PosBindings.Visible(ViewModel.HasDiscount), Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind services:Loc.Get('Pos_DiscountRemove')}">
                      <Border Padding="12,4" Background="{ThemeResource EqGoldTintBrush}" BorderBrush="{ThemeResource EqGoldBrush}"
                              BorderThickness="1" CornerRadius="{StaticResource EqRadiusMd}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <TextBlock Text="{x:Bind ViewModel.DiscountTotalText, Mode=OneWay}" FontFamily="{StaticResource EqUiFontSemiBold}"
                                     FontSize="15" Foreground="{ThemeResource EqGoldInkBrush}" VerticalAlignment="Center" />
                          <FontIcon Glyph="&#xE5CD;" FontFamily="{StaticResource EqIconFont}" FontSize="16"
                                    Foreground="{ThemeResource EqGoldInkBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </Button>
                  </Grid>
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{x:Bind ViewModel.TaxLabel, Mode=OneWay}" Style="{StaticResource PosRowLabelStyle}" />
                      <FontIcon Glyph="&#xE88E;" FontFamily="{StaticResource EqIconFont}" FontSize="18"
                                Foreground="{ThemeResource EqGoldInkBrush}" VerticalAlignment="Center"
                                ToolTipService.ToolTip="{x:Bind ViewModel.TaxInfo, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TaxText, Mode=OneWay}" Style="{StaticResource PosRowValueStyle}" />
                  </Grid>

                  <Rectangle Height="1" Fill="{ThemeResource EqBorderBrush}" />

                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Pos_Total')}" FontFamily="{StaticResource EqBrandFont}" FontSize="24"
                               Foreground="{ThemeResource EqTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" FontFamily="{StaticResource EqBrandFont}" FontSize="30"
                               Foreground="{ThemeResource EqTextBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource EqBorderBrush}"
                             Visibility="{x:Bind local:PosBindings.Visible(ViewModel.HasPaymentLines), Mode=OneWay}" />
                  <Grid Style="{StaticResource EqTableHeaderStyle}"
                        Visibility="{x:Bind local:PosBindings.Visible(ViewModel.HasPaymentLines), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Pos_PaymentMethod')}" Style="{StaticResource EqTableHeaderTextStyle}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Pos_PaymentAmount')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
                  </Grid>
                  <ItemsControl ItemsSource="{x:Bind ViewModel.PaymentLines, Mode=OneWay}"
                                Visibility="{x:Bind local:PosBindings.Visible(ViewModel.HasPaymentLines), Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PaymentLineViewModel">
                        <Grid MinHeight="40" Style="{StaticResource EqTableRowStyle}"
                              PointerEntered="OnPaymentRowPointerEntered" PointerExited="OnPaymentRowPointerExited">
                          <Border Style="{StaticResource EqTableBandStyle}"
                                  Visibility="{x:Bind local:PosBindings.Visible(IsAlternateRow)}" />
                          <Grid Padding="12,2,8,2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="{x:Bind Amount}" Style="{StaticResource PosRowValueStyle}" FontSize="14" />
                            <Button Grid.Column="1" Style="{StaticResource PosFlatButtonStyle}" Width="40" Height="40" Padding="0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Command="{x:Bind RemoveCommand}"
                                    Tag="PaymentRemove" Opacity="0" IsHitTestVisible="False"
                                    AutomationProperties.Name="{x:Bind services:Loc.Get('Pos_RemovePayment')}"
                                    ToolTipService.ToolTip="{x:Bind services:Loc.Get('Pos_RemovePayment')}">
                              <Button.RenderTransform>
                                <CompositeTransform TranslateX="12" />
                              </Button.RenderTransform>
                              <Border Width="36" Height="36" Background="{ThemeResource EqDangerBrush}"
                                      CornerRadius="{StaticResource EqRadiusMd}">
                                <FontIcon Glyph="&#xE872;" FontFamily="{StaticResource EqIconFont}" FontSize="19"
                                          Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                            </Button>
                            <TextBlock Grid.Column="0" Text="{x:Bind Method}" Style="{StaticResource PosRowLabelStyle}" FontSize="14" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid Visibility="{x:Bind local:PosBindings.Visible(ViewModel.HasAmountToReturn), Mode=OneWay}" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Pos_AmountToReturn')}" FontFamily="{StaticResource EqUiFontSemiBold}"
                               FontSize="16" Foreground="{ThemeResource EqTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.BalanceText, Mode=OneWay}" FontFamily="{StaticResource EqBrandFont}"
                               FontSize="24" Foreground="{ThemeResource EqSuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Text="{x:Bind services:Loc.Get('Pos_ChangeNeedsCash')}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{ThemeResource EqDangerBrush}"
                             Visibility="{x:Bind local:PosBindings.Visible(ViewModel.NeedsCashForChange), Mode=OneWay}" />
                  <Grid Visibility="{x:Bind local:PosBindings.Visible(ViewModel.HasRemainingToPay), Mode=OneWay}" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Pos_RemainingToPay')}" FontFamily="{StaticResource EqUiFontSemiBold}"
                               FontSize="16" Foreground="{ThemeResource EqTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RemainingToPayText, Mode=OneWay}" FontFamily="{StaticResource EqBrandFont}"
                               FontSize="24" Foreground="{ThemeResource EqTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>

              <!-- Pinned sale actions stay visible while the payment and summary cards scroll. -->
              <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,0,4,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                <Button x:Name="CompleteButton" Grid.Column="0" Style="{StaticResource EqPrimaryButtonStyle}" Height="56" HorizontalAlignment="Stretch"
                      Command="{x:Bind ViewModel.CompleteCommand}" IsEnabled="{x:Bind ViewModel.CanComplete, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind services:Loc.Get('Pos_CompleteTip')}">
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                  <FontIcon Glyph="&#xEF6E;" FontFamily="{StaticResource EqIconFont}" FontSize="24" />
                  <TextBlock Text="{x:Bind services:Loc.Get('Pos_Complete')}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="18"
                             VerticalAlignment="Center" />
                  <Border Padding="8,3" CornerRadius="{StaticResource EqRadiusSm}" Background="{ThemeResource EqOnGoldBrush}" VerticalAlignment="Center"
                          Visibility="{x:Bind local:PosBindings.Visible(ViewModel.ShowShortcutHints), Mode=OneWay}">
                    <TextBlock Text="Ctrl+Enter" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="12" Foreground="{ThemeResource EqGoldBrush}" />
                  </Border>
                </StackPanel>
                <Button.KeyboardAccelerators>
                  <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                </Button.KeyboardAccelerators>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource EqSecondaryButtonStyle}" Width="48" MinWidth="0" Padding="0" Height="56"
                        IsEnabled="{x:Bind local:PosBindings.Not(ViewModel.IsCartEmpty), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind services:Loc.Get('Pos_ClearSale')}">
                  <FontIcon Glyph="&#xE872;" FontFamily="{StaticResource EqIconFont}" FontSize="20" />
                  <Button.Flyout>
                    <Flyout x:Name="ClearFlyout">
                      <StackPanel Width="260" Spacing="12">
                        <TextBlock Text="{x:Bind services:Loc.Get('Pos_ClearConfirm')}" Style="{StaticResource EqLabelStyle}" TextWrapping="Wrap" Foreground="{ThemeResource EqTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                          <Button Style="{StaticResource EqSecondaryButtonStyle}" Content="{x:Bind services:Loc.Get('Common_Cancel')}" Click="OnClearCancel" />
                          <Button Style="{StaticResource EqPrimaryButtonStyle}" Content="{x:Bind services:Loc.Get('Pos_ClearSale')}" Click="OnClearConfirm" />
                        </StackPanel>
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <!-- Sale completed -->
    <Border Background="{ThemeResource EqScrimBrush}" CornerRadius="{StaticResource EqRadiusXl}"
            Visibility="{x:Bind ViewModel.IsCompleted, Mode=OneWay}">
      <Border Width="520" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource EqCardStyle}" Padding="24"
              Background="{ThemeResource EqSurfaceBrush}">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="12">
          <FontIcon Glyph="&#xF0BE;" FontFamily="{StaticResource EqIconFont}" FontSize="48" Foreground="{ThemeResource EqSuccessBrush}"
                    HorizontalAlignment="Center" Grid.Row="0" />
          <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="{x:Bind services:Loc.Get('Pos_DoneTitle')}" Style="{StaticResource EqCardTitleStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.DoneNumberText, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" HorizontalAlignment="Center" />
          </StackPanel>
          <ScrollViewer Grid.Row="2" MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="4">
              <ItemsControl ItemsSource="{x:Bind ViewModel.CompletedSaleLines, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CartLineViewModel">
                    <Grid MinHeight="42" Padding="8,6" ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{x:Bind Name}" Style="{StaticResource PosRowLabelStyle}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{x:Bind ReceiptPriceText}" Style="{StaticResource PosRowLabelStyle}" />
                      <TextBlock Grid.Column="2" Text="{x:Bind ReceiptQuantityText}" Style="{StaticResource PosRowValueStyle}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Spacing="2" Visibility="{x:Bind local:PosBindings.Visible(ViewModel.HasPaymentLines), Mode=OneWay}">
                <Rectangle Height="1" Fill="{ThemeResource EqBorderBrush}" Margin="0,4" />
                <TextBlock Text="{x:Bind services:Loc.Get('Pos_PaymentMethod')}" Style="{StaticResource EqLabelStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.CompletedPaymentLines, Mode=OneWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PaymentLineViewModel">
                      <Grid MinHeight="36" Padding="8,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Method}" Style="{StaticResource PosRowLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Amount}" Style="{StaticResource PosRowValueStyle}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="3" Spacing="8">
            <Rectangle Height="1" Fill="{ThemeResource EqBorderBrush}" />
            <Grid>
              <TextBlock Text="{x:Bind ViewModel.DoneTaxLabel, Mode=OneWay}" Style="{StaticResource PosRowLabelStyle}" />
              <TextBlock Text="{x:Bind ViewModel.DoneTaxText, Mode=OneWay}" Style="{StaticResource PosRowValueStyle}" />
            </Grid>
            <Grid>
              <TextBlock Text="{x:Bind services:Loc.Get('Pos_Total')}" Style="{StaticResource PosRowLabelStyle}" FontFamily="{StaticResource EqUiFontSemiBold}" />
              <TextBlock Text="{x:Bind ViewModel.DoneTotalText, Mode=OneWay}" Style="{StaticResource PosRowValueStyle}" FontSize="20" />
            </Grid>
            <Grid Visibility="{x:Bind local:PosBindings.Visible(ViewModel.HasPaymentLines), Mode=OneWay}">
              <TextBlock Text="{x:Bind services:Loc.Get('Pos_AmountPaid')}" Style="{StaticResource PosRowLabelStyle}" />
              <TextBlock Text="{x:Bind ViewModel.DonePaidText, Mode=OneWay}" Style="{StaticResource PosRowValueStyle}" />
            </Grid>
          </StackPanel>
          <Grid Grid.Row="4" Visibility="{x:Bind local:PosBindings.Visible(ViewModel.DoneHasChange), Mode=OneWay}">
            <TextBlock Text="{x:Bind services:Loc.Get('Pos_ChangeDue')}" Style="{StaticResource PosRowLabelStyle}" />
            <TextBlock Text="{x:Bind ViewModel.DoneChangeText, Mode=OneWay}" Style="{StaticResource PosRowValueStyle}"
                       Foreground="{ThemeResource EqSuccessBrush}" FontSize="20" />
          </Grid>
          <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Padding="0,8,0,0">
            <Button Style="{StaticResource EqSecondaryButtonStyle}" Content="{x:Bind services:Loc.Get('Popup_Close')}" Click="OnCloseClick" />
            <Button Style="{StaticResource EqSecondaryButtonStyle}" Content="{x:Bind services:Loc.Get('Pos_PrintReceipt')}" Click="OnPrintReceiptClick" />
            <Button x:Name="NewSaleButton" Style="{StaticResource EqPrimaryButtonStyle}" Command="{x:Bind ViewModel.NewSaleCommand}"
                    Content="{x:Bind services:Loc.Get('Pos_NewSale')}" Click="OnNewSaleClick" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>
  </Grid>
</UserControl>
