<UserControl
    x:Class="Estoq.App.Views.Returns.ReturnsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Estoq.App.Services"
    xmlns:pos="using:Estoq.App.Views.PointOfSale"
    xmlns:vm="using:Estoq.App.ViewModels.Returns">

  <UserControl.Resources>
    <!-- Square stepper button for the quantity (minus and plus); same look as the point of sale. -->
    <Style x:Key="ReturnStepButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="{StaticResource EqControlHeight}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{ThemeResource EqTextBrush}" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EqGoldInkBrush}" />
      <Setter Property="FocusVisualPrimaryThickness" Value="2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" Background="{ThemeResource EqSurfaceElevatedBrush}" BorderBrush="{ThemeResource EqBorderBrush}"
                  BorderThickness="1" CornerRadius="{StaticResource EqRadiusMd}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Root.Background" Value="{ThemeResource EqHoverFillBrush}" />
                      <Setter Target="Root.BorderBrush" Value="{ThemeResource EqGoldBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Root.BorderBrush" Value="{ThemeResource EqGoldBrush}" />
                      <Setter Target="Root.Background" Value="{ThemeResource EqGoldTintBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <VisualState.Setters>
                      <Setter Target="Root.Opacity" Value="0.4" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Return type card (Refund, Exchange): a bordered tile that fills on hover; the selected one is drawn by the content. -->
    <Style x:Key="ReturnTypeCardStyle" TargetType="Button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{ThemeResource EqTextBrush}" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EqGoldInkBrush}" />
      <Setter Property="FocusVisualPrimaryThickness" Value="2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" Background="{ThemeResource EqSurfaceBrush}" BorderBrush="{ThemeResource EqBorderBrush}"
                  BorderThickness="1" CornerRadius="{StaticResource EqRadiusLg}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Root.Background" Value="{ThemeResource EqHoverFillBrush}" />
                      <Setter Target="Root.BorderBrush" Value="{ThemeResource EqGoldBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Root.Background" Value="{ThemeResource EqGoldTintBrush}" />
                      <Setter Target="Root.BorderBrush" Value="{ThemeResource EqGoldBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <ContentPresenter Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Stretch" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Borderless text box inside a bordered container (the container draws the border). -->
    <Style x:Key="ReturnBareTextBoxStyle" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Left" />
      <Setter Property="FontFamily" Value="{StaticResource EqUiFont}" />
      <Setter Property="FontSize" Value="{StaticResource EqFontLg}" />
    </Style>
  </UserControl.Resources>

  <!-- Returns (F4), mockup 5: original sale, items, reason and note on the left; type and summary on the right. -->
  <Grid x:Name="ReturnsRoot" ColumnSpacing="16" Loaded="OnReturnsLoaded">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="3*" MinWidth="0" />
      <ColumnDefinition Width="2*" MinWidth="0" />
    </Grid.ColumnDefinitions>

    <!-- LEFT -->
    <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" RowSpacing="16">

      <!-- Original sale: receipt lookup, the found sale, or the no-receipt notice. -->
      <Border Grid.Row="0" Style="{StaticResource EqCardStyle}" Padding="20">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xEF6E;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont2xl}" Foreground="{ThemeResource EqGoldInkBrush}" />
            <TextBlock Text="{x:Bind services:Loc.Get('Ret_SaleTitle')}" Style="{StaticResource EqCardTitleStyle}" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Lookup -->
          <StackPanel Spacing="8" Visibility="{x:Bind pos:PosBindings.Hidden(ViewModel.HasItemsSource), Mode=OneWay}">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource EqInputContainerStyle}">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <FontIcon Grid.Column="0" Glyph="&#xEF7A;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}"
                            Foreground="{ThemeResource EqTextSecondaryBrush}" VerticalAlignment="Center" />
                  <TextBox x:Name="ReceiptInput" Grid.Column="1" Style="{StaticResource ReturnBareTextBoxStyle}"
                           Text="{x:Bind ViewModel.ReceiptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="{x:Bind services:Loc.Get('Ret_ReceiptPlaceholder')}" KeyDown="OnReceiptKeyDown"
                           AutomationProperties.Name="{x:Bind services:Loc.Get('Ret_ReceiptPlaceholder')}">
                    <TextBox.Resources>
                      <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                      <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                      <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                      <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                  </TextBox>
                </Grid>
              </Border>
              <Button Grid.Column="1" Style="{StaticResource EqSecondaryButtonStyle}" Command="{x:Bind ViewModel.FindSaleCommand}"
                      Content="{x:Bind services:Loc.Get('Ret_FindSale')}" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.LookupError, Mode=OneWay}" Foreground="{ThemeResource EqDangerBrush}" FontSize="{StaticResource EqFontMd}"
                       TextWrapping="Wrap" Visibility="{x:Bind pos:PosBindings.Visible(ViewModel.HasLookupError), Mode=OneWay}" />
            <Button Style="{StaticResource EqLinkButtonStyle}" Command="{x:Bind ViewModel.StartNoReceiptCommand}"
                    Content="{x:Bind services:Loc.Get('Ret_NoReceipt')}" HorizontalAlignment="Left" />
          </StackPanel>

          <!-- A sale was found -->
          <Grid ColumnSpacing="12" Visibility="{x:Bind pos:PosBindings.Visible(ViewModel.HasSale), Mode=OneWay}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{x:Bind ViewModel.SaleNumberText, Mode=OneWay}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontXl}" />
              <TextBlock Text="{x:Bind ViewModel.SaleDateText, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource EqSecondaryButtonStyle}" Command="{x:Bind ViewModel.ChangeSaleCommand}"
                    Content="{x:Bind services:Loc.Get('Ret_ChangeSale')}" VerticalAlignment="Center" />
          </Grid>

          <!-- Returning without a receipt -->
          <Grid ColumnSpacing="12" Visibility="{x:Bind pos:PosBindings.Visible(ViewModel.IsNoReceipt), Mode=OneWay}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{x:Bind services:Loc.Get('Ret_NoReceiptTitle')}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontXl}" />
              <TextBlock Text="{x:Bind services:Loc.Get('Ret_NoReceiptHint')}" Style="{StaticResource EqSecondaryStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource EqSecondaryButtonStyle}" Command="{x:Bind ViewModel.ChangeSaleCommand}"
                    Content="{x:Bind services:Loc.Get('Ret_UseReceipt')}" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Return items -->
      <Border Grid.Row="1" Style="{StaticResource EqCardStyle}" Padding="20">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE1A1;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont2xl}" Foreground="{ThemeResource EqGoldInkBrush}" />
            <TextBlock Text="{x:Bind services:Loc.Get('Ret_ItemsTitle')}" Style="{StaticResource EqCardTitleStyle}" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Scan or search (only without a receipt) -->
          <Border Grid.Row="1" Style="{StaticResource EqInputContainerStyle}" Visibility="{x:Bind pos:PosBindings.Visible(ViewModel.IsNoReceipt), Mode=OneWay}">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Glyph="&#xF206;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}"
                        Foreground="{ThemeResource EqTextSecondaryBrush}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Style="{StaticResource ReturnBareTextBoxStyle}"
                       Text="{x:Bind ViewModel.ReturnScanText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="{x:Bind services:Loc.Get('Ret_ScanPlaceholder')}" KeyDown="OnReturnScanKeyDown"
                       AutomationProperties.Name="{x:Bind services:Loc.Get('Ret_ScanPlaceholder')}">
                <TextBox.Resources>
                  <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                  <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                  <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                  <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </TextBox.Resources>
              </TextBox>
            </Grid>
          </Border>

          <!-- Table header -->
          <Grid Grid.Row="2" Style="{StaticResource EqTableHeaderStyle}" Visibility="{x:Bind pos:PosBindings.Visible(ViewModel.HasLines), Mode=OneWay}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="96" />
              <ColumnDefinition Width="132" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Ret_ColItem')}" Style="{StaticResource EqTableHeaderTextStyle}" />
            <TextBlock Grid.Column="2" Text="{x:Bind services:Loc.Get('Ret_ColPrice')}" Style="{StaticResource EqTableHeaderTextStyle}" TextAlignment="Right" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="{x:Bind services:Loc.Get('Ret_ColQty')}" Style="{StaticResource EqTableHeaderTextStyle}" TextAlignment="Center" HorizontalAlignment="Center" />
          </Grid>

          <Grid Grid.Row="3">
            <TextBlock Style="{StaticResource EqSecondaryStyle}" TextWrapping="Wrap" VerticalAlignment="Top"
                       Text="{x:Bind services:Loc.Get('Ret_ItemsEmpty')}"
                       Visibility="{x:Bind pos:PosBindings.Hidden(ViewModel.HasLines), Mode=OneWay}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"
                          Visibility="{x:Bind pos:PosBindings.Visible(ViewModel.HasLines), Mode=OneWay}">
              <ItemsControl ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReturnLineViewModel">
                    <Grid MinHeight="64" Style="{StaticResource EqTableRowStyle}">
                      <Border Style="{StaticResource EqTableBandStyle}" Visibility="{x:Bind pos:PosBindings.Visible(IsAlternateRow)}" />
                      <Grid Padding="8,8,8,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="32" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" MinWidth="0" Padding="0" VerticalAlignment="Center" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind Name}" />
                        <Grid Grid.Column="1" ColumnSpacing="12">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <!-- First-letter placeholder until a product image is available. -->
                          <Border Grid.Column="0" Width="44" Height="44" CornerRadius="{StaticResource EqRadiusMd}"
                                  Background="{ThemeResource EqGoldTintBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Initial}" FontFamily="{StaticResource EqBrandFont}" FontSize="{StaticResource EqFont2xl}"
                                       Foreground="{ThemeResource EqGoldInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource EqTableCellStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource EqSecondaryStyle}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                        <TextBlock Grid.Column="2" Text="{x:Bind PriceText, Mode=OneWay}" Style="{StaticResource EqTableCellStyle}"
                                   TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Button Style="{StaticResource ReturnStepButtonStyle}" Command="{x:Bind DecreaseCommand}"
                                  AutomationProperties.Name="{x:Bind services:Loc.Get('Ret_QtyDecrease')}">
                            <FontIcon Glyph="&#xE15B;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" />
                          </Button>
                          <TextBox Text="{x:Bind QuantityText, Mode=OneWay}" Width="40" Height="{StaticResource EqControlHeight}" Padding="0,9"
                                   TextAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource ReturnBareTextBoxStyle}"
                                   FontFamily="{StaticResource EqUiFontSemiBold}" InputScope="Number" MaxLength="4"
                                   AutomationProperties.Name="{x:Bind services:Loc.Get('Ret_ColQty')}"
                                   LostFocus="OnQuantityCommit" KeyDown="OnQuantityKeyDown">
                            <TextBox.Resources>
                              <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                              <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                              <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                              <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                              <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                              <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource SystemAccentColor}" />
                              <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                              <Thickness x:Key="TextControlBorderThemeThicknessFocused">0,0,0,2</Thickness>
                            </TextBox.Resources>
                          </TextBox>
                          <Button Style="{StaticResource ReturnStepButtonStyle}" Command="{x:Bind IncreaseCommand}"
                                  AutomationProperties.Name="{x:Bind services:Loc.Get('Ret_QtyIncrease')}">
                            <FontIcon Glyph="&#xE145;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" />
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>

      <!-- Reason (optional) and note -->
      <Border Grid.Row="2" Style="{StaticResource EqCardStyle}" Padding="20">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xF05B;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont2xl}" Foreground="{ThemeResource EqGoldInkBrush}" />
            <TextBlock Text="{x:Bind services:Loc.Get('Ret_ReasonTitle')}" Style="{StaticResource EqCardTitleStyle}" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind services:Loc.Get('Label_Optional')}" Style="{StaticResource EqSecondaryStyle}" VerticalAlignment="Center" />
          </StackPanel>
          <Border Style="{StaticResource EqInputContainerStyle}" Padding="4,0">
            <ComboBox HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                      SelectedIndex="{x:Bind ViewModel.ReasonIndex, Mode=TwoWay}"
                      AutomationProperties.Name="{x:Bind services:Loc.Get('Ret_ReasonTitle')}">
              <ComboBoxItem Content="{x:Bind services:Loc.Get('Ret_ReasonNone')}" />
              <ComboBoxItem Content="{x:Bind services:Loc.Get('Ret_Reason_ChangeOfMind')}" />
              <ComboBoxItem Content="{x:Bind services:Loc.Get('Ret_Reason_WrongSize')}" />
              <ComboBoxItem Content="{x:Bind services:Loc.Get('Ret_Reason_Defective')}" />
              <ComboBoxItem Content="{x:Bind services:Loc.Get('Ret_Reason_WrongItem')}" />
              <ComboBoxItem Content="{x:Bind services:Loc.Get('Ret_Reason_Other')}" />
            </ComboBox>
          </Border>
          <Border Style="{StaticResource EqInputContainerStyle}" Height="72" Padding="12,8">
            <TextBox Style="{StaticResource ReturnBareTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Stretch"
                     VerticalContentAlignment="Top" Text="{x:Bind ViewModel.Note, Mode=TwoWay}"
                     PlaceholderText="{x:Bind services:Loc.Get('Ret_NotePlaceholder')}"
                     AutomationProperties.Name="{x:Bind services:Loc.Get('Ret_NotePlaceholder')}">
              <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
              </TextBox.Resources>
            </TextBox>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- RIGHT -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
      <StackPanel Spacing="16">

        <!-- Return type -->
        <Border Style="{StaticResource EqCardStyle}" Padding="20">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon Glyph="&#xE53B;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont2xl}" Foreground="{ThemeResource EqGoldInkBrush}" />
              <TextBlock Text="{x:Bind services:Loc.Get('Ret_TypeTitle')}" Style="{StaticResource EqCardTitleStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <Button Style="{StaticResource ReturnTypeCardStyle}" Command="{x:Bind ViewModel.SelectRefundCommand}"
                    AutomationProperties.Name="{x:Bind services:Loc.Get('Ret_TypeRefund')}">
              <Grid>
                <Border BorderBrush="{ThemeResource EqGoldBrush}" BorderThickness="2" CornerRadius="{StaticResource EqRadiusLg}"
                        Background="{ThemeResource EqGoldTintBrush}" IsHitTestVisible="False"
                        Visibility="{x:Bind pos:PosBindings.Visible(ViewModel.IsRefund), Mode=OneWay}" />
                <Grid Padding="16" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <FontIcon Grid.Column="0" Glyph="&#xEF63;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont3xl}"
                            Foreground="{ThemeResource EqGoldInkBrush}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind services:Loc.Get('Ret_TypeRefund')}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontXl}" />
                    <TextBlock Text="{x:Bind services:Loc.Get('Ret_TypeRefundHint')}" Style="{StaticResource EqSecondaryStyle}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid Grid.Column="2" Width="20" Height="20" VerticalAlignment="Top">
                    <Ellipse Stroke="{ThemeResource EqBorderBrush}" StrokeThickness="2" />
                    <Ellipse Width="20" Height="20" Stroke="{ThemeResource EqGoldBrush}" StrokeThickness="2" Visibility="{x:Bind pos:PosBindings.Visible(ViewModel.IsRefund), Mode=OneWay}" />
                    <Ellipse Width="10" Height="10" Fill="{ThemeResource EqGoldBrush}" Visibility="{x:Bind pos:PosBindings.Visible(ViewModel.IsRefund), Mode=OneWay}" />
                  </Grid>
                </Grid>
              </Grid>
            </Button>

            <Button Style="{StaticResource ReturnTypeCardStyle}" Command="{x:Bind ViewModel.SelectExchangeCommand}"
                    AutomationProperties.Name="{x:Bind services:Loc.Get('Ret_TypeExchange')}">
              <Grid>
                <Border BorderBrush="{ThemeResource EqGoldBrush}" BorderThickness="2" CornerRadius="{StaticResource EqRadiusLg}"
                        Background="{ThemeResource EqGoldTintBrush}" IsHitTestVisible="False"
                        Visibility="{x:Bind pos:PosBindings.Visible(ViewModel.IsExchange), Mode=OneWay}" />
                <Grid Padding="16" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <FontIcon Grid.Column="0" Glyph="&#xE8D4;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont3xl}"
                            Foreground="{ThemeResource EqGoldInkBrush}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind services:Loc.Get('Ret_TypeExchange')}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontXl}" />
                    <TextBlock Text="{x:Bind services:Loc.Get('Ret_TypeExchangeHint')}" Style="{StaticResource EqSecondaryStyle}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid Grid.Column="2" Width="20" Height="20" VerticalAlignment="Top">
                    <Ellipse Stroke="{ThemeResource EqBorderBrush}" StrokeThickness="2" />
                    <Ellipse Width="20" Height="20" Stroke="{ThemeResource EqGoldBrush}" StrokeThickness="2" Visibility="{x:Bind pos:PosBindings.Visible(ViewModel.IsExchange), Mode=OneWay}" />
                    <Ellipse Width="10" Height="10" Fill="{ThemeResource EqGoldBrush}" Visibility="{x:Bind pos:PosBindings.Visible(ViewModel.IsExchange), Mode=OneWay}" />
                  </Grid>
                </Grid>
              </Grid>
            </Button>
          </StackPanel>
        </Border>

        <!-- Exchange: the new items the customer takes -->
        <Border Style="{StaticResource EqCardStyle}" Padding="20" Visibility="{x:Bind pos:PosBindings.Visible(ViewModel.IsExchange), Mode=OneWay}">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon Glyph="&#xE8D4;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont2xl}" Foreground="{ThemeResource EqGoldInkBrush}" />
              <TextBlock Text="{x:Bind services:Loc.Get('Ret_ExchangeTitle')}" Style="{StaticResource EqCardTitleStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <Border Style="{StaticResource EqInputContainerStyle}">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xF206;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}"
                          Foreground="{ThemeResource EqTextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Style="{StaticResource ReturnBareTextBoxStyle}"
                         Text="{x:Bind ViewModel.ExchangeScanText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{x:Bind services:Loc.Get('Ret_ScanPlaceholder')}" KeyDown="OnExchangeScanKeyDown"
                         AutomationProperties.Name="{x:Bind services:Loc.Get('Ret_ScanPlaceholder')}">
                  <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                  </TextBox.Resources>
                </TextBox>
              </Grid>
            </Border>
            <TextBlock Text="{x:Bind services:Loc.Get('Ret_ExchangeEmpty')}" Style="{StaticResource EqSecondaryStyle}" TextWrapping="Wrap"
                       Visibility="{x:Bind pos:PosBindings.Hidden(ViewModel.HasExchangeLines), Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.ExchangeLines, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ExchangeLineViewModel">
                  <Grid MinHeight="56" Style="{StaticResource EqTableRowStyle}">
                    <Grid Padding="4,8" ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource EqTableCellStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind TotalText}" Style="{StaticResource EqSecondaryStyle}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Style="{StaticResource ReturnStepButtonStyle}" Command="{x:Bind DecreaseCommand}"
                                AutomationProperties.Name="{x:Bind services:Loc.Get('Ret_QtyDecrease')}">
                          <FontIcon Glyph="&#xE15B;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" />
                        </Button>
                        <TextBlock Text="{x:Bind QuantityText}" Width="28" TextAlignment="Center" VerticalAlignment="Center" Style="{StaticResource EqTableCellStrongStyle}" />
                        <Button Style="{StaticResource ReturnStepButtonStyle}" Command="{x:Bind IncreaseCommand}"
                                AutomationProperties.Name="{x:Bind services:Loc.Get('Ret_QtyIncrease')}">
                          <FontIcon Glyph="&#xE145;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" />
                        </Button>
                      </StackPanel>
                      <Button Grid.Column="2" Style="{StaticResource EqPlainIconButtonStyle}" Command="{x:Bind RemoveCommand}"
                              AutomationProperties.Name="{x:Bind services:Loc.Get('Ret_Remove')}">
                        <FontIcon Glyph="&#xE5CD;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" />
                      </Button>
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Summary -->
        <Border Style="{StaticResource EqCardStyle}" Padding="20">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon Glyph="&#xEF63;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont2xl}" Foreground="{ThemeResource EqGoldInkBrush}" />
              <TextBlock Text="{x:Bind ViewModel.SummaryTitle, Mode=OneWay}" Style="{StaticResource EqCardTitleStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <Grid>
              <TextBlock Text="{x:Bind ViewModel.SubtotalLabel, Mode=OneWay}" Style="{StaticResource EqTableCellStyle}" />
              <TextBlock Text="{x:Bind ViewModel.SubtotalText, Mode=OneWay}" Style="{StaticResource EqTableCellStrongStyle}" HorizontalAlignment="Right" />
            </Grid>

            <!-- Exchange: credit and new items before the balance -->
            <StackPanel Spacing="12" Visibility="{x:Bind pos:PosBindings.Visible(ViewModel.IsBalanceRow), Mode=OneWay}">
              <Grid>
                <TextBlock Text="{x:Bind services:Loc.Get('Ret_ExchangeCredit')}" Style="{StaticResource EqTableCellStyle}" />
                <TextBlock Text="{x:Bind ViewModel.CreditText, Mode=OneWay}" Style="{StaticResource EqTableCellStrongStyle}" HorizontalAlignment="Right" />
              </Grid>
              <Grid>
                <TextBlock Text="{x:Bind services:Loc.Get('Ret_NewItemsTotal')}" Style="{StaticResource EqTableCellStyle}" />
                <TextBlock Text="{x:Bind ViewModel.NewItemsText, Mode=OneWay}" Style="{StaticResource EqTableCellStrongStyle}" HorizontalAlignment="Right" />
              </Grid>
            </StackPanel>

            <!-- The highlighted amount: refund amount, or what the customer pays or receives -->
            <Border Background="{ThemeResource EqGoldTintBrush}" CornerRadius="{StaticResource EqRadiusMd}" Padding="12,10">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.AmountLabel, Mode=OneWay}" FontFamily="{StaticResource EqUiFontSemiBold}"
                           FontSize="{StaticResource EqFontXl}" Foreground="{ThemeResource EqGoldInkBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind ViewModel.AmountText, Mode=OneWay}" FontFamily="{StaticResource EqUiFontSemiBold}"
                             FontSize="{StaticResource EqFont2xl}" Foreground="{ThemeResource EqGoldInkBrush}" TextAlignment="Right" HorizontalAlignment="Right" />
                  <TextBlock Text="{x:Bind ViewModel.SettleText, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" TextAlignment="Right" HorizontalAlignment="Right"
                             Visibility="{x:Bind pos:PosBindings.Visible(ViewModel.ShowSettle), Mode=OneWay}" />
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock Text="{x:Bind ViewModel.CappedNote, Mode=OneWay}" Style="{StaticResource EqCaptionStyle}" TextWrapping="Wrap"
                       Visibility="{x:Bind pos:PosBindings.Visible(ViewModel.HasCappedNote), Mode=OneWay}" />

            <!-- Currency to hand over or take, at the current rate -->
            <StackPanel Spacing="6">
              <TextBlock Text="{x:Bind services:Loc.Get('Ret_SettleIn')}" Style="{StaticResource EqLabelStyle}" />
              <Border Style="{StaticResource EqInputContainerStyle}" Padding="4,0">
                <ComboBox HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                          ItemsSource="{x:Bind ViewModel.Currencies}" SelectedItem="{x:Bind ViewModel.SelectedCurrency, Mode=TwoWay}"
                          AutomationProperties.Name="{x:Bind services:Loc.Get('Ret_SettleIn')}" />
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
