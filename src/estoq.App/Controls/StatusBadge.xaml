<UserControl
    x:Class="Estoq.App.Controls.StatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Status pill, same look as the currency chips: elevated surface, 1 px border, full radius, semibold text. The dot colour only backs up the words. -->
  <Grid x:Name="Root" HorizontalAlignment="Left" VerticalAlignment="Center">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="KindStates">
        <VisualState x:Name="Neutral">
          <VisualState.Setters>
            <Setter Target="Dot.Fill" Value="{ThemeResource EqTextSecondaryBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Success">
          <VisualState.Setters>
            <Setter Target="Dot.Fill" Value="{ThemeResource EqSuccessBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Warning">
          <VisualState.Setters>
            <Setter Target="Dot.Fill" Value="{ThemeResource EqWarningBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Danger">
          <VisualState.Setters>
            <Setter Target="Dot.Fill" Value="{ThemeResource EqDangerBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Border Height="28" CornerRadius="14" Background="{ThemeResource EqSurfaceElevatedBrush}"
            BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1" Padding="12,0">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{ThemeResource EqTextSecondaryBrush}" VerticalAlignment="Center" />
        <TextBlock x:Name="Label" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontSm}"
                   Foreground="{ThemeResource EqTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
