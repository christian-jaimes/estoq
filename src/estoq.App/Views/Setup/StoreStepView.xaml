<UserControl
    x:Class="Estoq.App.Views.Setup.StoreStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Estoq.App.Controls"
    xmlns:services="using:Estoq.App.Services"
    xmlns:vm="using:Estoq.App.ViewModels.Setup">

  <Grid RowSpacing="20" ColumnSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Logo and the two lead fields. -->
    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8">
      <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="168" Padding="0"
              Background="{ThemeResource EqSurfaceBrush}" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1"
              CornerRadius="{StaticResource EqRadiusLg}" Command="{x:Bind ViewModel.PickLogoCommand}"
              AutomationProperties.Name="{x:Bind ViewModel.LogoButtonText, Mode=OneWay}">
        <Grid>
          <Image Source="{x:Bind ViewModel.LogoPreview, Mode=OneWay}" Stretch="Uniform" Margin="12"
                 Visibility="{x:Bind ViewModel.HasLogo, Mode=OneWay}" />
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4"
                      Visibility="{x:Bind ViewModel.HasNoLogo, Mode=OneWay}">
            <FontIcon Glyph="&#xE145;" FontFamily="{StaticResource EqIconFont}" FontSize="32"
                      Foreground="{ThemeResource EqGoldInkBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.LogoButtonText, Mode=OneWay}" FontFamily="{StaticResource EqUiFontSemiBold}"
                       FontSize="{StaticResource EqFontMd}" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Bind services:Loc.Get('Store_LogoHint')}" Style="{StaticResource EqCaptionStyle}"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Button>
      <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.HasLogo, Mode=OneWay}">
        <HyperlinkButton Style="{StaticResource EqLinkButtonStyle}" Content="{x:Bind services:Loc.Get('Store_RemoveLogo')}"
                Command="{x:Bind ViewModel.RemoveLogoCommand}" />
      </StackPanel>
      <TextBlock Text="{x:Bind ViewModel.LogoError, Mode=OneWay}" FontSize="{StaticResource EqFontXs}" TextWrapping="Wrap"
                 Foreground="{ThemeResource EqDangerBrush}" />
    </StackPanel>

    <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Spacing="20">
      <controls:EqField Label="{x:Bind services:Loc.Get('Store_Name')}" IsRequired="True"
                        Text="{x:Bind ViewModel.StoreName, Mode=TwoWay}"
                        ErrorText="{x:Bind ViewModel.StoreNameError, Mode=OneWay}" />
      <controls:EqField Label="{x:Bind services:Loc.Get('Store_TaxId')}" IsOptional="True"
                        Text="{x:Bind ViewModel.TaxId, Mode=TwoWay}" />
    </StackPanel>

    <controls:EqField Grid.Row="1" Grid.Column="0" Label="{x:Bind services:Loc.Get('Store_Address')}" IsOptional="True"
                      Text="{x:Bind ViewModel.Address, Mode=TwoWay}" />
    <controls:EqField Grid.Row="1" Grid.Column="1" Label="{x:Bind services:Loc.Get('Store_City')}"
                      Text="{x:Bind ViewModel.City, Mode=TwoWay}" />
    <controls:EqField Grid.Row="1" Grid.Column="2" Label="{x:Bind services:Loc.Get('Store_PostalCode')}"
                      Text="{x:Bind ViewModel.PostalCode, Mode=TwoWay}" />

    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
      <TextBlock Text="{x:Bind services:Loc.Get('Store_Country')}" Style="{StaticResource EqLabelStyle}" />
      <Border Style="{StaticResource EqInputContainerStyle}" Padding="4,0">
        <ComboBox HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                  ItemsSource="{x:Bind ViewModel.Countries}" DisplayMemberPath="Name" SelectedValuePath="Code"
                  SelectedValue="{x:Bind ViewModel.CountryCode, Mode=TwoWay}"
                  PlaceholderText="{x:Bind services:Loc.Get('Store_CountryPlaceholder')}"
                  AutomationProperties.Name="{x:Bind services:Loc.Get('Store_Country')}" />
      </Border>
    </StackPanel>
    <controls:EqField Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Label="{x:Bind services:Loc.Get('Store_Phone')}"
                      IsOptional="True" Text="{x:Bind ViewModel.Phone, Mode=TwoWay}" />

    <controls:EqField Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Label="{x:Bind services:Loc.Get('Store_Email')}"
                      IsOptional="True" Text="{x:Bind ViewModel.Email, Mode=TwoWay}"
                      ErrorText="{x:Bind ViewModel.EmailError, Mode=OneWay}" />

    <!-- Store language: starts as the Welcome choice; used on receipts and labels. -->
    <StackPanel Grid.Row="3" Grid.Column="2" Spacing="6">
      <TextBlock Text="{x:Bind services:Loc.Get('Store_Language')}" Style="{StaticResource EqLabelStyle}" />
      <Border Style="{StaticResource EqInputContainerStyle}" Padding="4,0">
        <ComboBox HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                  SelectedIndex="{x:Bind ViewModel.StoreLanguageIndex, Mode=TwoWay}"
                  AutomationProperties.Name="{x:Bind services:Loc.Get('Store_Language')}">
          <ComboBoxItem Content="{x:Bind services:Loc.Get('Language_English')}" />
          <ComboBoxItem Content="{x:Bind services:Loc.Get('Language_Spanish')}" />
        </ComboBox>
      </Border>
      <TextBlock Text="{x:Bind services:Loc.Get('Store_LanguageHelp')}" Style="{StaticResource EqCaptionStyle}" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
