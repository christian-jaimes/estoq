<UserControl
    x:Class="Estoq.App.Controls.PopupShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Estoq.App.Services">

  <!-- Pop-up shell (design system: dialog, radius-xl): header with title and close, scrolling body, footer actions.
       Every F1 to F4 flow and the product profile reuse this one shell so staff learn one pattern. -->
  <Border Background="{ThemeResource EqSurfaceBrush}" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1"
          CornerRadius="{StaticResource EqRadiusXl}">
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- Header -->
      <!-- Same header as the point of sale: title above subtitle, no icon badge. -->
      <Grid Grid.Row="0" Padding="24,16,16,16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource EqCardTitleStyle}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource EqPlainIconButtonStyle}" VerticalAlignment="Top"
                Click="OnCloseClick" ToolTipService.ToolTip="{x:Bind services:Loc.Get('Popup_CloseTip')}" AutomationProperties.Name="{x:Bind services:Loc.Get('Popup_Close')}">
          <FontIcon Glyph="&#xE5CD;" FontFamily="{StaticResource EqIconFont}" FontSize="24" />
          <Button.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" />
          </Button.KeyboardAccelerators>
        </Button>
      </Grid>

      <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource EqBorderBrush}" />

      <!-- Content is constrained to the popup; longer tables provide their own scrolling. -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" Padding="24">
        <ContentPresenter Content="{x:Bind Body, Mode=OneWay}" />
      </ScrollViewer>

      <!-- Footer: secondary close, then the one gold primary action (design system, Button). -->
      <Rectangle Grid.Row="2" Height="1" VerticalAlignment="Top" Fill="{ThemeResource EqBorderBrush}" />
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Padding="24,16">
        <Button Style="{StaticResource EqSecondaryButtonStyle}" Content="{x:Bind services:Loc.Get('Popup_Close')}" Click="OnCloseClick" />
        <Button Style="{StaticResource EqPrimaryButtonStyle}" Content="{x:Bind PrimaryText, Mode=OneWay}"
                IsEnabled="{x:Bind IsPrimaryEnabled, Mode=OneWay}" Click="OnPrimaryClick" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
