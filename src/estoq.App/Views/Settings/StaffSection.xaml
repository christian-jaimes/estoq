<UserControl
    x:Class="Estoq.App.Views.Settings.StaffSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Estoq.App.Controls"
    xmlns:services="using:Estoq.App.Services"
    xmlns:vm="using:Estoq.App.ViewModels.Settings">

  <StackPanel Spacing="16">
    <!-- Search, status filter and Add staff (mockup 11). -->
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="0" />
        <ColumnDefinition Width="170" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource EqInputContainerStyle}">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.Resources>
            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
          </Grid.Resources>
          <FontIcon Glyph="&#xEF7A;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont2xl}" Foreground="{ThemeResource EqTextSecondaryBrush}" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="{x:Bind services:Loc.Get('Settings_StaffSearch')}" AutomationProperties.Name="{x:Bind services:Loc.Get('Settings_StaffSearch')}" />
        </Grid>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource EqInputContainerStyle}" Padding="4,0">
        <ComboBox HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                  SelectedIndex="{x:Bind ViewModel.StatusFilterIndex, Mode=TwoWay}" AutomationProperties.Name="{x:Bind services:Loc.Get('Settings_StaffStatusFilter')}">
          <ComboBoxItem Content="{x:Bind services:Loc.Get('Settings_StaffAllStatuses')}" />
          <ComboBoxItem Content="{x:Bind services:Loc.Get('Status_Active')}" />
          <ComboBoxItem Content="{x:Bind services:Loc.Get('Status_Inactive')}" />
        </ComboBox>
      </Border>
      <Button Grid.Column="2" Style="{StaticResource EqPrimaryButtonStyle}" Command="{x:Bind ViewModel.AddCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE145;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" />
          <TextBlock Text="{x:Bind services:Loc.Get('Settings_StaffAdd')}" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- A message after a change, for example the new sign-in code to give to the person. -->
    <Border Style="{StaticResource EqCardStyle}" Padding="12,8" Background="{ThemeResource EqGoldTintBrush}" BorderBrush="{ThemeResource EqGoldBrush}"
            Visibility="{x:Bind ViewModel.HasNotice, Mode=OneWay}">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" MinWidth="0" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE88E;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" Foreground="{ThemeResource EqGoldInkBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Notice, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="{StaticResource EqFontMd}" />
        <Button Grid.Column="2" Style="{StaticResource EqPlainIconButtonStyle}" Width="28" Height="28" Command="{x:Bind ViewModel.DismissNoticeCommand}"
                AutomationProperties.Name="{x:Bind services:Loc.Get('Popup_Close')}" ToolTipService.ToolTip="{x:Bind services:Loc.Get('Popup_Close')}">
          <FontIcon Glyph="&#xE5CD;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" />
        </Button>
      </Grid>
    </Border>

    <!-- Add or edit form. -->
    <Border Style="{StaticResource EqCardStyle}" Padding="16" Background="{ThemeResource EqSurfaceElevatedBrush}" Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}">
      <StackPanel Spacing="12">
        <TextBlock Text="{x:Bind ViewModel.FormTitle, Mode=OneWay}" Style="{StaticResource EqCardTitleStyle}" FontSize="{StaticResource EqFontXl}" TextWrapping="Wrap" />
        <Grid ColumnSpacing="16" RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="0" />
            <ColumnDefinition Width="*" MinWidth="0" />
          </Grid.ColumnDefinitions>
          <controls:EqField Label="{x:Bind services:Loc.Get('Settings_FullName')}" IsRequired="True" Text="{x:Bind ViewModel.FormName, Mode=TwoWay}" />
          <controls:EqField Grid.Column="1" Label="{x:Bind services:Loc.Get('Store_Email')}" IsOptional="True" Text="{x:Bind ViewModel.FormEmail, Mode=TwoWay}" />
          <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="{x:Bind services:Loc.Get('Settings_Role')}" Style="{StaticResource EqLabelStyle}" />
            <Border Style="{StaticResource EqInputContainerStyle}" Padding="4,0">
              <ComboBox HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                        ItemsSource="{x:Bind ViewModel.Roles}" DisplayMemberPath="Name" SelectedItem="{x:Bind ViewModel.FormRole, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.CanChangeRole, Mode=OneWay}" AutomationProperties.Name="{x:Bind services:Loc.Get('Settings_Role')}" />
            </Border>
          </StackPanel>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.FormCodeHint, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" TextWrapping="Wrap" VerticalAlignment="Bottom" />
        </Grid>
        <TextBlock Text="{x:Bind ViewModel.FormError, Mode=OneWay}" FontSize="{StaticResource EqFontSm}" TextWrapping="Wrap" Foreground="{ThemeResource EqDangerBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Style="{StaticResource EqSecondaryButtonStyle}" Command="{x:Bind ViewModel.CancelFormCommand}" Content="{x:Bind services:Loc.Get('Settings_Cancel')}" />
          <Button Style="{StaticResource EqPrimaryButtonStyle}" Command="{x:Bind ViewModel.SaveFormCommand}" Content="{x:Bind services:Loc.Get('Settings_StaffSave')}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Table: member, role, status, actions. -->
    <Grid RowDefinitions="Auto,Auto">
      <Grid Grid.Row="0" Style="{StaticResource EqTableHeaderStyle}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="160" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="116" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Settings_StaffMember')}" Style="{StaticResource EqTableHeaderTextStyle}" />
        <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Settings_Role')}" Style="{StaticResource EqTableHeaderTextStyle}" />
        <TextBlock Grid.Column="2" Text="{x:Bind services:Loc.Get('Settings_StaffStatus')}" Style="{StaticResource EqTableHeaderTextStyle}" />
        <TextBlock Grid.Column="3" Text="{x:Bind services:Loc.Get('Settings_StaffActions')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
      </Grid>
      <StackPanel Grid.Row="1">
        <TextBlock Text="{x:Bind services:Loc.Get('Settings_StaffEmpty')}" Style="{StaticResource EqSecondaryStyle}" Margin="12,16" Visibility="{x:Bind ViewModel.HasNoRows, Mode=OneWay}" />
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows}">
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:StaffRowViewModel">
              <Grid Style="{StaticResource EqTableRowStyle}">
                <Border Style="{StaticResource EqTableBandStyle}" Visibility="{x:Bind IsAlternateRow}" />
                <Grid MinHeight="64" Padding="12,7,8,7" ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="116" />
                  </Grid.ColumnDefinitions>
                  <Grid Grid.Column="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" MinWidth="0" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="40" Height="40" VerticalAlignment="Center">
                      <Ellipse Fill="{ThemeResource EqGoldBrush}" />
                      <TextBlock Text="{x:Bind Initials}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontMd}"
                                 Foreground="{ThemeResource EqOnGoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{x:Bind Name}" Style="{StaticResource EqTableCellStrongStyle}" TextAlignment="Left" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Bind Detail}" Style="{StaticResource EqSecondaryStyle}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind HasDetail}" />
                    </StackPanel>
                  </Grid>
                  <!-- Role and status are pills with words, never colour alone. -->
                  <Border Grid.Column="1" Style="{StaticResource EqBadgeStyle}" VerticalAlignment="Center" HorizontalAlignment="Left"
                          Background="{ThemeResource EqSurfaceElevatedBrush}" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1">
                    <TextBlock Text="{x:Bind RoleText}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontSm}" TextTrimming="CharacterEllipsis" />
                  </Border>
                  <Border Grid.Column="2" Style="{StaticResource EqBadgeStyle}" VerticalAlignment="Center" HorizontalAlignment="Left"
                          Background="{ThemeResource EqSurfaceElevatedBrush}" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Width="8" Height="8" Fill="{ThemeResource EqSuccessBrush}" VerticalAlignment="Center" Visibility="{x:Bind IsActive}" />
                      <Ellipse Width="8" Height="8" Fill="{ThemeResource EqDangerBrush}" VerticalAlignment="Center" Visibility="{x:Bind IsInactive}" />
                      <TextBlock Text="{x:Bind StatusText}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontSm}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{x:Bind CanManage}">
                    <Button Style="{StaticResource EqSecondaryButtonStyle}" MinWidth="0" Padding="12,0" Tag="{x:Bind Id}" DataContext="{x:Bind}" Click="OnEditClick"
                            Content="{x:Bind services:Loc.Get('Settings_StaffEdit')}" />
                    <Button Style="{StaticResource EqPlainIconButtonStyle}" DataContext="{x:Bind}" AutomationProperties.Name="{x:Bind services:Loc.Get('Settings_StaffMore')}"
                            ToolTipService.ToolTip="{x:Bind services:Loc.Get('Settings_StaffMore')}">
                      <FontIcon Glyph="&#xE5D4;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont2xl}" />
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuFlyoutItem Text="{x:Bind services:Loc.Get('Settings_StaffRegenerate')}" DataContext="{x:Bind}" Click="OnRegenerateClick" />
                          <MenuFlyoutItem Text="{x:Bind ToggleStatusText}" DataContext="{x:Bind}" Click="OnToggleStatusClick" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                </Grid>
              </Grid>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
