<Page
    x:Class="Estoq.App.Views.Sales.SalesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Estoq.App.Views.Sales"
    xmlns:vm="using:Estoq.App.ViewModels.Sales"
    xmlns:services="using:Estoq.App.Services"
    xmlns:controls="using:Estoq.App.Controls"
    Foreground="{ThemeResource EqTextBrush}">

  <Page.Resources>
    <ResourceDictionary>
    <!-- Borderless text box inside the search container (same overrides as EqField). -->
    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>

    </ResourceDictionary>
  </Page.Resources>

  <!-- Header, KPIs, tabs, filters, table; the sale detail floats over them. A click outside the detail closes it. -->
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Background="Transparent" Tapped="OnPageTapped">

      <!-- Title and actions. -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,0,0,20">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{x:Bind services:Loc.Get('Sales_Title')}" Style="{StaticResource EqPageTitleStyle}" />
          <TextBlock Text="{x:Bind services:Loc.Get('Sales_Subtitle')}" Style="{StaticResource EqSecondaryStyle}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button Style="{StaticResource EqSecondaryButtonStyle}" Command="{x:Bind ViewModel.PrintReportCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xEF6E;" Style="{StaticResource EqIconStyle}" FontSize="18" />
              <TextBlock Text="{x:Bind services:Loc.Get('Sales_PrintReport')}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- The one gold primary of the page. F1 is handled by the shell. -->
          <Button Style="{StaticResource EqPrimaryButtonStyle}" Command="{x:Bind ViewModel.NewSaleCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE145;" Style="{StaticResource EqIconStyle}" FontSize="18" />
              <TextBlock Text="{x:Bind services:Loc.Get('Sales_NewSale')}" VerticalAlignment="Center" />
              <Border CornerRadius="{StaticResource EqRadiusSm}" Padding="6,1" VerticalAlignment="Center"
                      Background="{ThemeResource EqSurfaceBrush}" Opacity="0.85">
                <TextBlock Text="F1" Style="{StaticResource EqLabelStyle}" FontSize="12" Foreground="{ThemeResource EqTextBrush}" />
              </Border>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- One-line status after an export or a print. -->
      <Border Grid.Row="1" Margin="0,0,0,12" Padding="12,8" CornerRadius="{StaticResource EqRadiusMd}"
              Background="{ThemeResource EqGoldTintBrush}" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1"
              Visibility="{x:Bind local:SalesBindings.Visible(ViewModel.HasNotice), Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE88E;" Style="{StaticResource EqIconStyle}" FontSize="18" Foreground="{ThemeResource EqGoldInkBrush}" />
          <TextBlock Text="{x:Bind ViewModel.NoticeText, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}"
                     Foreground="{ThemeResource EqTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- KPI cards: total sales, transactions, items sold, average sale. -->
      <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="16" Margin="0,0,0,20">
        <Border Grid.Column="0" Style="{StaticResource EqCardStyle}" Padding="16">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Grid Width="44" Height="44">
              <Border CornerRadius="{StaticResource EqRadiusMd}" Background="{ThemeResource EqSuccessBrush}" Opacity="0.18" />
              <FontIcon Glyph="&#xEF63;" Style="{StaticResource EqIconStyle}" Foreground="{ThemeResource EqSuccessBrush}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind services:Loc.Get('Sales_KpiTotal')}" Style="{StaticResource EqSecondaryStyle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ViewModel.TotalSalesText, Mode=OneWay}" Style="{StaticResource EqKpiStyle}" FontSize="24" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource EqCardStyle}" Padding="16">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Grid Width="44" Height="44">
              <Border CornerRadius="{StaticResource EqRadiusMd}" Background="{ThemeResource EqGoldBrush}" Opacity="0.18" />
              <FontIcon Glyph="&#xF05B;" Style="{StaticResource EqIconStyle}" Foreground="{ThemeResource EqGoldInkBrush}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind services:Loc.Get('Sales_KpiTransactions')}" Style="{StaticResource EqSecondaryStyle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ViewModel.TransactionsText, Mode=OneWay}" Style="{StaticResource EqKpiStyle}" FontSize="24" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource EqCardStyle}" Padding="16">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Grid Width="44" Height="44">
              <Border CornerRadius="{StaticResource EqRadiusMd}" Background="{ThemeResource EqInfoBrush}" Opacity="0.18" />
              <FontIcon Glyph="&#xE8CC;" Style="{StaticResource EqIconStyle}" Foreground="{ThemeResource EqInfoBrush}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind services:Loc.Get('Sales_KpiItems')}" Style="{StaticResource EqSecondaryStyle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ViewModel.ItemsSoldText, Mode=OneWay}" Style="{StaticResource EqKpiStyle}" FontSize="24" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="3" Style="{StaticResource EqCardStyle}" Padding="16">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Grid Width="44" Height="44">
              <Border CornerRadius="{StaticResource EqRadiusMd}" Background="{ThemeResource EqGoldBrush}" Opacity="0.18" />
              <FontIcon Glyph="&#xEF6E;" Style="{StaticResource EqIconStyle}" Foreground="{ThemeResource EqGoldInkBrush}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind services:Loc.Get('Sales_KpiAverage')}" Style="{StaticResource EqSecondaryStyle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ViewModel.AverageSaleText, Mode=OneWay}" Style="{StaticResource EqKpiStyle}" FontSize="24" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- Period tabs. -->
      <Border Grid.Row="3" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,16">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PeriodTabViewModel">
              <RadioButton GroupName="SalesPeriod" Style="{StaticResource EqTabStyle}" Content="{x:Bind Label}"
                           IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- Toolbar (same as Inventory): sort | date filter, filters | search | clear all. -->
      <Border Grid.Row="4" Style="{StaticResource EqCardStyle}" Padding="12,10" Margin="0,0,0,16">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Sort -->
          <Button Grid.Column="0" Style="{StaticResource EqFilterButtonStyle}" Width="172"
                  Click="OnSortClick" AutomationProperties.Name="{x:Bind services:Loc.Get('Sales_SortBy')}"
                  ToolTipService.ToolTip="{x:Bind services:Loc.Get('Sales_SortBy')}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <FontIcon Glyph="&#xE152;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SortLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <FontIcon Grid.Column="2" Glyph="&#xE313;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Grid.Column="1" Style="{StaticResource EqSecondaryButtonStyle}" Width="40" MinWidth="0" Padding="0"
                  Command="{x:Bind ViewModel.ToggleSortDirectionCommand}"
                  ToolTipService.ToolTip="{x:Bind ViewModel.SortDirectionToolTip, Mode=OneWay}"
                  AutomationProperties.Name="{x:Bind ViewModel.SortDirectionToolTip, Mode=OneWay}">
            <FontIcon Glyph="{x:Bind ViewModel.SortDirectionGlyph, Mode=OneWay}" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" />
          </Button>

          <Border Grid.Column="2" Width="1" Height="24" Background="{ThemeResource EqBorderBrush}" Margin="4,0" VerticalAlignment="Center" />

          <!-- Date filter: editing either date switches the period to Custom. -->
          <Button Grid.Column="3" Style="{StaticResource EqFilterButtonStyle}" Width="190"
                  AutomationProperties.Name="{x:Bind services:Loc.Get('Sales_DateRange')}"
                  ToolTipService.ToolTip="{x:Bind services:Loc.Get('Sales_DateRange')}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <FontIcon Glyph="&#xE935;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DateRangeText, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <FontIcon Grid.Column="2" Glyph="&#xE313;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" VerticalAlignment="Center" />
            </Grid>
            <Button.Flyout>
              <Flyout>
                <StackPanel Spacing="12" MinWidth="240">
                  <CalendarDatePicker Header="{x:Bind services:Loc.Get('Sales_From')}" HorizontalAlignment="Stretch"
                                      Date="{x:Bind ViewModel.CustomFromDate, Mode=TwoWay}" />
                  <CalendarDatePicker Header="{x:Bind services:Loc.Get('Sales_To')}" HorizontalAlignment="Stretch"
                                      Date="{x:Bind ViewModel.CustomToDate, Mode=TwoWay}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- Filters -->
          <Button Grid.Column="4" Style="{StaticResource EqFilterButtonStyle}" Width="176"
                  Click="OnMethodClick" AutomationProperties.Name="{x:Bind services:Loc.Get('Sales_ColMethod')}"
                  ToolTipService.ToolTip="{x:Bind services:Loc.Get('Sales_ColMethod')}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{x:Bind ViewModel.MethodLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <FontIcon Grid.Column="1" Glyph="&#xE313;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Grid.Column="5" Style="{StaticResource EqFilterButtonStyle}" Width="176"
                  Click="OnStaffClick" AutomationProperties.Name="{x:Bind services:Loc.Get('Sales_ColStaff')}"
                  ToolTipService.ToolTip="{x:Bind services:Loc.Get('Sales_ColStaff')}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{x:Bind ViewModel.StaffLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <FontIcon Grid.Column="1" Glyph="&#xE313;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Border Grid.Column="6" Width="1" Height="24" Background="{ThemeResource EqBorderBrush}" Margin="4,0" VerticalAlignment="Center" />

          <!-- Search -->
          <Border Grid.Column="7" MinWidth="140" Height="36" Background="{ThemeResource EqBgBrush}" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource EqRadiusMd}" Padding="12,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <FontIcon Glyph="&#xEF7A;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont2xl}"
                        Foreground="{ThemeResource EqTextSecondaryBrush}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" VerticalAlignment="Center" MinHeight="0" Padding="0,6"
                       FontFamily="{StaticResource EqUiFont}" FontSize="{StaticResource EqFontMd}"
                       PlaceholderText="{x:Bind services:Loc.Get('Sales_SearchPlaceholder')}"
                       Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="{x:Bind services:Loc.Get('Sales_SearchPlaceholder')}" />
            </Grid>
          </Border>

          <!-- Clear all -->
          <HyperlinkButton Grid.Column="8" Content="{x:Bind services:Loc.Get('Sales_ClearAll')}" Style="{StaticResource EqLinkButtonStyle}" VerticalAlignment="Center"
                           Command="{x:Bind ViewModel.ClearFiltersCommand}"
                           Visibility="{x:Bind local:SalesBindings.Visible(ViewModel.HasActiveFilters), Mode=OneWay}" />
        </Grid>
      </Border>

      <!-- Table card (docs/technical/ui-implementation.md, "Full-bleed table in a card"): header, scrolling rows loaded on scroll, footer. -->
      <Border Grid.Row="5" Style="{StaticResource EqCardStyle}" Padding="0">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

          <Grid Grid.Row="0" Style="{StaticResource EqTableHeaderStyle}" Padding="20,0,20,0" CornerRadius="12,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" MinWidth="150" />
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Sales_ColReceipt')}" Style="{StaticResource EqTableHeaderTextStyle}" />
            <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Sales_ColDate')}" Style="{StaticResource EqTableHeaderTextStyle}" />
            <TextBlock Grid.Column="2" Text="{x:Bind services:Loc.Get('Sales_ColStaff')}" Style="{StaticResource EqTableHeaderTextStyle}" />
            <TextBlock Grid.Column="3" Text="{x:Bind services:Loc.Get('Sales_ColMethod')}" Style="{StaticResource EqTableHeaderTextStyle}" />
            <TextBlock Grid.Column="4" Text="{x:Bind services:Loc.Get('Sales_ColStatus')}" Style="{StaticResource EqTableHeaderTextStyle}" />
            <TextBlock Grid.Column="5" Text="{x:Bind services:Loc.Get('Sales_ColItems')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="6" Text="{x:Bind services:Loc.Get('Sales_ColTotal')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="7" Text="{x:Bind services:Loc.Get('Sales_ColTax')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
          </Grid>

          <ScrollViewer x:Name="TableScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        ViewChanged="OnTableViewChanged" SizeChanged="OnTableSizeChanged">
            <Grid>
              <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SaleRowViewModel">
                    <Grid MinHeight="64" Background="Transparent" Style="{StaticResource EqTableRowStyle}" Tapped="OnRowTapped"
                          PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited">
                      <Border Style="{StaticResource EqTableBandStyle}"
                              Visibility="{x:Bind local:SalesBindings.Visible(IsAlternateRow)}" />
                      <Border x:Name="HoverFill" Background="{ThemeResource EqHoverFillBrush}" IsHitTestVisible="False" Opacity="0">
                        <Border.OpacityTransition>
                          <ScalarTransition Duration="0:0:0.1" />
                        </Border.OpacityTransition>
                      </Border>
                      <Border Background="{ThemeResource EqGoldTintBrush}" IsHitTestVisible="False"
                              Visibility="{x:Bind local:SalesBindings.Visible(IsSelected), Mode=OneWay}" />
                      <Grid Padding="20,8,20,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="*" MinWidth="150" />
                          <ColumnDefinition Width="140" />
                          <ColumnDefinition Width="180" />
                          <ColumnDefinition Width="140" />
                          <ColumnDefinition Width="70" />
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="100" />
                          <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{x:Bind ReceiptNumber}" Style="{StaticResource EqTableCellStrongStyle}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Bind DateText}" Style="{StaticResource EqTableCellStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{x:Bind StaffText}" Style="{StaticResource EqTableCellStyle}" TextTrimming="CharacterEllipsis" />

                        <!-- Payment method badge: icon or brand letter, then the name. -->
                        <Border Grid.Column="3" Height="28" CornerRadius="14" Padding="12,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{ThemeResource EqSurfaceElevatedBrush}" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1">
                          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind MethodGlyph}" Style="{StaticResource EqIconStyle}" FontSize="16"
                                      Foreground="{ThemeResource EqGoldInkBrush}" VerticalAlignment="Center"
                                      Visibility="{x:Bind local:SalesBindings.Visible(HasMethodGlyph)}" />
                            <Border Width="16" Height="16" CornerRadius="8" VerticalAlignment="Center" Background="{x:Bind MethodBrandBrush}"
                                    Visibility="{x:Bind local:SalesBindings.Visible(HasMethodBrand)}">
                              <TextBlock Text="{x:Bind MethodBrandLetter}" FontSize="10" Foreground="White"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{x:Bind MethodText}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontSm}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>

                        <!-- Status: the shared StatusBadge (dot plus words). -->
                        <controls:StatusBadge Grid.Column="4" Kind="{x:Bind StatusKind}" Text="{x:Bind StatusText}" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="5" Text="{x:Bind ItemsText}" Style="{StaticResource EqTableCellStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="6" Text="{x:Bind TotalText}" Style="{StaticResource EqTableCellStrongStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="7" Text="{x:Bind TaxText}" Style="{StaticResource EqTableCellStyle}" HorizontalAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                        <Button Grid.Column="8" Style="{StaticResource EqPlainIconButtonStyle}" Width="32" Height="32"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRowMenuClick"
                                AutomationProperties.Name="{x:Bind services:Loc.Get('Sales_RowActions')}">
                          <FontIcon Glyph="&#xE5D4;" Style="{StaticResource EqIconStyle}" FontSize="20" />
                        </Button>
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Nothing to list -->
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Padding="0,40"
                          Visibility="{x:Bind local:SalesBindings.Visible(ViewModel.IsEmpty), Mode=OneWay}">
                <FontIcon Glyph="&#xE1A1;" FontFamily="{StaticResource EqIconFont}" FontSize="32" Foreground="{ThemeResource EqTextSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind services:Loc.Get('Sales_Empty')}" Style="{StaticResource EqSecondaryStyle}" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </ScrollViewer>

          <!-- Footer: count of loaded rows on the left, Export of the filtered sales on the right. -->
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Style="{StaticResource EqTableFooterStyle}">
            <TextBlock Text="{x:Bind ViewModel.FooterText, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Style="{StaticResource EqSecondaryButtonStyle}" Content="{x:Bind services:Loc.Get('Sales_Export')}"
                    Command="{x:Bind ViewModel.ExportCommand}"
                    Visibility="{x:Bind local:SalesBindings.Visible(ViewModel.CanExport)}" />
          </Grid>
        </Grid>
      </Border>

    <!-- Sale detail: only after a row is clicked, floating over the table (same behaviour as the Inventory detail). A click on another row updates it; a click outside closes it. -->
    <Border x:Name="DetailPanel" Grid.Row="0" Grid.RowSpan="6" Style="{StaticResource EqDetailPanelStyle}">
      <!-- Slides in from the right and back out; see SetPanel in the code-behind. -->
      <Border.RenderTransform>
        <CompositeTransform x:Name="DetailTransform" />
      </Border.RenderTransform>
      <Grid RowDefinitions="*,Auto" RowSpacing="16">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16" Padding="0,0,4,0">

            <!-- Receipt number, status badge, date, staff. -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
              <TextBlock Text="{x:Bind ViewModel.DetailReceipt, Mode=OneWay}" Style="{StaticResource EqCardTitleStyle}" FontSize="22"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <controls:StatusBadge Grid.Column="1" Kind="{x:Bind ViewModel.DetailStatusKind, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.DetailStatusText, Mode=OneWay}" VerticalAlignment="Center" />
              <Button Grid.Column="2" Style="{StaticResource EqPlainIconButtonStyle}" VerticalAlignment="Top"
                      Command="{x:Bind ViewModel.CloseDetailCommand}"
                      AutomationProperties.Name="{x:Bind services:Loc.Get('Popup_Close')}"
                      ToolTipService.ToolTip="{x:Bind services:Loc.Get('Popup_Close')}">
                <FontIcon Glyph="&#xE5CD;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont4xl}" />
              </Button>
            </Grid>

            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE935;" Style="{StaticResource EqIconStyle}" FontSize="18" Foreground="{ThemeResource EqTextSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.DetailDateText, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" Foreground="{ThemeResource EqTextBrush}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xF0D3;" Style="{StaticResource EqIconStyle}" FontSize="18" Foreground="{ThemeResource EqTextSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.DetailStaffText, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" Foreground="{ThemeResource EqTextBrush}" />
              </StackPanel>
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource EqBorderBrush}" />

            <!-- Items: a small table without a header row (the only table that has none). Product (name, SKU below), unit price, quantity, line total. -->
            <TextBlock Text="{x:Bind ViewModel.DetailItemsHeader, Mode=OneWay}" Style="{StaticResource EqCardTitleStyle}" FontSize="16" />
            <StackPanel Spacing="0">
              <ItemsControl ItemsSource="{x:Bind ViewModel.DetailLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SaleDetailLineViewModel">
                    <Grid Style="{StaticResource EqTableRowStyle}" Padding="8,8" ColumnSpacing="8" ColumnDefinitions="*,76,48,80">
                      <Border Grid.ColumnSpan="4" Margin="-8,-8" Style="{StaticResource EqTableBandStyle}"
                              Visibility="{x:Bind local:SalesBindings.Visible(IsAlternateRow)}" />
                      <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource EqTableCellStrongStyle}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Sku}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{x:Bind PriceText}" Style="{StaticResource EqTableCellStyle}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{x:Bind QuantityText}" Style="{StaticResource EqTableCellStyle}" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="3" Text="{x:Bind TotalText}" Style="{StaticResource EqTableCellStrongStyle}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource EqBorderBrush}" />

            <!-- Totals. -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
              <TextBlock Grid.Row="0" Text="{x:Bind services:Loc.Get('Sales_Subtotal')}" Style="{StaticResource EqSecondaryStyle}" Foreground="{ThemeResource EqTextBrush}" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.DetailSubtotalText, Mode=OneWay}" HorizontalAlignment="Right" />
              <TextBlock Grid.Row="1" Text="{x:Bind services:Loc.Get('Sales_Discount')}" Style="{StaticResource EqSecondaryStyle}" Foreground="{ThemeResource EqTextBrush}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DetailDiscountText, Mode=OneWay}" HorizontalAlignment="Right" />
              <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.DetailTaxLabel, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" Foreground="{ThemeResource EqTextBrush}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.DetailTaxText, Mode=OneWay}" HorizontalAlignment="Right" />
            </Grid>

            <Rectangle Height="1" Fill="{ThemeResource EqBorderBrush}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="{x:Bind services:Loc.Get('Sales_Total')}" Style="{StaticResource EqCardTitleStyle}" FontSize="20" />
              <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DetailTotalText, Mode=OneWay}" Style="{StaticResource EqCardTitleStyle}" FontSize="20" />
            </Grid>

            <!-- Payments: each in its own currency, with the rate snapshot when it is not the base currency. -->
            <TextBlock Text="{x:Bind services:Loc.Get('Sales_Payments')}" Style="{StaticResource EqCardTitleStyle}" FontSize="16" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.DetailPayments}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SalePaymentViewModel">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel>
                      <TextBlock Text="{x:Bind MethodText}" FontSize="13" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Bind RateText}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis"
                                 Visibility="{x:Bind local:SalesBindings.Visible(HasRate)}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Bind AmountText}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="13"
                               VerticalAlignment="Top" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- F8 prints the receipt wherever focus is on this page. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <Button Style="{StaticResource EqSecondaryButtonStyle}" HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.PrintReceiptCommand}">
            <Button.KeyboardAccelerators>
              <KeyboardAccelerator Key="F8" />
            </Button.KeyboardAccelerators>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xEF6E;" Style="{StaticResource EqIconStyle}" FontSize="18" Foreground="{ThemeResource EqGoldInkBrush}" />
              <TextBlock Text="{x:Bind services:Loc.Get('Sales_PrintReceiptF8')}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Style="{StaticResource EqSecondaryButtonStyle}" MinWidth="40" Width="40" Padding="0"
                  Click="OnDetailMenuClick" AutomationProperties.Name="{x:Bind services:Loc.Get('Sales_MoreActions')}">
            <FontIcon Glyph="&#xE5D3;" Style="{StaticResource EqIconStyle}" FontSize="20" />
          </Button>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Page>
