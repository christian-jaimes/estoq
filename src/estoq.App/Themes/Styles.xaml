<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Default text: Manrope, primary text colour. -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource EqUiFont}" />
  </Style>

  <Style x:Key="EqPageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource EqBrandFont}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="LineHeight" Value="34" />
    <Setter Property="Foreground" Value="{ThemeResource EqTextBrush}" />
  </Style>
  <Style x:Key="EqCardTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource EqBrandFont}" />
    <Setter Property="FontSize" Value="{StaticResource EqFont2xl}" />
    <Setter Property="Foreground" Value="{ThemeResource EqTextBrush}" />
  </Style>
  <Style x:Key="EqLabelStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource EqUiFontSemiBold}" />
    <Setter Property="FontSize" Value="{StaticResource EqFontMd}" />
  </Style>
  <Style x:Key="EqSecondaryStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource EqUiFont}" />
    <Setter Property="FontSize" Value="{StaticResource EqFontSm}" />
    <Setter Property="Foreground" Value="{ThemeResource EqTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="EqCaptionStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource EqUiFont}" />
    <Setter Property="FontSize" Value="{StaticResource EqFontXs}" />
    <Setter Property="Foreground" Value="{ThemeResource EqTextSecondaryBrush}" />
  </Style>
  <Style x:Key="EqKpiStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource EqUiFontSemiBold}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="Foreground" Value="{ThemeResource EqTextBrush}" />
  </Style>

  <!-- Material Symbols Rounded icon (glyph code from Assets/Fonts/codepoints.txt). -->
  <Style x:Key="EqIconStyle" TargetType="FontIcon">
    <Setter Property="FontFamily" Value="{StaticResource EqIconFont}" />
    <Setter Property="FontSize" Value="{StaticResource EqFont4xl}" />
  </Style>

  <Style x:Key="EqCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource EqSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource EqBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource EqRadiusLg}" />
    <Setter Property="Padding" Value="24" />
  </Style>

  <!-- Table standard (design system, Table): every table in the app shares this look. Only the cells differ.
       Header: 44 px rounded bar on the elevated surface, semibold 13 px titles. Rows: hairline divider, every second
       row banded. Set ColumnDefinitions on the header and the row content so the columns line up; the header and row
       content use the same 12 px start and 8 px end padding. -->
  <Style x:Key="EqTableHeaderStyle" TargetType="Grid">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="12,0,8,0" />
    <Setter Property="ColumnSpacing" Value="8" />
    <Setter Property="CornerRadius" Value="{StaticResource EqRadiusMd}" />
    <Setter Property="Background" Value="{ThemeResource EqSurfaceElevatedBrush}" />
  </Style>

  <Style x:Key="EqTableHeaderTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource EqUiFontSemiBold}" />
    <Setter Property="FontSize" Value="{StaticResource EqFontSm}" />
    <Setter Property="Foreground" Value="{ThemeResource EqTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Row container: put a EqTableBandStyle border first (visible on every second row), then the row content. -->
  <Style x:Key="EqTableRowStyle" TargetType="Grid">
    <Setter Property="BorderBrush" Value="{ThemeResource EqBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style x:Key="EqTableBandStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource EqBgBrush}" />
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style x:Key="EqTableCellStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource EqUiFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{ThemeResource EqTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="EqTableCellStrongStyle" TargetType="TextBlock" BasedOn="{StaticResource EqTableCellStyle}">
    <Setter Property="FontFamily" Value="{StaticResource EqUiFontSemiBold}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <!-- Round 40px icon button: shortcuts and quick actions (design system, IconButton round). -->
  <Style x:Key="EqRoundIconButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{ThemeResource EqGoldInkBrush}" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EqGoldInkBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="{ThemeResource EqSurfaceBrush}" BorderBrush="{ThemeResource EqBorderBrush}"
                BorderThickness="1" CornerRadius="20">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource EqHoverFillBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource EqGoldBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource EqGoldPressedBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource EqGoldPressedBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource EqOnGoldBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Plain 36px icon button: toolbars, theme toggle, notifications, settings (design system, IconButton plain). -->
  <Style x:Key="EqPlainIconButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{ThemeResource EqTextSecondaryBrush}" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EqGoldInkBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent" CornerRadius="{StaticResource EqRadiusMd}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource EqHoverFillBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource EqTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource EqHoverFillBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource EqTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 24px circle that floats on the sidebar's right border (design system, Sidebar collapse). -->
  <Style x:Key="EqSidebarCollapseButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{ThemeResource EqTextSecondaryBrush}" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EqGoldInkBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="{ThemeResource EqSurfaceBrush}" BorderBrush="{ThemeResource EqBorderBrush}"
                BorderThickness="1" CornerRadius="12">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource EqHoverFillBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource EqTextSecondaryBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource EqTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource EqHoverFillBrush}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource EqTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Link-style text button ("View all"). -->
  <Style x:Key="EqLinkButtonStyle" TargetType="HyperlinkButton">
    <Setter Property="Foreground" Value="{ThemeResource EqGoldInkBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource EqUiFontSemiBold}" />
    <Setter Property="FontSize" Value="{StaticResource EqFontSm}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <!-- Sidebar navigation item: 36px, radius sm; active = elevated surface + 3px gold indicator (design system, Sidebar). -->
  <Style x:Key="EqNavItemStyle" TargetType="RadioButton">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{ThemeResource EqTextBrush}" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EqGoldInkBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualMargin" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent" CornerRadius="6"
                MinHeight="{TemplateBinding MinHeight}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource EqHoverFillBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource EqHoverFillBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource EqHoverFillBrush}" />
                    <Setter Target="Indicator.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Rectangle x:Name="Indicator" Visibility="Collapsed" Width="3" RadiusX="2" RadiusY="2"
                       HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,8,0,8"
                       Fill="{ThemeResource EqGoldBrush}" />
            <ContentPresenter VerticalAlignment="Center"
                              Padding="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text input container used by the top bar search (design system, Input). -->
  <Style x:Key="EqInputContainerStyle" TargetType="Border">
    <Setter Property="Height" Value="36" />
    <Setter Property="Background" Value="{ThemeResource EqSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource EqBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource EqRadiusMd}" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <Style x:Key="EqAutoSuggestTextBoxStyle" TargetType="TextBox">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextAlignment" Value="Left" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{ThemeResource EqTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource EqUiFont}" />
    <Setter Property="FontSize" Value="{StaticResource EqFontMd}" />
  </Style>

  <Style x:Key="EqAutoSuggestBoxStyle" TargetType="AutoSuggestBox">
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{ThemeResource EqTextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="TextBoxStyle" Value="{StaticResource EqAutoSuggestTextBoxStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="AutoSuggestBox">
          <Grid x:Name="LayoutRoot">
            <TextBox x:Name="TextBox" Style="{TemplateBinding TextBoxStyle}"
                     PlaceholderText="{TemplateBinding PlaceholderText}"
                     Header="{TemplateBinding Header}" Width="{TemplateBinding Width}"
                     Description="{TemplateBinding Description}"
                     Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}"
                     BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                     FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"
                     FontWeight="{TemplateBinding FontWeight}" FontStretch="{TemplateBinding FontStretch}"
                     VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                     HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                     ScrollViewer.BringIntoViewOnFocusChange="False" Canvas.ZIndex="0" Margin="0"
                     DesiredCandidateWindowAlignment="BottomEdge" UseSystemFocusVisuals="{TemplateBinding UseSystemFocusVisuals}"
                     CornerRadius="{TemplateBinding CornerRadius}" />
            <Popup x:Name="SuggestionsPopup" ShouldConstrainToRootBounds="False">
              <Border x:Name="SuggestionsContainer" Padding="{ThemeResource AutoSuggestListMargin}"
                      Margin="0,-8,0,0"
                      BorderThickness="1,0,1,1"
                      BorderBrush="{ThemeResource AutoSuggestBoxSuggestionsListBorderBrush}"
                      Background="{ThemeResource EqSurfaceBrush}"
                      CornerRadius="0,0,8,8">
                <Border.RenderTransform />
                <ListView x:Name="SuggestionsList" DisplayMemberPath="{TemplateBinding DisplayMemberPath}"
                          IsItemClickEnabled="True" ItemTemplate="{TemplateBinding ItemTemplate}"
                          ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                          ItemContainerStyle="{TemplateBinding ItemContainerStyle}"
                          MaxHeight="{TemplateBinding MaxSuggestionListHeight}"
                          Margin="{ThemeResource AutoSuggestListPadding}">
                  <ListView.ItemContainerTransitions />
                </ListView>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text buttons (design system, Button): one gold primary per view, secondary for the rest. -->
  <Style x:Key="EqPrimaryButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="88" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontFamily" Value="{StaticResource EqUiFontSemiBold}" />
    <Setter Property="FontSize" Value="{StaticResource EqFontMd}" />
    <Setter Property="Foreground" Value="{ThemeResource EqOnGoldBrush}" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EqGoldInkBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="{ThemeResource EqGoldBrush}" BorderBrush="Transparent" BorderThickness="1"
                CornerRadius="{StaticResource EqRadiusMd}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource EqGoldHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource EqGoldPressedBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter Padding="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                              FontSize="{TemplateBinding FontSize}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="EqSecondaryButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="88" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontFamily" Value="{StaticResource EqUiFontSemiBold}" />
    <Setter Property="FontSize" Value="{StaticResource EqFontMd}" />
    <Setter Property="Foreground" Value="{ThemeResource EqTextBrush}" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EqGoldInkBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="{ThemeResource EqSurfaceBrush}" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource EqRadiusMd}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource EqHoverFillBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource EqGoldBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource EqHoverFillBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource EqGoldBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter Padding="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                              FontSize="{TemplateBinding FontSize}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Pill used for stock status words. -->
  <Style x:Key="EqBadgeStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource EqRadiusPill}" />
    <Setter Property="Padding" Value="10,3" />
  </Style>

  <!-- Notifications pop-up surface: elevated, 1px border, radius-lg (design system, NotificationPanel). -->
  <Style x:Key="EqNotificationFlyoutStyle" TargetType="FlyoutPresenter">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MaxWidth" Value="420" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{ThemeResource EqSurfaceElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource EqBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
</ResourceDictionary>
