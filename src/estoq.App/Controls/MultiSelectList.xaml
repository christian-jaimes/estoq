<UserControl
    x:Class="Estoq.App.Controls.MultiSelectList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Estoq.App.Services">

  <!-- Content of a multi-select dropdown: a search field on top, then a fixed-height scrolling list of checkboxes. -->
  <StackPanel Spacing="8">
    <Border Height="36" Background="{ThemeResource EqBgBrush}" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1"
            CornerRadius="{StaticResource EqRadiusMd}" Padding="10,0">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <FontIcon Glyph="&#xEF7A;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}"
                  Foreground="{ThemeResource EqTextSecondaryBrush}" VerticalAlignment="Center" />
        <TextBox x:Name="SearchBox" Grid.Column="1" VerticalAlignment="Center"
                 PlaceholderText="{x:Bind services:Loc.Get('Inventory_FilterSearch')}"
                 AutomationProperties.Name="{x:Bind services:Loc.Get('Inventory_FilterSearch')}"
                 Background="Transparent" BorderThickness="0" MinHeight="0" Padding="0,6"
                 FontFamily="{StaticResource EqUiFont}" FontSize="{StaticResource EqFontMd}"
                 TextChanged="OnSearchChanged">
          <TextBox.Resources>
            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
          </TextBox.Resources>
        </TextBox>
      </Grid>
    </Border>

    <!-- Fixed height: a long list scrolls instead of growing the dropdown. -->
    <ScrollViewer MaxHeight="264" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="ItemsHost" Spacing="0" />
    </ScrollViewer>

    <TextBlock x:Name="NoMatches" Text="{x:Bind services:Loc.Get('Inventory_FilterNoMatches')}" Style="{StaticResource EqSecondaryStyle}"
               Margin="8,4" Visibility="Collapsed" />
  </StackPanel>
</UserControl>
