<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Design tokens from Branding/estoq design system.md (v1.1). Components read tokens only; never hard-code a hex. -->

  <!-- Gold replaces the Windows accent colour for stock controls (focus, selection, toggles). -->
  <Color x:Key="SystemAccentColor">#D6B77A</Color>
  <Color x:Key="SystemAccentColorLight1">#E2C995</Color>
  <Color x:Key="SystemAccentColorLight2">#E2C995</Color>
  <Color x:Key="SystemAccentColorLight3">#E2C995</Color>
  <Color x:Key="SystemAccentColorDark1">#B99A5E</Color>
  <Color x:Key="SystemAccentColorDark2">#B99A5E</Color>
  <Color x:Key="SystemAccentColorDark3">#9C7B40</Color>

  <!-- Radius: sm 6, md 8, lg 12, xl 16. -->
  <CornerRadius x:Key="EqRadiusSm">6</CornerRadius>
  <CornerRadius x:Key="EqRadiusMd">8</CornerRadius>
  <CornerRadius x:Key="EqRadiusLg">12</CornerRadius>
  <CornerRadius x:Key="EqRadiusXl">16</CornerRadius>
  <CornerRadius x:Key="EqRadiusPill">999</CornerRadius>

  <!-- Spacing (8px based). -->
  <x:Double x:Key="EqSpace4">4</x:Double>
  <x:Double x:Key="EqSpace8">8</x:Double>
  <x:Double x:Key="EqSpace12">12</x:Double>
  <x:Double x:Key="EqSpace16">16</x:Double>
  <x:Double x:Key="EqSpace24">24</x:Double>
  <x:Double x:Key="EqSpace32">32</x:Double>
  <x:Double x:Key="EqSidebarWidth">240</x:Double>
  <x:Double x:Key="EqSidebarCollapsedWidth">64</x:Double>
  <x:Double x:Key="EqTopBarHeight">56</x:Double>
  <x:Double x:Key="EqControlHeight">36</x:Double>

  <!-- Typography: Poppins for headings, Manrope for the working UI (bundled under Assets/Fonts). -->
  <FontFamily x:Key="EqUiFont">ms-appx:///Assets/Fonts/Manrope-Regular.ttf#Manrope, Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="EqUiFontMedium">ms-appx:///Assets/Fonts/Manrope-Medium.ttf#Manrope Medium, Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="EqUiFontSemiBold">ms-appx:///Assets/Fonts/Manrope-SemiBold.ttf#Manrope SemiBold, Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="EqBrandFont">ms-appx:///Assets/Fonts/Poppins-SemiBold.ttf#Poppins SemiBold, Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="EqIconFont">ms-appx:///Assets/Fonts/MaterialSymbolsRounded.ttf#Material Symbols Rounded</FontFamily>
  <FontFamily x:Key="EqIconFontFilled">ms-appx:///Assets/Fonts/MaterialSymbolsRoundedFilled.ttf#Material Symbols Rounded Filled</FontFamily>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="EqGoldInk">#9C7B40</Color>
      <Color x:Key="EqGoldHover">#E2C995</Color>
      <SolidColorBrush x:Key="EqBgBrush" Color="#F1EFE9" />
      <SolidColorBrush x:Key="EqSurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="EqSurfaceElevatedBrush" Color="#FAF9F6" />
      <SolidColorBrush x:Key="EqTextBrush" Color="#24262A" />
      <SolidColorBrush x:Key="EqTextSecondaryBrush" Color="#777A80" />
      <SolidColorBrush x:Key="EqBorderBrush" Color="#DFDDD6" />
      <SolidColorBrush x:Key="EqGoldBrush" Color="#D6B77A" />
      <SolidColorBrush x:Key="EqGoldHoverBrush" Color="#E2C995" />
      <SolidColorBrush x:Key="EqGoldPressedBrush" Color="#B99A5E" />
      <SolidColorBrush x:Key="EqGoldInkBrush" Color="#9C7B40" />
      <SolidColorBrush x:Key="EqOnGoldBrush" Color="#17191C" />
      <SolidColorBrush x:Key="EqGoldTintBrush" Color="#F9F5EC" />
      <SolidColorBrush x:Key="EqSuccessBrush" Color="#43876A" />
      <SolidColorBrush x:Key="EqWarningBrush" Color="#C18B42" />
      <SolidColorBrush x:Key="EqDangerBrush" Color="#C45D58" />
      <SolidColorBrush x:Key="EqInfoBrush" Color="#5C83A8" />
      <SolidColorBrush x:Key="EqChart1Brush" Color="#C4912A" />
      <SolidColorBrush x:Key="EqChart2Brush" Color="#2563D9" />
      <SolidColorBrush x:Key="EqChart3Brush" Color="#D6338A" />
      <SolidColorBrush x:Key="EqChart4Brush" Color="#3838B8" />
      <SolidColorBrush x:Key="EqChartMutedBrush" Color="#C9C7C0" />
      <x:Double x:Key="EqCardShadowOpacity">0.06</x:Double>
      <SolidColorBrush x:Key="EqScrimBrush" Color="#8C141619" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="EqGoldInk">#D6B77A</Color>
      <Color x:Key="EqGoldHover">#E2C995</Color>
      <SolidColorBrush x:Key="EqBgBrush" Color="#141619" />
      <SolidColorBrush x:Key="EqSurfaceBrush" Color="#1C2023" />
      <SolidColorBrush x:Key="EqSurfaceElevatedBrush" Color="#282C31" />
      <SolidColorBrush x:Key="EqTextBrush" Color="#F1EFE9" />
      <SolidColorBrush x:Key="EqTextSecondaryBrush" Color="#A9AAAD" />
      <SolidColorBrush x:Key="EqBorderBrush" Color="#33373D" />
      <SolidColorBrush x:Key="EqGoldBrush" Color="#D6B77A" />
      <SolidColorBrush x:Key="EqGoldHoverBrush" Color="#E2C995" />
      <SolidColorBrush x:Key="EqGoldPressedBrush" Color="#B99A5E" />
      <SolidColorBrush x:Key="EqGoldInkBrush" Color="#D6B77A" />
      <SolidColorBrush x:Key="EqOnGoldBrush" Color="#17191C" />
      <SolidColorBrush x:Key="EqGoldTintBrush" Color="#2F2F2C" />
      <SolidColorBrush x:Key="EqSuccessBrush" Color="#43876A" />
      <SolidColorBrush x:Key="EqWarningBrush" Color="#C18B42" />
      <SolidColorBrush x:Key="EqDangerBrush" Color="#C45D58" />
      <SolidColorBrush x:Key="EqInfoBrush" Color="#5C83A8" />
      <SolidColorBrush x:Key="EqChart1Brush" Color="#BC8A26" />
      <SolidColorBrush x:Key="EqChart2Brush" Color="#3B82F6" />
      <SolidColorBrush x:Key="EqChart3Brush" Color="#E0509E" />
      <SolidColorBrush x:Key="EqChart4Brush" Color="#8B7BFF" />
      <SolidColorBrush x:Key="EqChartMutedBrush" Color="#4A4F57" />
      <x:Double x:Key="EqCardShadowOpacity">0.30</x:Double>
      <SolidColorBrush x:Key="EqScrimBrush" Color="#B3000000" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <StaticResource x:Key="EqGoldInk" ResourceKey="SystemColorHighlightColor" />
      <StaticResource x:Key="EqGoldHover" ResourceKey="SystemColorHighlightColor" />
      <SolidColorBrush x:Key="EqBgBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="EqSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="EqSurfaceElevatedBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="EqTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="EqTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="EqBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="EqGoldBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="EqGoldHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="EqGoldPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="EqGoldInkBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="EqOnGoldBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="EqGoldTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="EqSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="EqWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="EqDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="EqInfoBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="EqChart1Brush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="EqChartMutedBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="EqScrimBrush" Color="#CC000000" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
