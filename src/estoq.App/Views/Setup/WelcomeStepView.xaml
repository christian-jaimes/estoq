<UserControl
    x:Class="Estoq.App.Views.Setup.WelcomeStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Estoq.App.Services">

  <StackPanel Spacing="28" HorizontalAlignment="Stretch">
    <StackPanel Spacing="8">
      <TextBlock Text="{x:Bind services:Loc.Get('Welcome_Language')}" Style="{StaticResource EqLabelStyle}" />
      <RadioButtons SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}" MaxColumns="2"
                    AutomationProperties.Name="{x:Bind services:Loc.Get('Welcome_Language')}">
        <RadioButton Content="{x:Bind services:Loc.Get('Language_English')}" />
        <RadioButton Content="{x:Bind services:Loc.Get('Language_Spanish')}" />
      </RadioButtons>
      <TextBlock Text="{x:Bind services:Loc.Get('Welcome_LanguageHelp')}" Style="{StaticResource EqSecondaryStyle}" />
    </StackPanel>

    <Border Style="{StaticResource EqCardStyle}" Padding="16">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE88E;" FontFamily="{StaticResource EqIconFont}" FontSize="24"
                  Foreground="{ThemeResource EqGoldInkBrush}" VerticalAlignment="Top" />
        <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Welcome_LocalNote')}" TextWrapping="Wrap" FontSize="14" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
