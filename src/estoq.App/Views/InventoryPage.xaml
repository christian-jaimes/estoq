<Page
    x:Class="Estoq.App.Views.InventoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Estoq.App.Controls"
    xmlns:local="using:Estoq.App.Views"
    xmlns:services="using:Estoq.App.Services"
    xmlns:vm="using:Estoq.App.ViewModels.Inventory"
    Foreground="{ThemeResource EqTextBrush}">

  <Page.Resources>
    <!-- KPI card hit area: transparent button laid over the card, gold border on hover and keyboard focus. -->
    <Style x:Key="InvKpiButtonStyle" TargetType="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EqGoldInkBrush}" />
      <Setter Property="FocusVisualPrimaryThickness" Value="2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource EqRadiusLg}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Root.BorderBrush" Value="{ThemeResource EqGoldBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Root.BorderBrush" Value="{ThemeResource EqGoldHoverBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Filter and sort buttons: secondary button, left text that trims, chevron at the end. -->
    <Style x:Key="InvFilterButtonStyle" TargetType="Button" BasedOn="{StaticResource EqSecondaryButtonStyle}">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontFamily" Value="{StaticResource EqUiFont}" />
    </Style>
  </Page.Resources>

  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16" Background="Transparent" Tapped="OnPageTapped">

    <!-- Title and actions -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="{x:Bind services:Loc.Get('Nav_Inventory')}" Style="{StaticResource EqPageTitleStyle}" />
        <TextBlock Text="{x:Bind services:Loc.Get('Inventory_Subtitle')}" Style="{StaticResource EqSecondaryStyle}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <!-- Import is hidden until a CSV import flow is specified (docs/open-questions.md, Q13). -->
        <Button Style="{StaticResource EqPrimaryButtonStyle}" Command="{x:Bind ViewModel.AddProductCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE145;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" />
            <TextBlock Text="{x:Bind services:Loc.Get('Inventory_AddProduct')}" VerticalAlignment="Center" />
            <Border BorderBrush="{ThemeResource EqOnGoldBrush}" BorderThickness="1" CornerRadius="{StaticResource EqRadiusSm}" Padding="6,1" Opacity="0.8">
              <TextBlock Text="F2" FontSize="{StaticResource EqFontXs}" />
            </Border>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- KPI cards -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
      <Grid Grid.Column="0">
        <Border Style="{StaticResource EqCardStyle}" Padding="16,14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="44" Height="44" CornerRadius="{StaticResource EqRadiusLg}" Background="{ThemeResource EqSurfaceElevatedBrush}" VerticalAlignment="Center">
              <FontIcon Glyph="&#xE1A1;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont4xl}" Foreground="{ThemeResource EqTextSecondaryBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind services:Loc.Get('Inventory_KpiProducts')}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ViewModel.TotalProductsText, Mode=OneWay}" Style="{StaticResource EqKpiStyle}" FontSize="26" />
            </StackPanel>
          </Grid>
        </Border>
        <Button Style="{StaticResource InvKpiButtonStyle}" Command="{x:Bind ViewModel.ShowAllCommand}"
                AutomationProperties.Name="{x:Bind services:Loc.Get('Inventory_KpiProducts')}"
                ToolTipService.ToolTip="{x:Bind services:Loc.Get('Inventory_KpiFilterHint')}" />
      </Grid>
      <Grid Grid.Column="1">
        <Border Style="{StaticResource EqCardStyle}" Padding="16,14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="44" Height="44" CornerRadius="{StaticResource EqRadiusLg}" Background="{ThemeResource EqSurfaceElevatedBrush}" VerticalAlignment="Center">
              <FontIcon Glyph="&#xE53B;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont4xl}" Foreground="{ThemeResource EqGoldInkBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind services:Loc.Get('Inventory_KpiVariants')}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ViewModel.TotalVariantsText, Mode=OneWay}" Style="{StaticResource EqKpiStyle}" FontSize="26" />
            </StackPanel>
          </Grid>
        </Border>
        <Button Style="{StaticResource InvKpiButtonStyle}" Command="{x:Bind ViewModel.ShowAllCommand}"
                AutomationProperties.Name="{x:Bind services:Loc.Get('Inventory_KpiVariants')}"
                ToolTipService.ToolTip="{x:Bind services:Loc.Get('Inventory_KpiFilterHint')}" />
      </Grid>
      <Grid Grid.Column="2">
        <Border Style="{StaticResource EqCardStyle}" Padding="16,14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="44" Height="44" CornerRadius="{StaticResource EqRadiusLg}" Background="{ThemeResource EqSurfaceElevatedBrush}" VerticalAlignment="Center">
              <FontIcon Glyph="&#xF720;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont4xl}" Foreground="{ThemeResource EqSuccessBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind services:Loc.Get('Inventory_KpiInStock')}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ViewModel.InStockText, Mode=OneWay}" Style="{StaticResource EqKpiStyle}" FontSize="26" />
            </StackPanel>
          </Grid>
        </Border>
        <Button Style="{StaticResource InvKpiButtonStyle}" Command="{x:Bind ViewModel.FilterInStockCommand}"
                AutomationProperties.Name="{x:Bind services:Loc.Get('Inventory_KpiInStock')}"
                ToolTipService.ToolTip="{x:Bind services:Loc.Get('Inventory_KpiFilterHint')}" />
        <Border Style="{StaticResource EqCardStyle}" Padding="0" BorderBrush="{ThemeResource EqGoldBrush}" BorderThickness="2" Background="Transparent" IsHitTestVisible="False"
                Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.IsInStockFilter), Mode=OneWay}" />
      </Grid>
      <Grid Grid.Column="3">
        <Border Style="{StaticResource EqCardStyle}" Padding="16,14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="44" Height="44" CornerRadius="{StaticResource EqRadiusLg}" Background="{ThemeResource EqSurfaceElevatedBrush}" VerticalAlignment="Center">
              <FontIcon Glyph="&#xF083;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont4xl}" Foreground="{ThemeResource EqWarningBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind services:Loc.Get('Inventory_KpiLow')}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ViewModel.LowStockText, Mode=OneWay}" Style="{StaticResource EqKpiStyle}" FontSize="26" />
            </StackPanel>
          </Grid>
        </Border>
        <Button Style="{StaticResource InvKpiButtonStyle}" Command="{x:Bind ViewModel.FilterLowCommand}"
                AutomationProperties.Name="{x:Bind services:Loc.Get('Inventory_KpiLow')}"
                ToolTipService.ToolTip="{x:Bind services:Loc.Get('Inventory_KpiFilterHint')}" />
        <Border Style="{StaticResource EqCardStyle}" Padding="0" BorderBrush="{ThemeResource EqGoldBrush}" BorderThickness="2" Background="Transparent" IsHitTestVisible="False"
                Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.IsLowFilter), Mode=OneWay}" />
      </Grid>
      <Grid Grid.Column="4">
        <Border Style="{StaticResource EqCardStyle}" Padding="16,14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="44" Height="44" CornerRadius="{StaticResource EqRadiusLg}" Background="{ThemeResource EqSurfaceElevatedBrush}" VerticalAlignment="Center">
              <FontIcon Glyph="&#xF8B6;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont4xl}" Foreground="{ThemeResource EqDangerBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind services:Loc.Get('Inventory_KpiOut')}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ViewModel.OutOfStockText, Mode=OneWay}" Style="{StaticResource EqKpiStyle}" FontSize="26" />
            </StackPanel>
          </Grid>
        </Border>
        <Button Style="{StaticResource InvKpiButtonStyle}" Command="{x:Bind ViewModel.FilterOutCommand}"
                AutomationProperties.Name="{x:Bind services:Loc.Get('Inventory_KpiOut')}"
                ToolTipService.ToolTip="{x:Bind services:Loc.Get('Inventory_KpiFilterHint')}" />
        <Border Style="{StaticResource EqCardStyle}" Padding="0" BorderBrush="{ThemeResource EqGoldBrush}" BorderThickness="2" Background="Transparent" IsHitTestVisible="False"
                Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.IsOutFilter), Mode=OneWay}" />
      </Grid>
    </Grid>

    <!-- Table column; the detail panel floats over it -->
    <Grid Grid.Row="2">

      <!-- Filters, table, pages -->
      <Grid RowDefinitions="Auto,*" RowSpacing="12" MinWidth="0">

        <!-- Toolbar: sort, filters, search, clear all -->
        <Border Grid.Row="0" Style="{StaticResource EqCardStyle}" Padding="12,10">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sort -->
            <Button Grid.Column="0" Style="{StaticResource InvFilterButtonStyle}" Width="172"
                    Click="OnSortClick" AutomationProperties.Name="{x:Bind services:Loc.Get('Inventory_SortBy')}"
                    ToolTipService.ToolTip="{x:Bind services:Loc.Get('Inventory_SortBy')}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <FontIcon Glyph="&#xE152;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SortLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <FontIcon Grid.Column="2" Glyph="&#xE313;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource EqSecondaryButtonStyle}" Width="40" MinWidth="0" Padding="0"
                    Command="{x:Bind ViewModel.ToggleSortDirectionCommand}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.SortDirectionToolTip, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.SortDirectionToolTip, Mode=OneWay}">
              <FontIcon Glyph="{x:Bind ViewModel.SortDirectionGlyph, Mode=OneWay}" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" />
            </Button>

            <Border Grid.Column="2" Width="1" Height="24" Background="{ThemeResource EqBorderBrush}" Margin="4,0" VerticalAlignment="Center" />

            <!-- Filters -->
            <Button Grid.Column="4" Style="{StaticResource InvFilterButtonStyle}" Width="176"
                    Click="OnCategoryClick" AutomationProperties.Name="{x:Bind services:Loc.Get('Inventory_FilterCategory')}"
                    ToolTipService.ToolTip="{x:Bind services:Loc.Get('Inventory_FilterCategory')}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{x:Bind ViewModel.CategoryLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <FontIcon Grid.Column="1" Glyph="&#xE313;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource InvFilterButtonStyle}" Width="176"
                    Click="OnTypeClick" AutomationProperties.Name="{x:Bind services:Loc.Get('Inventory_FilterType')}"
                    ToolTipService.ToolTip="{x:Bind services:Loc.Get('Inventory_FilterType')}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{x:Bind ViewModel.TypeLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <FontIcon Grid.Column="1" Glyph="&#xE313;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Grid.Column="5" Style="{StaticResource InvFilterButtonStyle}" Width="176"
                    Click="OnBrandClick" AutomationProperties.Name="{x:Bind services:Loc.Get('Inventory_FilterBrand')}"
                    ToolTipService.ToolTip="{x:Bind services:Loc.Get('Inventory_FilterBrand')}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{x:Bind ViewModel.BrandLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <FontIcon Grid.Column="1" Glyph="&#xE313;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFontXl}" VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Border Grid.Column="6" Width="1" Height="24" Background="{ThemeResource EqBorderBrush}" Margin="4,0" VerticalAlignment="Center" />

            <!-- Search (same text as the top bar search) -->
            <Border Grid.Column="7" MinWidth="140" Height="36" Background="{ThemeResource EqBgBrush}" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource EqRadiusMd}" Padding="12,0">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <FontIcon Glyph="&#xEF7A;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont2xl}"
                          Foreground="{ThemeResource EqTextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" VerticalAlignment="Center"
                         PlaceholderText="{x:Bind services:Loc.Get('Inventory_SearchPlaceholder')}"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0" MinHeight="0" Padding="0,6"
                         FontFamily="{StaticResource EqUiFont}" FontSize="{StaticResource EqFontMd}"
                         AutomationProperties.Name="{x:Bind services:Loc.Get('Inventory_SearchPlaceholder')}">
                  <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                  </TextBox.Resources>
                </TextBox>
              </Grid>
            </Border>

            <!-- Clear all -->
            <HyperlinkButton Grid.Column="8" Content="{x:Bind services:Loc.Get('Inventory_ClearAll')}" Style="{StaticResource EqLinkButtonStyle}" VerticalAlignment="Center"
                             Command="{x:Bind ViewModel.ClearFiltersCommand}"
                             Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.HasActiveFilters), Mode=OneWay}" />
          </Grid>
        </Border>

        <!-- Table card -->
        <Border Grid.Row="1" Style="{StaticResource EqCardStyle}" Padding="0">
          <!-- Full bleed: the header, rows and footer run edge to edge inside the card. -->
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

            <Grid Grid.Row="0" Style="{StaticResource EqTableHeaderStyle}" Padding="20,0,20,0" CornerRadius="12,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="116" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="170" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Inventory_ColStatus')}" Style="{StaticResource EqTableHeaderTextStyle}" />
              <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Inventory_ColProduct')}" Style="{StaticResource EqTableHeaderTextStyle}" />
              <TextBlock Grid.Column="2" Text="{x:Bind services:Loc.Get('Inventory_ColCategory')}" Style="{StaticResource EqTableHeaderTextStyle}" />
              <TextBlock Grid.Column="3" Text="{x:Bind services:Loc.Get('Inventory_ColBrand')}" Style="{StaticResource EqTableHeaderTextStyle}" />
              <TextBlock Grid.Column="4" Text="{x:Bind services:Loc.Get('Inventory_ColVariants')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="5" Text="{x:Bind services:Loc.Get('Inventory_ColStock')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="6" Text="{x:Bind services:Loc.Get('Inventory_ColPrice')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
            </Grid>

            <ScrollViewer x:Name="TableScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          ViewChanged="OnTableViewChanged" SizeChanged="OnTableSizeChanged">
              <Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InventoryRowViewModel">
                      <Grid MinHeight="64" Background="Transparent" Style="{StaticResource EqTableRowStyle}" Tapped="OnRowTapped"
                            PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited" DoubleTapped="OnRowDoubleTapped">
                        <Border Style="{StaticResource EqTableBandStyle}"
                                Visibility="{x:Bind local:InventoryBindings.Visible(IsAlternateRow)}" />
                        <Border x:Name="HoverFill" Background="{ThemeResource EqHoverFillBrush}" IsHitTestVisible="False" Opacity="0">
                          <Border.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.1" />
                          </Border.OpacityTransition>
                        </Border>
                        <Border Background="{ThemeResource EqGoldTintBrush}" IsHitTestVisible="False"
                                Visibility="{x:Bind local:InventoryBindings.Visible(IsSelected), Mode=OneWay}" />
                        <Grid Padding="20,8,20,8" ColumnSpacing="8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="116" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="170" />
                          </Grid.ColumnDefinitions>

                          <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <!-- First-letter placeholder until products have pictures. -->
                            <Border Width="40" Height="40" CornerRadius="{StaticResource EqRadiusMd}" Background="{ThemeResource EqGoldTintBrush}"
                                    VerticalAlignment="Center">
                              <TextBlock Text="{x:Bind Initial}" FontFamily="{StaticResource EqBrandFont}" FontSize="{StaticResource EqFontXl}"
                                         Foreground="{ThemeResource EqGoldInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                              <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="15"
                                         Foreground="{ThemeResource EqTextBrush}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{x:Bind Code}" Style="{StaticResource EqSecondaryStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Grid>
                          <TextBlock Grid.Column="2" Text="{x:Bind Category}" Style="{StaticResource EqTableCellStyle}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="3" Text="{x:Bind Brand}" Style="{StaticResource EqTableCellStyle}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="4" Text="{x:Bind VariantsText}" Style="{StaticResource EqTableCellStyle}" HorizontalAlignment="Right" />
                          <TextBlock Grid.Column="5" Text="{x:Bind StockText}" Style="{StaticResource EqTableCellStrongStyle}" HorizontalAlignment="Right" />
                          <TextBlock Grid.Column="6" Text="{x:Bind PriceText}" Style="{StaticResource EqTableCellStyle}" HorizontalAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                          <controls:StatusBadge Grid.Column="0" Kind="{x:Bind StatusKind}" Text="{x:Bind StatusText}" VerticalAlignment="Center" />
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Nothing to list -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Padding="0,40"
                            Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.IsEmpty), Mode=OneWay}">
                  <FontIcon Glyph="&#xE1A1;" FontFamily="{StaticResource EqIconFont}" FontSize="32" Foreground="{ThemeResource EqTextSecondaryBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" TextAlignment="Center" HorizontalAlignment="Center" />
                  <HyperlinkButton Content="{x:Bind services:Loc.Get('Inventory_ClearFilters')}" Style="{StaticResource EqLinkButtonStyle}" HorizontalAlignment="Center"
                                   Command="{x:Bind ViewModel.ClearFiltersCommand}"
                                   Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.HasActiveFilters), Mode=OneWay}" />
                </StackPanel>
              </Grid>
            </ScrollViewer>

            <!-- Footer: count of loaded rows, last export result, export of exactly those rows -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Style="{StaticResource EqTableFooterStyle}">
              <TextBlock Text="{x:Bind ViewModel.ShowingText, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" VerticalAlignment="Center"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ExportMessage, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" VerticalAlignment="Center"
                         HorizontalAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.HasExportMessage), Mode=OneWay}" />
              <Button Grid.Column="2" Style="{StaticResource EqSecondaryButtonStyle}" Content="{x:Bind services:Loc.Get('Inventory_Export')}"
                      Command="{x:Bind ViewModel.ExportCommand}"
                      ToolTipService.ToolTip="{x:Bind services:Loc.Get('Inventory_ExportTip')}"
                      Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.CanExport), Mode=OneWay}" />
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Detail panel: only after a row is clicked, floating over the page, full height. A click on another row updates it; a click outside closes it. -->
    <Border x:Name="DetailPanel" Grid.Row="0" Grid.RowSpan="3" Style="{StaticResource EqDetailPanelStyle}">
      <!-- Slides in from the right and back out; see SetPanel in the code-behind. -->
      <Border.RenderTransform>
        <CompositeTransform x:Name="DetailTransform" />
      </Border.RenderTransform>
      <Grid>
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">

          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Width="84" Height="84" CornerRadius="{StaticResource EqRadiusLg}" Background="{ThemeResource EqGoldTintBrush}" VerticalAlignment="Top">
              <TextBlock Text="{x:Bind ViewModel.Detail.Initial, Mode=OneWay}" FontFamily="{StaticResource EqBrandFont}" FontSize="32"
                         Foreground="{ThemeResource EqGoldInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind ViewModel.Detail.Name, Mode=OneWay}" Style="{StaticResource EqCardTitleStyle}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ViewModel.Detail.Code, Mode=OneWay}" Style="{StaticResource EqSecondaryStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
              <!-- The icon font has no pencil, so the glyph is a vector path (Material "edit"). Opens the Add product pop-up in edit mode (managers and owners). -->
              <Button Style="{StaticResource EqPlainIconButtonStyle}"
                      Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.CanEdit), Mode=OneWay}"
                      Command="{x:Bind ViewModel.EditProductCommand}"
                      AutomationProperties.Name="{x:Bind services:Loc.Get('Inventory_EditProduct')}"
                      ToolTipService.ToolTip="{x:Bind services:Loc.Get('Inventory_EditProduct')}">
                <!-- PathIcon draws its path at natural size (a 24-unit grid) and clips it, so a Viewbox scales it to 18 px. -->
                <Viewbox Width="18" Height="18">
                  <PathIcon Width="24" Height="24"
                            Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                </Viewbox>
              </Button>
              <Button Style="{StaticResource EqPlainIconButtonStyle}"
                      Command="{x:Bind ViewModel.CloseDetailCommand}"
                      AutomationProperties.Name="{x:Bind services:Loc.Get('Popup_Close')}"
                      ToolTipService.ToolTip="{x:Bind services:Loc.Get('Popup_Close')}">
                <FontIcon Glyph="&#xE5CD;" FontFamily="{StaticResource EqIconFont}" FontSize="{StaticResource EqFont4xl}" />
              </Button>
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" BorderBrush="{ThemeResource EqBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,*,*,*">
              <RadioButton Grid.Column="0" GroupName="InventoryDetailTabs" Style="{StaticResource EqTabStyle}" HorizontalAlignment="Stretch" Padding="10,9" FontSize="{StaticResource EqFontSm}"
                           Content="{x:Bind services:Loc.Get('Inventory_DetailOverview')}" IsChecked="{x:Bind ViewModel.IsOverviewTab, Mode=TwoWay}" />
              <RadioButton Grid.Column="1" GroupName="InventoryDetailTabs" Style="{StaticResource EqTabStyle}" HorizontalAlignment="Stretch" Padding="10,9" FontSize="{StaticResource EqFontSm}"
                           Content="{x:Bind services:Loc.Get('Inventory_DetailVariants')}" IsChecked="{x:Bind ViewModel.IsVariantsTab, Mode=TwoWay}" />
              <RadioButton Grid.Column="2" GroupName="InventoryDetailTabs" Style="{StaticResource EqTabStyle}" HorizontalAlignment="Stretch" Padding="10,9" FontSize="{StaticResource EqFontSm}"
                           Content="{x:Bind services:Loc.Get('Inventory_DetailStock')}" IsChecked="{x:Bind ViewModel.IsStockTab, Mode=TwoWay}" />
              <RadioButton Grid.Column="3" GroupName="InventoryDetailTabs" Style="{StaticResource EqTabStyle}" HorizontalAlignment="Stretch" Padding="10,9" FontSize="{StaticResource EqFontSm}"
                           Content="{x:Bind services:Loc.Get('Inventory_DetailHistory')}" IsChecked="{x:Bind ViewModel.IsHistoryTab, Mode=TwoWay}" />
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>

              <!-- Overview -->
              <ItemsControl ItemsSource="{x:Bind ViewModel.Detail.Overview, Mode=OneWay}"
                            Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.IsOverviewTab), Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DetailLine">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,9">
                      <Rectangle Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Fill="{ThemeResource EqBorderBrush}"
                                 Visibility="{x:Bind local:InventoryBindings.Visible(ShowDivider)}" />
                      <TextBlock Text="{x:Bind Label}" Style="{StaticResource EqSecondaryStyle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontMd}"
                                 Foreground="{ThemeResource EqTextBrush}" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="200" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Variants: a visual map of colour and size only. Stock and details are in the Stock and History tabs. -->
              <ItemsRepeater ItemsSource="{x:Bind ViewModel.Detail.Swatches, Mode=OneWay}"
                             Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.IsVariantsTab), Mode=OneWay}">
                <ItemsRepeater.Layout>
                  <UniformGridLayout MinItemWidth="52" MinItemHeight="52" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="None" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate x:DataType="vm:VariantSwatchViewModel">
                    <Grid Width="52" Height="52" ToolTipService.ToolTip="{x:Bind ToolTip}" AutomationProperties.Name="{x:Bind ToolTip}">
                      <Ellipse Fill="{x:Bind local:InventoryBindings.SwatchFill(Hex)}" Stroke="{ThemeResource EqBorderBrush}" StrokeThickness="1" />
                      <TextBlock Text="{x:Bind SizeText}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontSm}"
                                 Foreground="{x:Bind local:InventoryBindings.SwatchInk(UseDarkText)}" TextTrimming="Clip" TextWrapping="NoWrap"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="40" />
                    </Grid>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>

              <!-- Stock: each variant with its SKU, barcode, quantity and price -->
              <Grid RowDefinitions="Auto,*" RowSpacing="8"
                    Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.IsStockTab), Mode=OneWay}">
                <Grid Grid.Row="0" Style="{StaticResource EqTableHeaderStyle}" Padding="12,0,20,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="76" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Inventory_ColVariant')}" Style="{StaticResource EqTableHeaderTextStyle}" />
                  <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Inventory_ColQty')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="{x:Bind services:Loc.Get('Inventory_ColPrice')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.Detail.Variants, Mode=OneWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VariantRowViewModel">
                      <Grid MinHeight="60" Style="{StaticResource EqTableRowStyle}">
                        <Border Style="{StaticResource EqTableBandStyle}" Visibility="{x:Bind local:InventoryBindings.Visible(IsAlternateRow)}" />
                        <Grid Padding="12,8,20,8" ColumnSpacing="8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="76" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind Title}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontMd}"
                                       Foreground="{ThemeResource EqTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Sku}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Barcode}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind local:InventoryBindings.Visible(HasBarcode)}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{x:Bind QuantityText}" Style="{StaticResource EqTableCellStrongStyle}" FontSize="{StaticResource EqFontMd}" />
                          <TextBlock Grid.Column="2" Text="{x:Bind PriceText}" Style="{StaticResource EqTableCellStyle}" FontSize="{StaticResource EqFontMd}"
                                     HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>

              <!-- History: stock movements, newest first -->
              <Grid RowDefinitions="Auto,*" RowSpacing="8"
                    Visibility="{x:Bind local:InventoryBindings.Visible(ViewModel.IsHistoryTab), Mode=OneWay}">
                <Grid Grid.Row="0" Style="{StaticResource EqTableHeaderStyle}" Padding="12,0,20,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{x:Bind services:Loc.Get('Inventory_ColMovement')}" Style="{StaticResource EqTableHeaderTextStyle}" />
                  <TextBlock Grid.Column="1" Text="{x:Bind services:Loc.Get('Inventory_ColQty')}" Style="{StaticResource EqTableHeaderTextStyle}" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.Detail.History, Mode=OneWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MovementRowViewModel">
                      <Grid MinHeight="56" Style="{StaticResource EqTableRowStyle}">
                        <Border Style="{StaticResource EqTableBandStyle}" Visibility="{x:Bind local:InventoryBindings.Visible(IsAlternateRow)}" />
                        <Grid Padding="12,8,20,8" ColumnSpacing="8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind TypeText}" FontFamily="{StaticResource EqUiFontSemiBold}" FontSize="{StaticResource EqFontMd}"
                                       Foreground="{ThemeResource EqTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind WhenText}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Location}" Style="{StaticResource EqCaptionStyle}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{x:Bind QuantityText}" Style="{StaticResource EqTableCellStrongStyle}" FontSize="{StaticResource EqFontMd}" />
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>

            </Grid>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Page>
